/// A raw-socket HTTP/1.1 client for the spikes (the role of Bandit's
/// `SimpleHTTP1Client`): passive `gen_tcp`, responses read with
/// `decode_packet`, content-length and chunked bodies. Every read takes
/// and answers the leftover buffer, so pipelined responses work.
/// Spike-only.
sealed typed Object subclass: SpikeClient

  class sealed connect: port :: Integer -> Object =>
    ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#active, false}, {#nodelay, true})) unwrap

  class sealed send: sock :: Object data: data :: Binary -> Nil =>
    ((Erlang gen_tcp) send: sock with: data) unwrap
    nil

  class sealed close: sock :: Object -> Nil =>
    (Erlang gen_tcp) close: sock
    nil

  /// A GET (or any bodyless request) with extra header lines.
  class sealed get: target :: String headers: extra :: String -> Binary =>
    nl := SpikeParser crlf
    "GET {target} HTTP/1.1{nl}host: localhost{nl}{extra}{nl}"

  /// A POST with a content-length body.
  class sealed post: target :: String headers: extra :: String body: body :: Binary -> Binary =>
    nl := SpikeParser crlf
    "POST {target} HTTP/1.1{nl}host: localhost{nl}content-length: {(Erlang erlang byte_size: body)}{nl}{extra}{nl}" concat: body

  /// Read one response. Answers `{status, headers, body, rest}`, or
  /// `{0, #(), reason, ""}` if the connection closed or timed out first.
  class sealed read: sock :: Object buffer: buffer :: Binary -> Tuple =>
    (Erlang erlang
      decode_packet: #http_bin
      with: buffer
      with: #()) match: [
      {#ok, {#http_response, _v, status, _reason}, rest} -> self
        readHeaders: sock
        buffer: rest
        status: status
        headers: #();
      {#more, _} -> self
        more: sock
        buffer: buffer
        then: [:b | self read: sock buffer: b];
      _ -> {0, #(), "bad status line", ""}
    ]

  class sealed readHeaders: sock :: Object buffer: buffer :: Binary status: status :: Integer headers: headers :: List(Tuple) -> Tuple =>
    (Erlang erlang
      decode_packet: #httph_bin
      with: buffer
      with: #()) match: [
      {#ok, {#http_header, _n, field, _r, value}, rest} -> self
        readHeaders: sock
        buffer: rest
        status: status
        headers: (headers addFirst: {SpikeParser headerName: field, SpikeParser stringOrOpaque: value});
      {#ok, #http_eoh, rest} -> self
        readBody: sock
        buffer: rest
        status: status
        headers: headers reversed;
      {#more, _} -> self
        more: sock
        buffer: buffer
        then: [:b |
          self
            readHeaders: sock
            buffer: b
            status: status
            headers: headers
        ];
      _ -> {0, #(), "bad header", ""}
    ]

  class sealed readBody: sock :: Object buffer: buffer :: Binary status: status :: Integer headers: headers :: List(Tuple) -> Tuple =>
    chunked := headers anySatisfy: [:h | (h at: 1) =:= "transfer-encoding"]
    chunked
      ifTrue: [
        ^self
          readChunks: sock
          buffer: buffer
          status: status
          headers: headers
          body: ""
      ]
    length := 0
    headers do: [:h |
      (h at: 1) =:= "content-length" ifTrue: [length := (h at: 2) asInteger]
    ]
    buf := self
      fill: sock
      buffer: buffer
      to: length
    buf size < length ifTrue: [^{0, headers, "closed in body", ""}]
    {status, headers, buf part: 0 size: length, buf part: length size: buf size - length}

  class sealed readChunks: sock :: Object buffer: buffer :: Binary status: status :: Integer headers: headers :: List(Tuple) body: body :: Binary -> Tuple =>
    nl := SpikeParser crlf
    found := Erlang binary match: buffer with: nl
    found match: [
      {at, 2} -> self
        chunk: sock
        buffer: buffer
        sizeEnd: at
        status: status
        headers: headers
        body: body;
      _ -> self
        more: sock
        buffer: buffer
        then: [:b |
          self
            readChunks: sock
            buffer: b
            status: status
            headers: headers
            body: body
        ]
    ]

  class sealed chunk: sock :: Object buffer: buffer :: Binary sizeEnd: at :: Integer status: status :: Integer headers: headers :: List(Tuple) body: body :: Binary -> Tuple =>
    len := Erlang erlang binary_to_integer: (buffer part: 0 size: at) with: 16
    need := at + 2 + len + 2
    buf := self
      fill: sock
      buffer: buffer
      to: need
    buf size < need ifTrue: [^{0, headers, "closed in chunk", ""}]
    rest := buf part: need size: buf size - need
    len =:= 0 ifTrue: [^{status, headers, body, rest}]
    self
      readChunks: sock
      buffer: rest
      status: status
      headers: headers
      body: (body concat: (buf part: at + 2 size: len))

  /// Read until `buffer` holds at least `n` bytes, or the socket fails.
  class sealed fill: sock :: Object buffer: buffer :: Binary to: n :: Integer -> Binary =>
    buf := buffer
    failed := false
    [failed not and: [buf size < n]]
      whileTrue: [
        r := (Erlang gen_tcp)
          recv: sock
          with: 0
          with: 5000
        r isError ifTrue: [failed := true] ifFalse: [buf := buf concat: r value]
      ]
    buf

  class sealed more: sock :: Object buffer: buffer :: Binary then: k :: Block(Binary, Tuple) -> Tuple =>
    r := (Erlang gen_tcp)
      recv: sock
      with: 0
      with: 5000
    r isError ifTrue: [^{0, #(), "closed: {r error printString}", ""}]
    k value: (buffer concat: r value)

  /// Whether the peer has closed: a recv answers `{error, closed}`.
  class sealed isClosed: sock :: Object -> Boolean =>
    r := (Erlang gen_tcp)
      recv: sock
      with: 0
      with: 2000
    r isError and: [r error reason =:= #closed]
