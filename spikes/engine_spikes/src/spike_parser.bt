/// Spike 1: the request line and headers read with `erlang:decode_packet`
/// through the FFI, as `Bandit.HTTP1.Socket.read_headers/1`
/// (`do_read_request_line!` and `do_read_headers!`, recursive as there):
/// on `{more, _}` the socket is read (blocking) and the buffer grown.
/// Limits and error statuses are left out; Phase 1 ports them. Spike-only.
sealed typed Object subclass: SpikeParser

  /// Parse a request head from `buffer`, reading more from `sock` while
  /// it is incomplete (`sock` nil: fail instead). Answers
  /// `{request, rest}`, where `rest` is the unconsumed bytes after the
  /// head (the body, or a pipelined request), or an error reason.
  class sealed readHead: buffer :: Binary socket: sock :: Socket | Nil -> Result(Tuple, Object) =>
    (Erlang erlang
      decode_packet: #http_bin
      with: buffer
      with: #()) match: [
      {#ok, {#http_request, m, {#abs_path, p}, {1, minor}}, rest} -> self
        requestHead: m
        target: p
        minor: minor
        rest: rest
        socket: sock;
      {#more, _} -> (self more: sock) andThen: [:more |
        self readHead: (buffer concat: more) socket: sock
      ];
      _ -> Result error: #bad_request_line
    ]

  class sealed readHeaders: buffer :: Binary socket: sock :: Socket | Nil request: request :: SpikeRequest headers: headers :: List(Tuple) length: length :: Integer -> Result(Tuple, Object) =>
    // Named wildcards: two `_` in one pattern do not compile (BT-4098).
    (Erlang erlang
      decode_packet: #httph_bin
      with: buffer
      with: #()) match: [
      {#ok, {#http_header, _n, field, _r, value}, rest} -> self
        headerRead: field
        value: value
        rest: rest
        socket: sock
        request: request
        headers: headers
        length: length;
      {#ok, #http_eoh, rest} -> Result ok: {(request withHeaders: headers reversed) withContentLength: length, rest};
      {#more, _} -> (self more: sock)
        andThen: [:more |
          self
            readHeaders: (buffer concat: more)
            socket: sock
            request: request
            headers: headers
            length: length
        ];
      _ -> Result error: #bad_header
    ]

  /// One decoded request line (BT-4172: the target converts once, here).
  /// A non-UTF-8 target fails the request, as a mistyped field did.
  class sealed requestHead: m :: Object target: raw :: Object minor: minor :: Integer rest: rest :: Binary socket: sock :: Socket | Nil -> Result(Tuple, Object) =>
    text := self stringOrOpaque: raw
    (text isKindOf: String) ifFalse: [^Result error: #bad_request_line]
    self
      readHeaders: rest
      socket: sock
      request: (SpikeRequest
        method: (self methodName: m)
        target: text
        minor: minor
        headers: #()
        contentLength: 0)
      headers: #()
      length: 0

  /// One decoded header (BT-4172: the value converts once, here, so the
  /// stored headers and the content-length parse share it).
  class sealed headerRead: field :: Object value: raw :: Object rest: rest :: Binary socket: sock :: Socket | Nil request: request :: SpikeRequest headers: headers :: List(Tuple) length: length :: Integer -> Result(Tuple, Object) =>
    text := self stringOrOpaque: raw
    stored := headers addFirst: {self headerName: field, text}
    (text isKindOf: String)
      ifFalse: [
        ^self
          readHeaders: rest
          socket: sock
          request: request
          headers: stored
          length: length
      ]
    self
      readHeaders: rest
      socket: sock
      request: request
      headers: stored
      length: (self
        lengthFrom: field
        value: text
        else: length)

  /// CR LF: Beamtalk string literals have no `\r`/`\n` escapes (BT-4100).
  class sealed crlf -> String =>
    (Character value: 13) asString ++ (Character value: 10) asString

  /// Read more bytes for an incomplete head (Bandit's `read_available!`).
  class sealed more: sock :: Socket | Nil -> Result(Binary, Object) =>
    sock isNil ifTrue: [^Result error: #incomplete]
    sock recv: 0 timeout: 15000

  /// decode_packet bytes as text: valid UTF-8 answers the String,
  /// anything else passes through unchanged. The spike package cannot see
  /// the library's Headers, so the boundary conversion lives here
  /// (BT-4172): a no-op while dispatch still sniffs, and after the
  /// BT-4170 flip it keeps every downstream String use fed with Strings.
  class sealed stringOrOpaque: value :: Object -> Object =>
    (value isKindOf: String) ifTrue: [^value]
    (value isKindOf: Binary) ifFalse: [^value]
    self checkedBinary: value

  /// Valid UTF-8 as a String, invalid bytes passed through opaque.
  /// `Binary>>asString` answers a bare String on success while dispatch
  /// sniffs (a `Result ok:` after the BT-4170 flip) and a `Result error:`
  /// on failure (a raw error tuple on toolchains before BT-4169), so
  /// every shape is handled.
  class sealed checkedBinary: bin :: Binary -> Object =>
    bin asString match: [
      s :: String -> s;
      r :: Result -> r isError ifTrue: [bin] ifFalse: [r value];
      _ -> bin
    ]

  /// `decode_packet` answers well-known methods and header names as atoms,
  /// others as binaries.
  class sealed methodName: m :: Object -> String =>
    (self stringOrOpaque: m) match: [
      s :: Symbol -> s asString;
      b :: String -> b;
      _ -> ""
    ]

  class sealed headerName: field :: Object -> String =>
    (self stringOrOpaque: field) match: [
      s :: Symbol -> s asString lowercase;
      b :: String -> b lowercase;
      _ -> ""
    ]

  class sealed lengthFrom: field :: Object value: value :: String else: length :: Integer -> Integer =>
    field =:= #'Content-Length' ifTrue: [value asInteger] ifFalse: [length]
