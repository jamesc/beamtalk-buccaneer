/// Spike 4 (PLAN.md Phase 0): binary patterns (BT-663) for an HTTP/2 frame
/// header, a WebSocket header whose payload size comes from an earlier
/// segment, and HPACK prefixed integers; construction as iodata. The
/// fixture is `FrameCodec`. `testCodecCost` times each operation; the
/// Elixir equivalents are timed by `spikes/codec_baseline.exs`. Results go
/// to `_build/spikes/byte_codecs.txt`.
typed TestCase subclass: ByteCodecsSpikeTest

  bin: bytes :: List(Integer) -> Binary => Binary fromBytes: bytes

  iodata: io :: List -> Binary => Erlang erlang iolist_to_binary: io

  /// A String literal as bytes: since BT-4173 a String never equals a Binary.
  bytes: s :: String -> Binary => Erlang erlang iolist_to_binary: s

  testH2Header -> Nil =>
    // HEADERS (1), END_HEADERS (4), stream 3, 5-byte payload; the reserved
    // bit set must be ignored.
    frame := self bin: #(0, 0, 5, 1, 4, 128, 0, 0, 3, 104, 101, 108, 108, 111, 9)
    self assert: (FrameCodec h2Header: frame) equals: {5, 1, 4, 3, (self bytes: "hello") concat: (self bin: #(9))}
    self assert: (FrameCodec h2Frame: frame) equals: {1, 4, 3, self bytes: "hello", self bin: #(9)}
    self assert: (FrameCodec h2Header: (self bin: #(0, 0, 5))) equals: nil
    // Incomplete payload.
    self assert: (FrameCodec h2Frame: (self bin: #(0, 0, 5, 1, 4, 0, 0, 0, 3, 104))) equals: nil

  testH2RoundTrip -> Nil =>
    payload := Erlang binary copy: "x" with: 70000
    wire := self
      iodata: (FrameCodec
        h2Serialize: 0
        flags: 1
        stream: 2147483647
        payload: payload)
    self assert: (FrameCodec h2Frame: wire) equals: {0, 1, 2147483647, payload, self bytes: ""}

  testWebSocketFrames -> Nil =>
    // Masked "Hello" from RFC 6455 5.7.
    masked := self bin: #(129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88)
    {fin, rsv, op, key, payload, rest} := FrameCodec wsFrame: masked
    self assert: {fin, rsv, op, payload, rest} equals: {1, 0, 1, self bytes: "Hello", self bytes: ""}
    self assert: key equals: (self bin: #(55, 250, 33, 61))
    // 16-bit and 64-bit extended lengths round-trip.
    mid := Erlang binary copy: "y" with: 300
    big := Erlang binary copy: "z" with: 70000
    self assert: (FrameCodec wsFrame: (self iodata: (FrameCodec wsSerialize: 2 payload: mid))) equals: {1, 0, 2, nil, mid, self bytes: ""}
    self assert: (FrameCodec wsFrame: (self iodata: (FrameCodec wsSerialize: 2 payload: big))) equals: {1, 0, 2, nil, big, self bytes: ""}
    self assert: (FrameCodec wsFrame: (self bin: #(129, 133, 55))) equals: nil

  testHpackIntegers -> Nil =>
    // RFC 7541 C.1: 10 and 1337 with a 5-bit prefix, 42 with 8 bits.
    self
      assert: (FrameCodec
        hpackEncode: 10
        prefix: 5
        flags: 0)
      equals: #(10)
    self
      assert: (FrameCodec
        hpackEncode: 1337
        prefix: 5
        flags: 0)
      equals: #(31, 154, 10)
    self
      assert: (FrameCodec
        hpackEncode: 42
        prefix: 8
        flags: 0)
      equals: #(42)
    self assert: (FrameCodec hpackInteger: (self bin: #(234)) prefix: 5) equals: {10, self bytes: ""}
    self assert: (FrameCodec hpackInteger: (self bin: #(255, 154, 10, 7)) prefix: 5) equals: {1337, self bin: #(7)}
    self assert: (FrameCodec hpackInteger: (self bin: #(42)) prefix: 8) equals: {42, self bytes: ""}
    // Flag bits above the prefix are ignored (an indexed field, 0x80 | 2).
    self assert: (FrameCodec hpackInteger: (self bin: #(130)) prefix: 7) equals: {2, self bytes: ""}
    self assert: (FrameCodec hpackInteger: (self bin: #(255, 154)) prefix: 5) equals: nil

  micros -> Integer => Erlang erlang monotonic_time: #microsecond

  testCodecCost -> Nil =>
    n := 100000
    header := self bin: #(0, 0, 5, 1, 4, 0, 0, 0, 3, 104, 101, 108, 108, 111)
    masked := self bin: #(129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88)
    hpack := self bin: #(255, 154, 10)
    payload := "hello"
    big := Erlang binary copy: "q" with: 65536
    key := self bin: #(55, 250, 33, 61)
    // Warm up.
    1000
      timesRepeat: [
        FrameCodec h2Frame: header
        FrameCodec wsFrame: masked
      ]
    t0 := self micros
    n timesRepeat: [FrameCodec h2Header: header]
    t1 := self micros
    n timesRepeat: [FrameCodec h2Frame: header]
    t2 := self micros
    n timesRepeat: [FrameCodec wsFrame: masked]
    t3 := self micros
    n timesRepeat: [FrameCodec hpackInteger: hpack prefix: 5]
    t4 := self micros
    n
      timesRepeat: [
        FrameCodec
          h2Serialize: 1
          flags: 4
          stream: 3
          payload: payload
      ]
    t5 := self micros
    n
      timesRepeat: [
        self
          iodata: (FrameCodec
            h2Serialize: 1
            flags: 4
            stream: 3
            payload: payload)
      ]
    t6 := self micros
    n
      timesRepeat: [
        FrameCodec
          hpackEncode: 1337
          prefix: 5
          flags: 0
      ]
    t7 := self micros
    1000 timesRepeat: [FrameCodec unmask: big key: key]
    t8 := self micros
    n timesRepeat: [header]
    t9 := self micros
    report := "byte_codecs ops={n} h2_header_ns={(t1 - t0) * 1000 div: n} h2_frame_ns={(t2 - t1) * 1000 div: n} ws_masked_frame_ns={(t3 - t2) * 1000 div: n} hpack_int_decode_ns={(t4 - t3) * 1000 div: n} h2_serialize_iodata_ns={(t5 - t4) * 1000 div: n} h2_serialize_binary_ns={(t6 - t5) * 1000 div: n} hpack_int_encode_ns={(t7 - t6) * 1000 div: n} ws_unmask_64KiB_us={(t8 - t7) div: 1000} empty_loop_ns={(t9 - t8) * 1000 div: n}"
    File mkdirAll: "_build/spikes"
    File writeAll: "_build/spikes/byte_codecs.txt" contents: report
    self assert: (t2 - t1) < (n * 1000)
