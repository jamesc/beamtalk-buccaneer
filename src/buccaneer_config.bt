/// Option dictionaries: Symbol keys, values checked at each use site.
type ConfigOptions = Dictionary(Symbol, Object)

/// The `#http` section: Bandit's top-level HTTP options (logging and
/// compression), in camelCase.
///
/// ## Options
/// - `#logProtocolErrors` (`#short` | `#verbose` | `False`, default `#short`) — how much to log on a protocol error.
/// - `#logClientClosures` (`#short` | `#verbose` | `False`, default `false`) — how much to log when the client went away first.
/// - `#logExceptionsWithStatusCodes` (Integer, List, or anything answering `includes:`, default `500-599`) — which statuses log on an internal error.
/// - `#compress` (reserved) — accepted for Bandit parity, currently unused.
/// - `#responseEncodings` (reserved) — accepted for Bandit parity, currently unused.
/// - `#deflateOptions` (reserved) — accepted for Bandit parity, currently unused.
/// - `#zstdOptions` (reserved) — accepted for Bandit parity, currently unused.
type HttpOptions = Dictionary(Symbol, Object)

/// The `#http1` section: Bandit's HTTP/1 options, in camelCase.
///
/// ## Options
/// - `#enabled` (Boolean, default `true`) — whether plain HTTP/1 connections are served.
/// - `#maxRequests` (Integer, default `0`) — requests per keepalive connection before closing; `0` means unlimited.
/// - `#maxRequestLineLength` (Integer, default `10000`) — longest request line in bytes.
/// - `#maxHeaderLength` (Integer, default `10000`) — longest header line in bytes.
/// - `#maxHeaderCount` (Integer, default `50`) — most headers per request.
/// - `#gcEveryNKeepaliveRequests` (Integer, default `5`) — garbage-collect every Nth keepalive request; non-Integers skip collection.
/// - `#logUnknownMessages` (Boolean, default `false`) — log messages the connection does not understand.
/// - `#clearProcessDict` (reserved) — accepted for Bandit parity; the process dictionary is always cleared between keepalive requests.
type Http1Options = Dictionary(Symbol, Object)

/// The `#http2` section: Bandit's HTTP/2 options, in camelCase.
/// Accepted, validated and stored; the HTTP/2 engine reads them.
///
/// ## Options
/// - `#enabled` (Boolean, default `true`) — `false` refuses h2 with a
///   connection error instead of serving it.
/// - `#maxHeaderBlockSize` (Integer, default `50000`) — largest
///   reassembled header block in bytes.
/// - `#maxRequests` (Integer, default `0`) — most streams per connection;
///   `0` means unlimited.
/// - `#maxResetStreamRate` (`{intensity, period}`, default `{500, 10000}`;
///   `nil` disables) — most resets per period before the connection closes.
/// - `#sendfileChunkSize` (Integer, default `1048576`) — file bytes per
///   DATA run when serving files.
/// - `#defaultLocalSettings` (Dictionary, default empty) — overrides for
///   the advertised settings (`#headerTableSize`, `#maxConcurrentStreams`,
///   `#initialWindowSize`, `#maxFrameSize`, `#maxHeaderListSize`).
/// - `#logStreamErrors` (`#short` default, `#verbose` or `false`) — how
///   stream errors are logged.
type Http2Options = Dictionary(Symbol, Object)

/// The `#websocket` section: Bandit's WebSocket options, in camelCase.
///
/// ## Options
/// - `#maxFrameSize` (Integer, default `8000000`) — largest accepted frame in bytes.
/// - `#maxFragmentedMessageSize` (Integer, default `8000000`) — largest reassembled message in bytes.
/// - `#validateTextFrames` (Boolean, default `true`) — reject non-UTF-8 text frames.
/// - `#compress` (Boolean, default `false`) — offer permessage-deflate; the upgrade must opt in too.
/// - `#maxInflateRatio` (Integer, default `25`) — largest allowed inflation ratio for compressed messages.
/// - `#enabled` (reserved) — accepted for Bandit parity, currently unused.
/// - `#deflateOptions` (reserved) — accepted for Bandit parity; per-upgrade options carry these instead.
/// - `#primitiveOpsModule` (reserved) — accepted for Bandit parity, currently unused.
/// - `#logProtocolErrors` (reserved) — accepted for Bandit parity; `#http` logging covers WebSocket errors.
type WebSocketOptions = Dictionary(Symbol, Object)

/// The `#catalina` section: Catalina `ServerConfig` options plus the
/// transport conveniences folded in (`#port`, `#transport`). See
/// `ServerConfig` for one bullet per key; unknown keys raise here, as
/// `fromOptions:` raises there.
type CatalinaOptions = Dictionary(Symbol, Object)

/// URL schemes served.
type Scheme = #http | #https

/// Bandit's start_link/1 options: validation, defaults and normalization.
///
/// Top-level conveniences (#port, #ip, #inet/#inet6, the TLS file options)
/// fold into the #catalina section as Bandit folds them into Thousand
/// Island's options; the #http/#http1/#http2/#websocket sections keep
/// Bandit's keys in camelCase. Unknown keys raise, as a typo the user
/// should hear about.
typed Value subclass: BuccaneerConfig
  field: handler :: ExchangeHandlerLike | Nil = nil
  field: scheme :: Scheme = #http
  field: port :: Integer = 4000
  field: displayHandler :: Object = nil
  field: startupLog :: LogLevel | False = #info
  field: http :: HttpOptions = Dictionary new
  field: http1 :: Http1Options = Dictionary new
  field: http2 :: Http2Options = Dictionary new
  field: websocket :: WebSocketOptions = Dictionary new
  field: catalina :: CatalinaOptions = Dictionary new

  /// Build a validated config from an options dictionary. Unknown keys
  /// raise, as a typo the user should hear about.
  ///
  /// ## Arguments
  /// - `options` (ConfigOptions) — top-level options plus one Dictionary
  ///   per section (`#http`, `#http1`, `#http2`, `#websocket`,
  ///   `#catalina`).
  ///
  /// ## Options
  /// - `#handler` (Block or value answering `call:`, required) — answers one request; see `ExchangeHandler`.
  /// - `#scheme` (`#http` | `#https`, default `#http`) — the URL scheme served.
  /// - `#port` (Integer or numeric String, default `4000`, `4040` for `#https`) — the port to listen on.
  /// - `#ip` (address term) — folded into `#transportOptions` as `{#ip, address}`.
  /// - `#inet` (Boolean, default `false`) — folded into `#transportOptions` as a bare atom when true.
  /// - `#inet6` (Boolean, default `false`) — folded into `#transportOptions` as a bare atom when true.
  /// - `#keyfile` (String, `#https` only) — folded into `#transportOptions`.
  /// - `#certfile` (String, `#https` only) — folded into `#transportOptions`.
  /// - `#otpApp` (`#https` only) — folded into `#transportOptions`.
  /// - `#cipherSuite` (`#https` only) — folded into `#transportOptions`.
  /// - `#displayHandler` (Object, default `#handler`) — the handler named in the startup log.
  /// - `#startupLog` (LogLevel | `False`, default `#info`) — the startup line level; `false` stays silent.
  /// - `#http` (Dictionary, default empty) — see `HttpOptions` for one bullet per key.
  /// - `#http1` (Dictionary, default empty) — see `Http1Options` for one bullet per key.
  /// - `#http2` (Dictionary, default empty) — see `Http2Options` for one bullet per key.
  /// - `#websocket` (Dictionary, default empty) — see `WebSocketOptions` for one bullet per key.
  /// - `#catalina` (Dictionary, default empty) — see `CatalinaOptions` and `ServerConfig` for one bullet per key.
  ///
  /// ## Examples
  /// ```beamtalk
  /// config := BuccaneerConfig from: #{
  ///   #handler => [:ex | nil],
  ///   #port => 4001,
  ///   #http1 => #{#maxRequests => 100}
  /// }
  /// config port                    // => 4001
  /// config http1 at: #maxRequests  // => 100
  /// ```
  class from: options :: ConfigOptions -> BuccaneerConfig =>
    self
      validateKeys: options
      known: self topLevelKeys
      name: "top level"
    handler := self checkHandler: options
    scheme := self checkScheme: options
    port := self parsePort: (options at: #port ifAbsent: [nil]) scheme: scheme
    http := self
      section: options
      name: #http
      keys: self httpKeys
    self checkHttpLoggingOptions: http
    http1 := self
      section: options
      name: #http1
      keys: self http1Keys
    http2 := self
      section: options
      name: #http2
      keys: self http2Keys
    websocket := self
      section: options
      name: #websocket
      keys: self websocketKeys
    catalina := self
      catalinaSection: options
      port: port
      scheme: scheme
    display := options at: #displayHandler ifAbsent: [handler]
    startup := options at: #startupLog ifAbsent: [#info]
    BuccaneerConfig
      handler: handler
      scheme: scheme
      port: port
      displayHandler: display
      startupLog: startup
      http: http
      http1: http1
      http2: http2
      websocket: websocket
      catalina: catalina

  class topLevelKeys -> List(Symbol) =>
    #(#handler, #scheme, #port, #ip, #inet, #inet6, #keyfile, #certfile, #otpApp, #cipherSuite, #displayHandler, #startupLog, #catalina, #http, #http1, #http2, #websocket)

  class httpKeys -> List(Symbol) =>
    #(#compress, #responseEncodings, #deflateOptions, #zstdOptions, #logExceptionsWithStatusCodes, #logProtocolErrors, #logClientClosures)

  class http1Keys -> List(Symbol) =>
    #(#enabled, #maxRequestLineLength, #maxHeaderLength, #maxHeaderCount, #maxRequests, #clearProcessDict, #gcEveryNKeepaliveRequests, #logUnknownMessages)

  class http2Keys -> List(Symbol) =>
    #(#enabled, #maxHeaderBlockSize, #maxRequests, #maxResetStreamRate, #sendfileChunkSize, #defaultLocalSettings, #logStreamErrors)

  class websocketKeys -> List(Symbol) =>
    #(#enabled, #maxFrameSize, #maxFragmentedMessageSize, #validateTextFrames, #compress, #deflateOptions, #maxInflateRatio, #primitiveOpsModule, #logProtocolErrors)

  class validateKeys: options :: ConfigOptions known: known :: List(Symbol) name: section :: String -> Nil =>
    illegal := options keys reject: [:key | known includes: key]
    illegal isEmpty
      ifFalse: [
        Error signal: ("Unsupported key(s) in " ++ section ++ " config: " ++ illegal printString)
      ]
    nil

  class checkHandler: opts :: ConfigOptions -> Object =>
    handler := opts at: #handler ifAbsent: [nil]
    handler isNil ifTrue: [Error signal: "A value is required for #handler"]
    (handler isKindOf: Actor) ifTrue: [
      Error signal: "Invalid value for #handler: must not be an Actor"
    ]
    ((handler isKindOf: Block) or: [
      handler respondsTo: #call:
    ]) ifFalse: [Error signal: "Invalid value for #handler"]
    handler

  /// Fail fast on logging verbosity typos: these are read on error
  /// paths, where a raise would mask the error being reported.
  class checkHttpLoggingOptions: http :: HttpOptions -> Nil =>
    self checkVerbosity: (http at: #logProtocolErrors ifAbsent: [
      nil
    ]) name: "#logProtocolErrors"
    self checkVerbosity: (http at: #logClientClosures ifAbsent: [
      nil
    ]) name: "#logClientClosures"
    self checkStatusCodes: (http at: #logExceptionsWithStatusCodes ifAbsent: [
      nil
    ])

  class checkVerbosity: raw :: Object name: name :: String -> Nil =>
    raw isNil ifTrue: [^nil]
    raw match: [
      #short -> nil;
      #verbose -> nil;
      _f :: False -> nil;
      _ -> Error signal: "Invalid value for " ++ name
    ]

  class checkStatusCodes: raw :: Object -> Nil =>
    raw isNil ifTrue: [^nil]
    (raw isKindOf: Integer) ifTrue: [^nil]
    (raw isKindOf: List) ifTrue: [^nil]
    (raw respondsTo: #includes:) ifTrue: [^nil]
    Error signal: "Invalid value for #logExceptionsWithStatusCodes"

  class checkScheme: opts :: ConfigOptions -> Scheme =>
    raw := opts at: #scheme ifAbsent: [#http]
    raw match: [
      #http -> #http;
      #https -> #https;
      _ -> Error signal: "Invalid value for #scheme"
    ]

  class parsePort: value :: Object scheme: scheme :: Scheme -> Integer =>
    value isNil ifTrue: [scheme =:= #https ifTrue: [^4040] ifFalse: [^4000]]
    (value isKindOf: Integer) ifTrue: [^value]
    (value isKindOf: String) ifFalse: [Error signal: "Invalid value for #port"]
    parsed := Headers parseInteger: value
    parsed isError ifTrue: [Error signal: "Invalid value for #port"]
    parts := parsed unwrap
    rest := parts at: 2
    rest isEmpty ifFalse: [Error signal: "Invalid value for #port"]
    n := parts at: 1
    n

  class section: opts :: ConfigOptions name: key :: Symbol keys: known :: List(Symbol) -> ConfigOptions =>
    raw := opts at: key ifAbsent: [^Dictionary new]
    (raw isKindOf: Dictionary) ifFalse: [
      Error signal: ("Invalid config for section: " ++ key asString)
    ]
    dict := raw
    self
      validateKeys: dict
      known: known
      name: key asString
    dict

  class catalinaSection: opts :: ConfigOptions port: port :: Integer scheme: scheme :: Scheme -> CatalinaOptions =>
    base := self
      section: opts
      name: #catalina
      keys: ServerConfig optionNames
    withTransport := base
    (base includesKey: #transport)
      ifFalse: [
        scheme =:= #https ifTrue: [
          withTransport := base at: #transport put: SSLTransport
        ]
      ]
    withPort := withTransport
    (withTransport includesKey: #port) ifFalse: [
      withPort := withTransport at: #port put: port
    ]
    extra := self convenienceTransportOptions: opts scheme: scheme
    extra isEmpty ifTrue: [^withPort]
    trans := withPort at: #transportOptions ifAbsent: [nil]
    trans isNil
      ifTrue: [
        dict := Dictionary new
        extra do: [:opt | dict := self addRawOption: opt to: dict]
        ^withPort at: #transportOptions put: dict
      ]
    (trans isKindOf: Dictionary)
      ifTrue: [
        dict := trans
        extra do: [:opt | dict := self addRawOption: opt to: dict]
        ^withPort at: #transportOptions put: dict
      ]
    (trans isKindOf: List) ifFalse: [
      Error signal: "Invalid #transportOptions in #catalina config"
    ]
    list := trans
    extra do: [:opt | list := list add: opt]
    withPort at: #transportOptions put: list

  /// Raw options from the top-level conveniences: {#key, value} pairs and
  /// bare atoms, as Catalina's transportOptions takes them.
  class convenienceTransportOptions: opts :: ConfigOptions scheme: scheme :: Scheme -> List(Object) =>
    out := #()
    (opts at: #ip ifAbsent: [
      nil
    ]) ifNotNil: [:addr | out := out add: {#ip, addr}]
    out := self
      addFlag: #inet
      from: opts
      to: out
    out := self
      addFlag: #inet6
      from: opts
      to: out
    scheme =:= #https
      ifTrue: [
        #(#keyfile, #certfile, #otpApp, #cipherSuite)
          do: [:key |
            (opts at: key ifAbsent: [
              nil
            ]) ifNotNil: [:v | out := out add: {key, v}]
          ]
      ]
    out

  class addFlag: name :: Symbol from: opts :: ConfigOptions to: out :: List(Object) -> List(Object) =>
    raw := opts at: name ifAbsent: [false]
    raw =:= true ifTrue: [^out add: name]
    raw =:= false ifTrue: [^out]
    Error signal: ("Invalid value for #" ++ name asString)

  class addRawOption: opt :: Object to: dict :: ConfigOptions -> ConfigOptions =>
    (opt isKindOf: Symbol) ifTrue: [^dict at: opt put: true]
    (opt isKindOf: Tuple)
      ifTrue: [
        k := opt at: 1
        v := opt at: 2
        ^dict at: k put: v
      ]
    Error signal: "Invalid transport option"

  /// An Integer #http2 option or the default.
  http2Integer: key :: Symbol default: fallback :: Integer -> Integer =>
    raw := self http2 at: key ifAbsent: [^fallback]
    raw match: [
      n :: Integer -> n;
      _ -> Error signal: ("Invalid value for #" ++ key asString)
    ]

  /// The reset intensity from #maxResetStreamRate ({intensity, period}
  /// or nil to disable; default {500, 10000}).
  http2ResetIntensity -> Integer =>
    raw := self http2 at: #maxResetStreamRate ifAbsent: [^500]
    raw isNil ifTrue: [^0]
    raw match: [
      {i, _} -> i match: [
        n :: Integer -> n;
        _ -> Error signal: "Invalid value for #maxResetStreamRate"
      ];
      _ -> Error signal: "Invalid value for #maxResetStreamRate"
    ]

  /// The reset period from #maxResetStreamRate.
  http2ResetPeriod -> Integer =>
    raw := self http2 at: #maxResetStreamRate ifAbsent: [^10000]
    raw isNil ifTrue: [^10000]
    raw match: [
      {_, p} -> p match: [
        n :: Integer -> n;
        _ -> Error signal: "Invalid value for #maxResetStreamRate"
      ];
      _ -> Error signal: "Invalid value for #maxResetStreamRate"
    ]

  /// How stream errors are logged: #short (default), #verbose or false.
  http2LogStreamErrors -> Object =>
    raw := self http2 at: #logStreamErrors ifAbsent: [^#short]
    (raw =:= #short or: [
      raw =:= #verbose or: [raw =:= false]
    ]) ifFalse: [Error signal: "Invalid value for #logStreamErrors"]
    raw
