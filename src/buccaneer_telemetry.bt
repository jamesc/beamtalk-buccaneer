/// Bandit.Telemetry: the `[buccaneer, request, *]` span over the stdlib
/// `Telemetry` facade, so any `telemetry` handler sees it.
///
/// A request span opens when the pipeline has read the head (or fails
/// to) and ends at the response, or at the request's exception event
/// (which, as in Bandit, is not followed by a stop).
///
/// | Event | Measurements | Metadata |
/// |---|---|---|
/// | `start` | `#monotonic_time` | `#telemetry_span_context`, `#connection_telemetry_span_context`, `#plug`, `#conn` (absent when the head never parsed) |
/// | `stop` | `start` plus `#duration`, `#req_body_bytes`, `#resp_body_bytes` and the `*_time` stamps the request reached | `start` plus `#error` when the request failed |
/// | `exception` | `#monotonic_time` | `start` plus `#kind`, `#exception`, `#stacktrace` |
///
/// `#plug` is the server's display handler; `#conn` is the ExchangeState
/// (Bandit's `Plug.Conn`), initial on `start`, final on `stop`. Times
/// are native monotonic, bytes are octets. A separate class rather than
/// a reuse of `CatalinaTelemetry`: that one hardcodes `[catalina, ...]`
/// events and handler-keyed metadata, and it is sealed.
sealed typed Value subclass: BuccaneerTelemetry
  field: spanName :: Symbol = #request
  field: telemetrySpanContext :: Reference | Nil = nil
  field: startTime :: Integer = 0
  field: startMetadata :: Dictionary(Symbol, Object) = #{}
  /// False for a span nobody listens to (see `requestsTraced`): its
  /// events are skipped, and so is the work of building them.
  field: enabled :: Boolean = true

  /// The process-dictionary key of the connection's `requestsTraced` flag.
  class sealed tracedKey -> Symbol => #buccaneerRequestsTraced

  /// Record, once at connection start, whether any `telemetry` handler
  /// listens to `[buccaneer, request, *]`. Handlers attached later reach
  /// the connections opened after them.
  class sealed noteRequestsTraced -> Nil =>
    ProcessDictionary at: self tracedKey put: self requestHandlersAttached
    nil

  /// Whether `[buccaneer, request, *]` has a handler: false when the
  /// `telemetry` module is not loaded (the stdlib facade then drops every
  /// event), true when the lookup fails, so a doubt keeps the spans. The
  /// call goes through `apply`: `telemetry` ships with the runtime but is
  /// not a package dependency, and the stdlib `Telemetry` facade has no
  /// handler query.
  class sealed requestHandlersAttached -> Boolean =>
    (Erlang erlang
      function_exported: #telemetry
      with: #list_handlers
      with: 1) ifFalse: [^false]
    [
      handlers :: List(Object) := Erlang erlang
        apply: #telemetry
        with: #list_handlers
        with: #(#(#buccaneer, #request))
      handlers isEmpty not
    ] on: Error do: [:e | true]

  /// Whether this process's requests emit spans: the connection's flag,
  /// true when none was recorded (HTTP/2 streams, tests).
  class sealed requestsTraced -> Boolean =>
    (ProcessDictionary at: self tracedKey) =:= false ifTrue: [
      false
    ] ifFalse: [true]

  /// A span that emits nothing.
  class sealed silent -> BuccaneerTelemetry =>
    BuccaneerTelemetry new withEnabled: false

  /// Native monotonic time, as `telemetry` expects.
  class sealed monotonicTime -> Integer => Erlang erlang monotonic_time

  /// Emit `[buccaneer, span, name]`.
  class sealed emit: span :: Symbol name: name :: Symbol measurements: measurements :: Dictionary(Symbol, Object) metadata: metadata :: Dictionary(Symbol, Object) -> Nil =>
    Telemetry
      execute: ((#(#buccaneer) add: span) add: name)
      measurements: measurements
      metadata: metadata

  /// Start a span: emit its `start` event and answer it. `measurements`
  /// may supply `#monotonic_time`; otherwise it is now.
  class sealed startSpan: name :: Symbol measurements: measurements :: Dictionary(Symbol, Object) metadata: metadata :: Dictionary(Symbol, Object) -> BuccaneerTelemetry =>
    timed := (measurements includesKey: #monotonic_time) ifTrue: [
      measurements
    ] ifFalse: [measurements at: #monotonic_time put: self monotonicTime]
    // Not `Reference new`: that is a call into the Reference class
    // process on every request (BT-4464).
    context := Erlang erlang make_ref
    start := metadata at: #telemetry_span_context put: context
    self
      emit: name
      name: #start
      measurements: timed
      metadata: start
    startTime :: Integer := timed at: #monotonic_time
    BuccaneerTelemetry
      spanName: name
      telemetrySpanContext: context
      startTime: startTime
      startMetadata: start
      enabled: true

  /// Emit `stop` with `#duration`, merging the start metadata under the
  /// given one. Answers the span, as every event method does. Unlike
  /// Catalina's spans there is no exception marker to honour: the
  /// pipeline emits either `stop` or `exception`, never both.
  stopWith: measurements :: Dictionary(Symbol, Object) metadata: metadata :: Dictionary(Symbol, Object) -> BuccaneerTelemetry =>
    self.enabled ifFalse: [^self]
    now :: Integer := (measurements at: #monotonic_time ifAbsent: [
      nil
    ]) ifNil: [BuccaneerTelemetry monotonicTime]
    timed := (measurements at: #monotonic_time put: now) at: #duration put: now - self startTime
    self
      untimedEvent: #stop
      measurements: timed
      metadata: (self.startMetadata merge: metadata)

  /// Emit `exception` with `#kind`, `#exception` and `#stacktrace`. As
  /// in Bandit (`Bandit.Telemetry.span_exception`, kept for pre-1.5.7
  /// compatibility), an `#error` kind is reported as `#exit`.
  exceptionKind: kind :: Symbol reason: reason :: Object stacktrace: stacktrace :: Object -> BuccaneerTelemetry =>
    self.enabled ifFalse: [^self]
    mapped := kind =:= #error ifTrue: [#exit] ifFalse: [kind]
    metadata := self.startMetadata merge: #{
      #kind => mapped,
      #exception => reason,
      #stacktrace => stacktrace
    }
    self
      untimedEvent: #exception
      measurements: #{#monotonic_time => BuccaneerTelemetry monotonicTime}
      metadata: metadata

  /// An event stamped with the span's context.
  untimedEvent: name :: Symbol measurements: measurements :: Dictionary(Symbol, Object) metadata: metadata :: Dictionary(Symbol, Object) -> BuccaneerTelemetry =>
    BuccaneerTelemetry
      emit: self.spanName
      name: name
      measurements: measurements
      metadata: (metadata at: #telemetry_span_context put: self.telemetrySpanContext)
    self
