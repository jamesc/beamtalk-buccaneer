/// Bandit.Clock: the pre-formatted RFC9110 date header, cached in ETS.
///
/// Formatting the date costs more than a cache read, so request processes
/// read the cached value while a per-second updater (started with the
/// server) refreshes it. On a cache miss the date is computed fresh and a
/// warning is logged, as Bandit.
typed Object subclass: Clock

  class tableName -> Symbol => #BuccaneerClock

  class cacheKey -> Symbol => #dateHeader

  /// {"date", <rfc9110 date>} from the cache, or freshly computed on a miss.
  class dateHeader -> Tuple =>
    cached := self cachedDate
    cached isNil
      ifTrue: [
        Logger warn: "Header timestamp couldn't be fetched from ETS cache"
        ^{"date", self computeDateHeader}
      ]
    {"date", cached}

  /// The cached date, or nil when the table or key is missing.
  class cachedDate -> String | Nil =>
    (Ets exists: self tableName) ifFalse: [^nil]
    date := (Ets named: self tableName) at: self cacheKey
    date

  /// Recompute the date, store it, and answer it.
  class updateCache -> String =>
    date := self computeDateHeader
    (Ets newOrExisting: self tableName type: #set) at: self cacheKey put: date
    date

  /// Format the current UTC time per RFC9110§5.6.7.
  class computeDateHeader -> String =>
    now := DateTime now
    dayName := self dayNames at: (self weekdayOf: now)
    monthName := self monthNames at: now month
    day := now format: "dd"
    year := now format: "yyyy"
    clock := now format: "HH:mm:ss"
    "{dayName}, {day} {monthName} {year} {clock} GMT"

  /// Monday = 1 through Sunday = 7, as calendar:day_of_the_week/1.
  class weekdayOf: dt :: DateTime -> Integer =>
    (Erlang calendar) day_of_the_week: {dt year, dt month, dt day}

  class dayNames -> List(String) =>
    #("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")

  class monthNames -> List(String) =>
    #("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
