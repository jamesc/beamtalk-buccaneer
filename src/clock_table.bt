/// Owner of the clock's ETS table (BT-4994).
///
/// One registered actor owns the table, so it lives as long as the node
/// instead of as long as whichever request (or test) process created it,
/// and its mailbox serialises creation: however many processes ask at the
/// same moment, the table is created once. The old creation,
/// `Ets newOrExisting:`, is `ets:new` and then, when that fails, a lookup;
/// if the table's owner exited or the table was deleted between the two it
/// raised `already_exists`.
///
/// `spawnAs:` registers the name atomically, and the loser of a race never
/// runs, so there is one owner. Messages sent to it queue until it is up.
Actor subclass: ClockTable
  state: created :: Integer = 0

  class registeredName -> Symbol => #buccaneer_clock_table

  /// The owner: started by the first caller, found by the rest.
  class owner -> ClockTable =>
    (self spawnAs: self registeredName) ifOk: [:a |
      a
    ] ifError: [:e | (self named: self registeredName) unwrap]

  /// Make sure the clock's table exists. True when this call created it.
  class ensure -> Boolean => self ensureNamed: Clock tableName

  /// Make sure the table `name` exists. True when this call created it.
  class ensureNamed: name :: Symbol -> Boolean => self owner ensureTable: name

  /// How many times this node has created the table.
  class creations -> Integer => self owner creations

  /// Create the table `name` unless it exists. True when this call created it
  /// (the caller then starts the updater), false when it was there.
  ensureTable: name :: Symbol -> Boolean =>
    (Ets exists: name) ifTrue: [^false]
    Ets new: name type: #set
    self.created := self.created + 1
    true

  /// How many times this actor has created the table.
  creations -> Integer => self.created
