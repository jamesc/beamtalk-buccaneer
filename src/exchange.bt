/// Bandit.Adapter as an owner-bound handle (docs/engine-interface.md § 1):
/// a sealed Value holding only an identity and the owning process. The
/// request's state is an ExchangeState in the owner's process dictionary
/// under {#buccaneer_exchange, ref}; every method checks the caller is
/// the owner first. Phase 1 covers the request, readBody, readAll: and
/// sendResp:; chunked responses, inform:, sendFile: and the 100-continue
/// come in Phase 3, upgrade in Phase 4.
type WebSocketUpgradeOptions = Dictionary(Symbol, Object)

sealed typed Value subclass: Exchange
  // Always set by open:; nilable only because a Value field needs a default.
  field: ref :: Reference | Nil = nil
  field: owner :: Pid | Nil = nil

  /// Engine side: start a request's state in the calling process.
  /// The put goes through store:, an instance method: a direct
  /// erlang:put/2 here trips ClassMethodProcessResource1, since a class
  /// method with no classState: runs in the caller's process (which is
  /// exactly where this state belongs).
  class sealed open: state :: ExchangeState -> Exchange =>
    // `Reference new` is a gen_server call into the Reference class
    // process (`new` is a process-bound selector): node-wide
    // serialisation on every request. make_ref directly instead.
    ex := Exchange ref: Erlang erlang make_ref owner: Pid current
    ex store: (state withReqHeaderEndTime: BuccaneerTelemetry monotonicTime)

  /// The process-dictionary key of this exchange's state.
  key -> Tuple(Symbol, Reference | Nil) => {#buccaneer_exchange, self.ref}

  /// The state, after the owner check. Raises NotOwner from another
  /// process, and an error once the exchange is finished.
  load -> ExchangeState =>
    me := Pid current
    me =:= self.owner
      ifFalse: [
        NotOwner signal: "not_owner: an Exchange can only be used from the process that received the request (owner {self.owner printString}, caller {me printString})"
      ]
    (ProcessDictionary at: self key) match: [
      st :: ExchangeState -> st;
      _ -> Error signal: "exchange_finished: this request is complete"
    ]

  store: st :: ExchangeState -> Exchange =>
    ProcessDictionary at: self key put: st
    self

  // === The request (fixed once the headers are read) ===
  method -> String => self load method

  scheme -> Scheme => self load scheme

  host -> String => self load host

  port -> Integer => self load port

  path -> String => self load path

  query -> String | Nil => self load query

  /// {name, value}, names lowercase, order and duplicates kept.
  headers -> HttpHeaders => self load headers

  /// The first value for name, or nil.
  header: name :: String -> Binary | Nil =>
    Headers getHeader: self load headers name: name

  httpProtocol -> HttpVersion => self load transport version

  /// {address, port} of the client, or nil when Catalina was given none.
  peer -> SocketAddress | Nil =>
    sock := self load transport socket
    sock isNil ifTrue: [^nil]
    peer := sock peername
    peer isError ifTrue: [^nil]
    peer value

  /// {address, port} of this end.
  sockData -> SocketAddress => self socket sockname unwrap

  /// The peer certificate, or error: #not_secure on a clear connection.
  sslData -> Result(Object, Object) =>
    sock := self socket
    sock isSecure ifFalse: [^Result error: #not_secure]
    sock peercert

  socket -> Socket =>
    sock := self load transport socket
    sock isNil ifTrue: [Error signal: "Exchange has no socket"]
    sock

  /// #unset | #sent | #chunked | #upgraded, as Plug.Conn's state.
  state -> ExchangeRespState => self load respState

  // === The request body ===

  /// The next part of the body with Plug's read_body/2 defaults.
  readBody -> Result(BodyPart, Object) => self readBody: #{}

  /// The next part of the body: up to #length bytes (default 8_000_000),
  /// #readLength per socket read (1_000_000), waiting #readTimeout ms
  /// per read (15_000). A timeout answers error: #timeout and a socket
  /// failure error: #closed; a malformed body raises HTTPError (a 400).
  /// Send `100 Continue` first if the client asked and nothing was sent
  /// (Bandit's maybe_send_continue): only before the first body read.
  maybeSendContinueOn: st :: ExchangeState -> ExchangeState =>
    st expectContinue ifFalse: [^st]
    st status notNil ifTrue: [^st withExpectContinue: false]
    dated := #(Clock dateHeader)
    [
      transport := st transport
        sendHeaders: 100
        headers: dated
        disposition: #inform
      ^((st withTransport: transport) withStatus: 100) withExpectContinue: false
    ] on: TransportError do: [:e | ^st withExpectContinue: false]

  readBody: options :: Dictionary(Symbol, Object) -> Result(BodyPart, Object) =>
    st := self maybeSendContinueOn: self load
    self store: st
    read := [
      [
        st transport readData: options
      ] on: HTTPError do: [:e |
        e reason =:= 408 ifTrue: [^Result error: #timeout] ifFalse: [e pass]
      ]
    ] on: TransportError do: [:e | ^Result error: #closed]
    {tag, data, transport} := read
    started := st reqBodyStartTime ifNil: [BuccaneerTelemetry monotonicTime]
    stamped := tag =:= #ok
      ifTrue: [
        (st withReqBodyStartTime: started) withReqBodyEndTime: BuccaneerTelemetry monotonicTime
      ]
      ifFalse: [st withReqBodyStartTime: started]
    self store: ((stamped withTransport: transport) withReqBodyBytes: st reqBodyBytes + data size)
    Result ok: (BodyPart data: data done: tag =:= #ok)

  /// The rest of the body in one read, or error: #body_too_large when it
  /// is longer than maxBytes.
  readAll: maxBytes :: Integer -> Result(Binary, Object) =>
    read := self readBody: #{#length => maxBytes}
    read isError ifTrue: [^Result error: read error]
    part := read value
    part done ifFalse: [^Result error: #body_too_large]
    Result ok: part data

  // === The response ===

  /// The queued putRespHeader: headers plus the call's own headers
  /// (Bandit merges conn.resp_headers into every response head).
  headersWithQueued: st :: ExchangeState extra: hs :: HttpHeaders -> HttpHeaders =>
    all := st respHeaders
    hs do: [:h :: Tuple | all := all add: h]
    all

  /// The whole response (Bandit's send_resp): the body encoded when a
  /// coding was negotiated (see Compression), content-length set from the
  /// encoded body (a String, Binary or iodata), head and body in one
  /// send. No body goes out for HEAD, 204 or 304. Raises AlreadySent on a
  /// second response and TransportError if the socket fails.
  sendResp: status :: Integer headers: hs :: HttpHeaders body: body :: Object -> Exchange =>
    st := self load
    st respState =:= #unset
      ifFalse: [
        AlreadySent signal: "already_sent: a response was already sent for this request"
      ]
    st := st withRespStartTime: BuccaneerTelemetry monotonicTime
    {encodedHeaders, context} := Compression
      start: st contentEncoding
      status: status
      headers: (self headersWithQueued: st extra: hs)
      options: st httpOptions
      emptyBody: (SocketHelpers iodataEmpty: body)
      streamable: false
    encoded := body
    context method =:= #identity
      ifFalse: [
        {piece, done} := context compress: body
        encoded := #(piece, done close)
        st := self recordCompression: done on: st
      ]
    length := Erlang erlang iolist_size: encoded
    withLength := Headers
      addContentLength: encodedHeaders
      length: length
      status: status
      method: st method
    headed := self
      sendHeadersOn: st
      status: status
      headers: withLength
      disposition: #raw
    sent := self
      sendDataOn: headed
      data: encoded
      end: true
    self store: (sent withRespState: #sent)

  /// Bandit's compression metrics, for an encoded response.
  recordCompression: context :: Compression on: st :: ExchangeState -> ExchangeState =>
    context method =:= #identity ifTrue: [^st]
    (st withRespCompressionMethod: context methodName) withRespUncompressedBodyBytes: context bytesIn

  /// Close a chunked response's compression and send its tail (deflate's
  /// final block) ahead of the end of the body.
  sendTail: st :: ExchangeState -> ExchangeState =>
    context := st compression
    context isNil ifTrue: [^st]
    tail := context close
    cleared := (self recordCompression: context on: st) withCompression: nil
    (SocketHelpers iodataEmpty: tail) ifTrue: [^cleared]
    self
      sendDataOn: cleared
      data: tail
      end: false

  /// Start a chunked response (Bandit's send_chunked). When the caller
  /// sets content-length, the body streams length-delimited instead of
  /// chunk-framed, and is never compressed (the caller owns the exact
  /// bytes); otherwise deflate, when negotiated, encodes each chunk. No
  /// body goes out for HEAD, 204 or 304. The caller owns the count: short
  /// or long streams are not validated (Bandit parity) — a short stream
  /// leaves the client waiting, a long one bleeds into the next response.
  sendChunked: status :: Integer headers: hs :: HttpHeaders -> Exchange =>
    st := self load
    st respState =:= #unset
      ifFalse: [
        AlreadySent signal: "already_sent: a response was already sent for this request"
      ]
    st := st withRespStartTime: BuccaneerTelemetry monotonicTime
    merged := self headersWithQueued: st extra: hs
    {encodedHeaders, context} := (Headers getHeader: merged name: "content-length") isNil
      ifTrue: [
        Compression
          start: st contentEncoding
          status: status
          headers: merged
          options: st httpOptions
          emptyBody: false
          streamable: true
      ]
      ifFalse: [{merged, Compression identity}]
    headed := self
      sendHeadersOn: st
      status: status
      headers: encodedHeaders
      disposition: #chunkEncoded
    (self sendsBody: headed)
      ifTrue: [
        streaming := context method =:= #identity ifTrue: [
          nil
        ] ifFalse: [context]
        self store: ((headed withRespState: #chunked) withCompression: streaming)
      ]
      ifFalse: [
        // No body follows: release the stream now.
        context close
        self store: (headed withRespState: #sent)
      ]

  /// One chunk (Bandit's chunk/2), encoded when the response is
  /// compressed. An empty chunk ends the response (after the encoder's
  /// tail). Answers Result ok: nil, or error: #closed when the client has
  /// gone.
  chunk: data :: Object -> Result(Nil, Object) =>
    st := self load
    st respState =:= #chunked ifFalse: [
      NotChunked signal: "not_chunked: chunk: needs sendChunked: first"
    ]
    (SocketHelpers iodataEmpty: data)
      ifTrue: [
        ended := [
          tailed := self sendTail: st
          tailed withTransport: (tailed transport sendData: data end: true)
        ] on: TransportError do: [:e :: Exception | ^Result error: e reason]
        stamped := ended withRespEndTime: BuccaneerTelemetry monotonicTime
        self store: (stamped withRespState: #sent)
        ^Result ok: nil
      ]
    // Encode and size first, send second: invalid iodata raises before
    // any byte goes out, so a Result error never follows a partial send.
    triple := [
      [
        context := st compression
        {encoded, next} := context isNil ifTrue: [
          {data, nil}
        ] ifFalse: [context compress: data]
        size := Erlang erlang iolist_size: encoded
        {(st transport sendData: encoded end: false), size, next}
      ] on: TransportError do: [:e :: Exception | ^Result error: e reason]
    ] on: Error do: [:e :: Exception | ^Result error: e message]
    {transport, size, next} := triple
    stamped := ((st withTransport: transport) withRespBodyBytes: st respBodyBytes + size) withCompression: next
    self store: stamped
    Result ok: nil

  /// A file response (Bandit's send_file). Length is bytes or #all.
  sendFile: status :: Integer headers: hs :: HttpHeaders path: path :: String offset: offset :: Integer length: length :: Object -> Exchange =>
    offset < 0 ifTrue: [Error signal: "Offset cannot be negative"]
    (length isKindOf: Integer) ifTrue: [
      length <= 0 ifTrue: [Error signal: "Length cannot be zero or negative"]
    ]
    ((length =:= #all) or: [
      length isKindOf: Integer
    ]) ifFalse: [Error signal: "Length must be an Integer byte count or #all"]
    st := self load
    st respState =:= #unset
      ifFalse: [
        AlreadySent signal: "already_sent: a response was already sent for this request"
      ]
    st := st withRespStartTime: BuccaneerTelemetry monotonicTime
    {_, size, kind, _, _, _, _, _, _, _, _, _, _, _} := ((Erlang file) read_file_info: path with: #(#raw, {#time, #universal})) unwrap
    kind =:= #regular ifFalse: [
      Error signal: ("Cannot read file " ++ path ++ ": not a regular file")
    ]
    total := length =:= #all ifTrue: [size - offset] ifFalse: [length]
    (total >= 0 and: [offset + total <= size])
      ifFalse: [
        Error
          signal: ("Cannot read "
            ++ total printString
            ++ " bytes starting at "
            ++ offset printString
            ++ " as "
            ++ path
            ++ " is only "
            ++ size printString
            ++ " octets in length")
      ]
    withLength := Headers
      addContentLength: (self headersWithQueued: st extra: hs)
      length: total
      status: status
      method: st method
    headed := self
      sendHeadersOn: st
      status: status
      headers: withLength
      disposition: #raw
    (self sendsBody: headed) ifFalse: [
      ^self store: (headed withRespState: #sent)
    ]
    sent := headed transport
      sendfile: path
      offset: offset
      length: total
    stamped := ((headed withTransport: sent) withRespBodyBytes: total) withRespEndTime: BuccaneerTelemetry monotonicTime
    self store: (stamped withRespState: #sent)

  /// A 1xx response (Bandit's inform/3). Refused on HTTP/1.0, and a
  /// Result error (never a raise) once the final response went out: a 1xx
  /// must precede it. An in-progress upgrade (#upgraded) is not final:
  /// the 101 itself goes out through here after upgradeToWebSocket:.
  inform: status :: Integer headers: hs :: HttpHeaders -> Result(Nil, Object) =>
    st := self load
    (st respState =:= #unset or: [
      st respState =:= #upgraded
    ]) ifFalse: [^Result error: #already_sent]
    st transport version =:= #http10 ifTrue: [^Result error: #not_supported]
    headed := self
      sendHeadersOn: st
      status: status
      headers: hs
      disposition: #inform
    self store: headed
    Result ok: nil

  /// Ask to switch this request to WebSocket (Plug.Conn.upgrade_adapter
  /// with :websocket). Records the WebSock handler and options; the
  /// pipeline validates the request, sends 101 and hands the connection
  /// over after the handler returns, as Plug's model. Answers the
  /// exchange. Raises AlreadySent unless nothing was sent yet.
  ///
  /// ## Arguments
  /// - `websock` (Object) — the `WebSock` handler: its `init`,
  ///   `handleIn:`, `handleInfo:`, optional `handleControl:` and
  ///   `terminate:` run in the upgraded connection's process.
  /// - `opts` (WebSocketUpgradeOptions) — per-upgrade options.
  ///
  /// ## Options
  /// - `#timeout` (Integer | Nil, default `nil`) — read timeout in
  ///   milliseconds, re-armed while the connection is open; past it
  ///   the connection closes with 1002 (or drops a closing
  ///   connection). `nil` waits forever.
  /// - `#compress` (Boolean, default `true`) — allow permessage-deflate
  ///   when the server's `#websocket` section enables it.
  /// - `#maxInflateRatio` (Integer) — overrides the server's.
  /// - `#level`, `#memLevel`, `#strategy` — zlib deflate tuning,
  ///   overriding the server's `#deflateOptions`; see
  ///   `BuccaneerConfig checkUpgradeOptions:` for the accepted values.
  ///
  /// Unknown keys and mistyped values raise here, before the 101 goes
  /// out, so the client sees a 500.
  upgradeToWebSocket: websock :: Object options: opts :: WebSocketUpgradeOptions -> Exchange =>
    st := self load
    st respState =:= #unset
      ifFalse: [
        AlreadySent signal: "already_sent: a response was already sent for this request"
      ]
    BuccaneerConfig checkUpgradeOptions: opts
    self store: ((((st withWebsock: websock) withWebsockState: websock) withWebsocketOptions: opts) withRespState: #upgraded)

  /// Queue a response header (Plug.Conn.put_resp_header), sent with the
  /// next response head — the 101 on an upgrade. Replaces any queued
  /// header with the same name, as Plug does. Answers the exchange.
  /// Raises AlreadySent once the response went out.
  putRespHeader: name :: String value: value :: String -> Exchange =>
    st := self load
    (st respState =:= #sent or: [st respState =:= #chunked])
      ifTrue: [
        AlreadySent signal: "already_sent: a response was already sent for this request"
      ]
    kept := st respHeaders reject: [:h :: Tuple |
      (h at: 1) asciiLowercase =:= name asciiLowercase
    ]
    self store: (st withRespHeaders: (kept add: {name, value}))

  /// Per RFC9110§10.1.1, a client that asked for 100 Continue and never
  /// got one may never send the body: close rather than drain it.
  closeForUnhonoredExpect: hs :: HttpHeaders status: status :: Integer state: st :: ExchangeState -> HttpHeaders =>
    st expectContinue ifFalse: [^hs]
    (status between: 100 and: 199) ifTrue: [^hs]
    st transport version =:= #http11 ifFalse: [^hs]
    (Headers getHeader: hs name: "connection") notNil ifTrue: [^hs]
    hs addFirst: {"connection", "close"}

  /// Bandit's send_headers: a date header unless the caller set one, the
  /// status recorded, and no body for HEAD, 204 or 304.
  sendHeadersOn: st :: ExchangeState status: status :: Integer headers: hs :: HttpHeaders disposition: disposition :: BodyDisposition -> ExchangeState =>
    dated := (Headers getHeader: hs name: "date") isNil ifTrue: [
      hs addFirst: Clock dateHeader
    ] ifFalse: [hs]
    closed := self
      closeForUnhonoredExpect: dated
      status: status
      state: st
    keep := status =:= 100 ifTrue: [
      false
    ] ifFalse: [
      (status between: 100 and: 199) ifTrue: [
        st expectContinue
      ] ifFalse: [false]
    ]
    statused := (st withStatus: status) withExpectContinue: keep
    // A 1xx is never a body: the sendsBody mapping to #noBody applies to
    // final responses only. Funneling an inform: through #noBody would mark
    // the socket #sent while the exchange stays #unset and wedge the next
    // send (notably inform: on a HEAD request).
    actual := (status between: 100 and: 199) ifTrue: [
      disposition
    ] ifFalse: [
      (self sendsBody: statused) ifTrue: [disposition] ifFalse: [#noBody]
    ]
    statused
      withTransport: (statused transport
        sendHeaders: status
        headers: closed
        disposition: actual)

  /// Bandit's send_data: the body counted even when not sent.
  sendDataOn: st :: ExchangeState data: data :: Object end: endRequest :: Boolean -> ExchangeState =>
    transport := (self sendsBody: st) ifTrue: [
      st transport sendData: data end: endRequest
    ] ifFalse: [st transport]
    stamped := endRequest ifTrue: [
      st withRespEndTime: BuccaneerTelemetry monotonicTime
    ] ifFalse: [st]
    (stamped withTransport: transport) withRespBodyBytes: st respBodyBytes + (Erlang erlang iolist_size: data)

  /// Bandit's send_resp_body?.
  sendsBody: st :: ExchangeState -> Boolean =>
    st method =:= "HEAD" ifTrue: [^false]
    st status =:= 204 ifTrue: [^false]
    st status =:= 304 ifTrue: [^false]
    true

  // === Engine side, after the handler returns ===

  /// The latest transport. The pipeline answers errors on the request's
  /// original transport (as Bandit's send_on_error does); this is for
  /// handlers and tests inspecting the exchange mid-request.
  transport -> HTTP1Socket => self load transport

  /// Bandit's commit_response!: raises NotSentError when the handler
  /// sent nothing (the pipeline answers it with a 500). Every response
  /// state is named, so a state Phase 3 adds without extending this
  /// fails loudly instead of hanging the response.
  commit -> Exchange =>
    self state match: [
      #unset -> NotSentError signal: "a response was neither set nor sent from the connection";
      #sent -> self;
      #chunked -> self closeChunked;
      _ -> Error signal: "commit: unhandled response state"
    ]

  /// Bandit's commit for a chunked response: the encoder's tail, then
  /// the closing empty chunk. Errors are ignored, as Bandit does.
  closeChunked -> Exchange =>
    st := self load
    [
      [
        tailed := self sendTail: st
        closed := tailed transport sendData: "" end: true
        stamped := (tailed withTransport: closed) withRespEndTime: BuccaneerTelemetry monotonicTime
        self store: (stamped withRespState: #sent)
      ]
        on: TransportError
        do: [:e :: Exception |
          // The closing write failed (client gone mid-close): the connection
          // is dead, so drop keepalive for a clean close instead of serving a
          // doomed next request on a #chunking transport.
          dead := (st withTransport: (st transport withKeepalive: false)) withRespState: #sent
          self store: dead
        ]
    ]
      on: Error
      do: [:e :: Exception |
        dead := (st withTransport: (st transport withKeepalive: false)) withRespState: #sent
        self store: dead
      ]

  /// Forget the state without draining (the pipeline's error paths;
  /// idempotent, unlike finish).
  forget -> Exchange =>
    ProcessDictionary erase: self key
    self

  /// Forget the state, then drain an unread body (ensureCompleted) and
  /// answer the transport for the next keepalive request. The state goes
  /// first so a raising drain cannot leak it into the next request.
  finish -> HTTP1Socket =>
    st := self load
    ProcessDictionary erase: self key
    st transport ensureCompleted
