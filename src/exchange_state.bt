/// The response's progress, as Plug.Conn's state.
type ExchangeRespState = #unset | #sent | #chunked | #upgraded

/// Request schemes.
/// Bandit.Adapter's fields: one request's state, kept in the owner
/// process by its Exchange and replaced on every call. The request fields
/// are fixed by the pipeline when it opens the exchange; the transport is
/// the latest HTTP1Socket (an HTTP2Stream in Phase 6).
sealed typed Value subclass: ExchangeState
  field: transport :: HTTP1Socket = HTTP1Socket new
  field: method :: String = "GET"
  field: scheme :: Scheme = #http
  field: host :: String = ""
  field: port :: Integer = 0
  field: path :: String = "/"
  field: query :: String | Nil = nil
  field: headers :: HttpHeaders = #()
  /// The last status sent, informational included (Bandit's status).
  field: status :: Integer | Nil = nil
  /// Whether the client asked for `100-continue` and is still waiting.
  field: expectContinue :: Boolean = false
  field: respState :: ExchangeRespState = #unset
  /// Bandit's req_body_bytes and resp_body_bytes metrics.
  field: reqBodyBytes :: Integer = 0
  field: respBodyBytes :: Integer = 0
  /// Request telemetry stamps (native monotonic time, nil until reached).
  field: reqHeaderEndTime :: Integer | Nil = nil
  field: reqBodyStartTime :: Integer | Nil = nil
  field: reqBodyEndTime :: Integer | Nil = nil
  field: respStartTime :: Integer | Nil = nil
  field: respEndTime :: Integer | Nil = nil
  /// The WebSocket upgrade request (Phase 4): the WebSock handler and
  /// its initial state, plus the per-upgrade options Dictionary.
  field: websock :: Object = nil
  field: websockState :: Object = nil
  field: websocketOptions :: Dictionary = Dictionary new
  /// Response headers the handler set before answering (putRespHeader:),
  /// sent with the next response head — the 101 on an upgrade.
  field: respHeaders :: HttpHeaders = #()
  /// The server's `#http` options (compression settings).
  field: httpOptions :: HttpOptions = #{}
  /// The coding negotiated from `accept-encoding`, or nil (Bandit's
  /// content_encoding).
  field: contentEncoding :: String | Nil = nil
  /// The chunked response's compression context, while one streams.
  field: compression :: Compression | Nil = nil
  /// Bandit's resp_compression_method and resp_uncompressed_body_bytes
  /// metrics: nil unless the response was encoded.
  field: respCompressionMethod :: String | Nil = nil
  field: respUncompressedBodyBytes :: Integer | Nil = nil
  /// Whether the request's span is emitted: false leaves the telemetry
  /// stamps above nil, saving the clock reads.
  field: timed :: Boolean = true
