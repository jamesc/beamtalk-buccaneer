/// Request-body progress (Bandit's read_state).
type ReadState = #unread | #headersRead | #read

/// Response progress (Bandit's write_state).
type WriteState = #unsent | #writing | #chunking | #chunkStreaming | #sent

/// Catalina recv timeouts: milliseconds or #infinity.
type RecvTimeout = Integer | #infinity

/// Bandit.HTTP1.Socket: the low-level HTTP/1 connection mechanics
/// (RFC 9112). A Value threaded functionally; the Exchange state stores
/// the latest one. The request line and headers come from
/// erlang:decode_packet through the FFI; a nil socket parses from the
/// buffer only (tests).
typed Value subclass: HTTP1Socket
  field: socket :: Socket | Nil = nil
  field: buffer :: Binary = ""
  field: readState :: ReadState = #unread
  field: writeState :: WriteState = #unsent
  field: unreadContentLength :: Integer | Nil = nil
  field: bodyEncoding :: Binary | Nil = nil
  field: version :: HttpVersion = #http10
  field: sendBuffer :: List = #()
  field: requestConnectionHeader :: Binary | Nil = nil
  field: closeAfterResponse :: Boolean = false
  field: keepalive :: Boolean | Nil = nil
  field: opts :: ConfigOptions = Dictionary new

  /// {method, target, headers, socket}: the request head. Bandit tags
  /// {:ok, ...}; the tag never varies (failures raise), so it is dropped.
  readHeaders -> Tuple =>
    head := self doReadRequestLine
    method := head at: 1
    target := head at: 2
    socket := head at: 3
    headed := socket doReadHeaders: #() count: 0
    headers := headed at: 1
    headedSocket := headed at: 2
    contentLength := self contentLengthOf: headers
    bodyEncoding := self transferEncodingOf: headers
    conn := self loweredOrOpaque: (Headers getHeader: headers name: "connection")
    socket3 := headedSocket withRequestConnectionHeader: conn
    contentLength isNil
      ifTrue: [
        bodyEncoding isNil ifTrue: [
          ^{method, target, headers, socket3 withReadState: #read}
        ]
        socket3 version =:= #http10
          ifTrue: [
            HTTPError signal: "Transfer-encoding is not valid for HTTP/1.0 requests (RFC9112§6.1)"
          ]
        ^{method, target, headers, (socket3 withReadState: #headersRead) withBodyEncoding: bodyEncoding}
      ]
      ifFalse: [
        bodyEncoding isNil
          ifFalse: [
            HTTPError signal: "Request cannot contain both 'content-length' and 'transfer-encoding' (RFC9112§6.3.3)"
          ]
        ^{method, target, headers, (socket3 withReadState: #headersRead) withUnreadContentLength: contentLength}
      ]

  /// {#ok | #more, data, socket}: the next body part (Bandit's
  /// read_data). Options (#length default 8_000_000, #readLength default
  /// 1_000_000, #readTimeout default 15_000) cap one call; #more means
  /// call again. Data is bytes; it may be a String or a Binary.
  readData: options :: Dictionary -> Tuple =>
    self readState =:= #headersRead ifFalse: [^{#ok, "", self}]
    unread := self unreadContentLength
    unread isNil ifFalse: [^self readContentLengthData: unread options: options]
    encoding := self bodyEncoding
    encoding =:= "chunked" ifTrue: [^self readChunkedData: options]
    encoding isNil ifFalse: [HTTPError signal: "Unsupported transfer-encoding"]
    {#ok, "", self}

  readContentLengthData: unread :: Integer options: options :: Dictionary -> Tuple =>
    maxLength := self
      dataOpt: #length
      default: 8000000
      options: options
    bytesToReturn := unread < maxLength ifTrue: [unread] ifFalse: [maxLength]
    read := self
      readExactly: bytesToReturn
      from: self buffer
      readSize: (self
        dataOpt: #readLength
        default: 1000000
        options: options)
      timeout: (self
        dataOpt: #readTimeout
        default: 15000
        options: options)
    body := read at: 1
    rest := read at: 2
    remaining := unread - body byteSize
    socket := (self withBuffer: rest) withUnreadContentLength: remaining
    remaining =:= 0 ifTrue: [^{#ok, body, socket withReadState: #read}]
    {#more, body, socket}

  /// {bytes, rest}: exactly toRead bytes, reading more when the buffer
  /// runs short (Bandit's read_exactly!).
  readExactly: toRead :: Integer from: buffer :: Binary readSize: readSize :: Integer timeout: timeout :: Integer -> Tuple =>
    still := toRead - buffer byteSize
    still =:= 0 ifTrue: [^{buffer, ""}]
    still < 0
      ifTrue: [
        ^{(buffer part: 0 size: toRead), (buffer part: toRead size: (buffer byteSize - toRead))}
      ]
    sock := self socket
    sock isNil ifTrue: [Error signal: "Incomplete body with no socket"]
    actual := still < readSize ifTrue: [still] ifFalse: [readSize]
    result := sock recv: actual timeout: timeout
    result isError
      ifTrue: [
        reason := result error
        reason =:= #timeout ifTrue: [self disconnectedOrTimeout: sock]
        TransportError signal: ("Unrecoverable error: " ++ reason printString)
      ]
    data := result value
    self
      readExactly: toRead
      from: (buffer concat: data)
      readSize: readSize
      timeout: timeout

  readChunkedData: options :: Dictionary -> Tuple =>
    maxLength := self
      dataOpt: #length
      default: 8000000
      options: options
    self
      readChunkedData: self buffer
      body: ""
      bodyLength: 0
      maxLength: maxLength
      options: options

  /// {tag, body, socket}, looping over chunks until the body ends or
  /// maxLength is reached (Bandit's do_read_chunked_data!).
  readChunkedData: buffer :: Binary body: body :: Binary bodyLength: length :: Integer maxLength: maxLength :: Integer options: options :: Dictionary -> Tuple =>
    maxToRead := maxLength - length
    chunk := self
      readChunk: buffer
      maxToRead: maxToRead
      options: options
    data := chunk at: 1
    rest := chunk at: 2
    data isEmpty ifTrue: [
      ^{#ok, body, (self withBuffer: rest) withReadState: #read}
    ]
    grown := body concat: data
    data byteSize < maxToRead
      ifTrue: [
        ^self
          readChunkedData: rest
          body: grown
          bodyLength: (length + data byteSize)
          maxLength: maxLength
          options: options
      ]
    {#more, grown, self withBuffer: rest}

  /// {data, rest}: one chunk; oversized chunks answer a fake chunk header
  /// in front of the rest so the next call resumes mid-chunk (Bandit's
  /// do_read_chunk!).
  readChunk: buffer :: Binary maxToRead: maxToRead :: Integer options: options :: Dictionary -> Tuple =>
    sized := self readChunkSize: buffer options: options
    size := sized at: 1
    rest := sized at: 2
    size =:= 0 ifTrue: [^self readTrailers: rest]
    toRead := size < maxToRead ifTrue: [size] ifFalse: [maxToRead]
    read := self
      readExactly: toRead
      from: rest
      readSize: (self
        dataOpt: #readLength
        default: 1000000
        options: options)
      timeout: (self
        dataOpt: #readTimeout
        default: 15000
        options: options)
    data := read at: 1
    rest2 := read at: 2
    remaining := size - toRead
    remaining =:= 0
      ifTrue: [
        tailed := self
          readExactly: 2
          from: rest2
          readSize: (self
            dataOpt: #readLength
            default: 1000000
            options: options)
          timeout: (self
            dataOpt: #readTimeout
            default: 15000
            options: options)
        newline := tailed at: 1
        rest3 := tailed at: 2
        (self isCrlf: newline) ifFalse: [
          HTTPError signal: "Malformed chunked encoding request body"
        ]
        ^{data, rest3}
      ]
    {data, (((self hexOf: remaining) ++ Headers crlf) concat: rest2)}

  /// {size, rest}: the chunk size, reading on until the CRLF appears.
  /// Past 16 buffered bytes the header is rejected (RFC9112§7.1).
  readChunkSize: buffer :: Binary options: options :: Dictionary -> Tuple =>
    buffer byteSize < 16 ifTrue: [^self chunkSizeIn: buffer options: options]
    found := (Erlang binary) match: (buffer part: 0 size: 16) with: Headers crlf
    found match: [
      {pos, 2} -> self parseChunkSize: buffer lineLength: pos;
      _ -> HTTPError signal: "Was not able to parse a chunk size less than 16 octets in length"
    ]

  chunkSizeIn: buffer :: Binary options: options :: Dictionary -> Tuple =>
    found := (Erlang binary) match: buffer with: Headers crlf
    found match: [
      {pos, 2} -> self parseChunkSize: buffer lineLength: pos;
      _ -> self
        readChunkSize: (buffer
          concat: (self
            readAvailableTimeout: (self
              dataOpt: #readTimeout
              default: 15000
              options: options)))
        options: options
    ]

  parseChunkSize: buffer :: Binary lineLength: length :: Integer -> Tuple =>
    line := buffer part: 0 size: length
    rest := buffer part: (length + 2) size: (buffer byteSize - length - 2)
    {(self parseChunkSizeLine: line), rest}

  /// The size of one chunk-size line; extensions (from ';') are ignored
  /// (RFC9112§7.1.1). Anything but 1*HEXDIG is a 400: Bandit documents
  /// why a bare Integer parse would wrongly accept '+10' and '-0'.
  parseChunkSizeLine: line :: Binary -> Integer =>
    size := 0
    digits := 0
    i := 0
    [i < line byteSize]
      whileTrue: [
        byte := line byteAt: i
        byte =:= 59 ifTrue: [^self chunkSizeChecked: size digits: digits]
        digit := self hexValue: byte
        digit isNil ifTrue: [HTTPError signal: "Unable to parse chunk size"]
        size := size * 16 + digit
        digits := digits + 1
        i := i + 1
      ]
    self chunkSizeChecked: size digits: digits

  chunkSizeChecked: size :: Integer digits: digits :: Integer -> Integer =>
    digits =:= 0 ifTrue: [HTTPError signal: "Unable to parse chunk size"]
    size

  hexValue: byte :: Integer -> Integer | Nil =>
    (byte between: 48 and: 57) ifTrue: [^byte - 48]
    (byte between: 97 and: 102) ifTrue: [^byte - 87]
    (byte between: 65 and: 70) ifTrue: [^byte - 55]
    nil

  /// Lowercase hex for resumed-chunk headers (Bandit emits upper; only
  /// our own parser reads it back, and it accepts both). Digits go
  /// through fromBytes:, not Character value:: the latter answers the
  /// raw Integer for computed (non-literal) arguments.
  hexOf: n :: Integer -> String =>
    n =:= 0 ifTrue: [^"0"]
    out := ""
    rest := n
    [rest > 0]
      whileTrue: [
        d := rest % 16
        code := d < 10 ifTrue: [48 + d] ifFalse: [87 + d]
        out := ((Binary fromBytes: #(code)) asString concat: out)
        rest := rest div: 16
      ]
    out

  /// Whether bytes are a CRLF, checked byte-wise so Binary and String
  /// buffers compare identically.
  isCrlf: bytes :: Binary -> Boolean =>
    bytes byteSize =:= 2 ifFalse: [^false]
    (bytes byteAt: 0) =:= 13 ifFalse: [^false]
    (bytes byteAt: 1) =:= 10

  /// The zero-size chunk's trailers: read and ignored, warning when
  /// present (Bandit reuses its header reader on a default-options socket).
  readTrailers: rest :: Binary -> Tuple =>
    fake := (HTTP1Socket new withSocket: self socket) withBuffer: rest
    read := fake doReadHeaders: #() count: 0
    trailers := read at: 1
    trailerSocket := read at: 2
    trailers isEmpty ifFalse: [
      Logger warn: "Encountered trailers in chunked request; ignoring"
    ]
    {"", trailerSocket buffer}

  /// A readData: option with Bandit's default. Non-integers raise.
  dataOpt: key :: Symbol default: default :: Integer options: options :: Dictionary -> Integer =>
    raw := options at: key ifAbsent: [^default]
    (raw isKindOf: Integer) ifFalse: [
      Error signal: ("Invalid value for read option " ++ key asString)
    ]
    raw

  /// Only WebSocket upgrades (validated by the pipeline).
  supportsUpgrade: protocol :: Symbol -> Boolean => protocol =:= #websocket

  doReadRequestLine -> Tuple =>
    packetSize := self http1Opt: #maxRequestLineLength default: 10000
    decoded := Erlang erlang
      decode_packet: #http_bin
      with: self buffer
      with: #({#packet_size, packetSize})
    decoded isError
      ifTrue: [
        reason := decoded error reason
        reason =:= #invalid ifTrue: [
          HTTPError414 signal: "Request URI is too long"
        ]
        HTTPError signal: ("Request line unknown error: " ++ reason printString)
      ]
    decoded match: [
      {#more, _} -> (self withBuffer: (self buffer concat: self readAvailable)) doReadRequestLine;
      {#ok, {#http_request, m, t, ver}, rest} -> self
        requestHead: m
        target: t
        version: ver
        rest: rest;
      {#ok, {#http_error, reason}, rest} -> reason =:= Headers crlf ifTrue: [
        (self withBuffer: rest) doReadRequestLine
      ] ifFalse: [
        HTTPError signal: ("Request line HTTP error: " ++ reason printString)
      ];
      _ -> HTTPError signal: "Request line unknown error"
    ]

  /// Assemble {method, target, socket} from a decoded request line.
  requestHead: m :: Object target: t :: Object version: ver :: Object rest: rest :: Binary -> Tuple =>
    method := m match: [
      s :: Symbol -> s asString;
      b :: String -> b;
      _ -> HTTPError signal: "Request line HTTP error: bad method"
    ]
    target := self resolveRequestTarget: t method: method
    socket := (self withBuffer: rest) withVersion: (self versionOf: ver)
    {method, target, socket}

  versionOf: ver :: Object -> HttpVersion =>
    ver match: [
      {1, 1} -> #http11;
      {1, 0} -> #http10;
      _ -> HTTPError signal: ("Invalid HTTP version: " ++ ver printString)
    ]

  /// {scheme, host, port, path}, with nils by form (Bandit's 4-tuple).
  /// A bare-string target (decode_packet on a garbage line) answers 400
  /// here; Bandit's clauses miss it and 500. Deliberate: garbage input
  /// should not look like a server bug in monitoring.
  resolveRequestTarget: target :: Object method: method :: String -> Tuple =>
    target match: [
      {#abs_path, path} -> {nil, nil, nil, path};
      {#absoluteURI, scheme, host, #undefined, path} -> {self stringOf: scheme, host, nil, path};
      {#absoluteURI, scheme, host, port, path} -> {self stringOf: scheme, host, port, path};
      star :: Symbol -> (star asString =:= "*" and: [
        method =:= "OPTIONS"
      ]) ifTrue: [
        {nil, nil, nil, star}
      ] ifFalse: [
        HTTPError signal: "Unsupported request target (RFC9112§3.2)"
      ];
      {#scheme, scheme, port} -> method =:= "CONNECT" ifTrue: [
        {nil, scheme, port, nil}
      ] ifFalse: [
        HTTPError signal: "Unsupported request target (RFC9112§3.2)"
      ];
      _ -> HTTPError signal: "Unsupported request target (RFC9112§3.2)"
    ]

  /// decode_packet answers atoms for well-known tokens, binaries otherwise.
  stringOf: value :: Object -> String =>
    value match: [
      s :: Symbol -> s asString;
      b :: String -> b;
      _ -> HTTPError signal: "Request line HTTP error: bad token"
    ]

  doReadHeaders: headers :: List(Tuple) count: count :: Integer -> Tuple =>
    packetSize := self http1Opt: #maxHeaderLength default: 10000
    maxCount := self http1Opt: #maxHeaderCount default: 50
    decoded := Erlang erlang
      decode_packet: #httph_bin
      with: self buffer
      with: #({#packet_size, packetSize})
    decoded isError
      ifTrue: [
        reason := decoded error reason
        reason =:= #invalid ifTrue: [HTTPError431 signal: "Header too long"]
        HTTPError signal: ("Header read unknown error: " ++ reason printString)
      ]
    decoded match: [
      {#more, _} -> (self withBuffer: (self buffer concat: self readAvailable)) doReadHeaders: headers count: count;
      {#ok, {#http_header, _n, field, _r, value}, rest} -> self
        headerRead: field
        value: value
        rest: rest
        headers: headers
        count: count
        maxCount: maxCount;
      {#ok, #http_eoh, rest} -> {headers reversed, (self withBuffer: rest) withReadState: #headersRead};
      {#ok, {#http_error, reason}, _rest} -> HTTPError signal: ("Header read HTTP error: " ++ reason printString);
      _ -> HTTPError signal: "Header read unknown error"
    ]

  headerRead: field :: Object value: value :: Object rest: rest :: Binary headers: headers :: List(Tuple) count: count :: Integer maxCount: maxCount :: Integer -> Tuple =>
    (Headers fieldValueValid: value) ifFalse: [
      HTTPError signal: "Field value contains invalid characters (RFC9110§5.5)"
    ]
    name := field match: [
      s :: Symbol -> s asString;
      b :: String -> b;
      _ -> HTTPError signal: "Header read HTTP error: bad name"
    ]
    next := count + 1
    next > maxCount ifTrue: [HTTPError431 signal: "Too many headers"]
    (self withBuffer: rest) doReadHeaders: (headers addFirst: {(Headers asciiLowercase: name), value}) count: next

  contentLengthOf: headers :: List(Tuple) -> Integer | Nil =>
    result := Headers getContentLength: headers
    result isError
      ifTrue: [
        HTTPError signal: ("Content length unknown error: " ++ result error printString)
      ]
    length := result value
    length

  transferEncodingOf: headers :: List(Tuple) -> Binary | Nil =>
    result := Headers getTransferEncoding: headers
    result isError
      ifTrue: [
        HTTPError signal: ("Transfer encoding unknown error: " ++ result error printString)
      ]
    self loweredOrOpaque: result value

  /// Lowercase a header value for comparison, passing nil and non-UTF8
  /// values through: a Binary can never equal an ASCII token, so leaving
  /// it unlowercased is observationally identical for exact matching.
  loweredOrOpaque: value :: Object -> Binary | Nil =>
    value isNil ifTrue: [^nil]
    (value isKindOf: String) ifTrue: [^Headers asciiLowercase: value]
    (value isKindOf: Binary) ifTrue: [^value]
    nil

  /// An #http1 option with Bandit's default. Non-integers raise: these
  /// feed decode_packet limits, where a bad type would fail obscurely.
  http1Opt: key :: Symbol default: default :: Integer -> Integer =>
    section := self opts at: #http1 ifAbsent: [^default]
    (section isKindOf: Dictionary) ifFalse: [^default]
    raw := section at: key ifAbsent: [^default]
    (raw isKindOf: Integer) ifFalse: [
      Error signal: ("Invalid value for http1 option " ++ key asString)
    ]
    raw

  /// The next available bytes (Bandit's read_available!).
  readAvailable -> Binary =>
    sock := self socket
    sock isNil ifTrue: [Error signal: "Incomplete head with no socket"]
    self availableFrom: sock timeout: sock readTimeout

  /// The next available bytes with an explicit timeout (body reads).
  readAvailableTimeout: timeout :: Integer -> Binary =>
    sock := self socket
    sock isNil ifTrue: [Error signal: "Incomplete body with no socket"]
    self availableFrom: sock timeout: timeout

  availableFrom: sock :: Socket timeout: timeout :: RecvTimeout -> Binary =>
    result := sock recv: 0 timeout: timeout
    result isOk
      ifTrue: [
        chunk := result value
        chunk isEmpty ifTrue: [^self disconnectedOrTimeout: sock]
        ^chunk
      ]
    reason := result error
    reason =:= #timeout ifTrue: [^self disconnectedOrTimeout: sock]
    TransportError signal: ("Unrecoverable error: " ++ reason printString)

  /// After a timeout or empty read, check whether the peer is still
  /// connected: TransportError for a disconnect, HTTPError408 for a
  /// genuine timeout.
  disconnectedOrTimeout: sock :: Socket -> Binary =>
    probe := sock recv: 0 timeout: 0
    probe isOk ifTrue: [HTTPError408 signal: "Body read timeout"]
    reason := probe error
    reason =:= #timeout ifTrue: [HTTPError408 signal: "Read timeout"]
    TransportError signal: ("Unrecoverable error: " ++ reason printString)
