/// Bandit.HTTP2.Stream as a Value: the per-stream transport state and the
/// request-head validation (RFC 9113 §8). Blocking reads, flow-controlled
/// sends and window waits are sync calls from the stream process to the
/// connection actor (protocol turn); everything here is pure.
///
/// States: #idle, #open, #localClosed, #remoteClosed, #closed.
sealed typed Value subclass: HTTP2Stream
  field: connection :: ConnectionHandler | Nil = nil
  field: streamId :: Integer = 0
  field: state :: Symbol = #idle
  field: recvWindowSize :: Integer = 65535
  field: sendWindowSize :: Integer = 65535
  field: sendfileChunkSize :: Integer = 1048576
  field: bytesRemaining :: Integer | Nil = nil
  field: socket :: Socket | Nil = nil
  field: pendingHeaders :: List(Tuple) | Nil = nil
  field: readTimeout :: Integer = 15000
  field: peerData :: SocketAddress | Nil = nil
  field: sockData :: SocketAddress | Nil = nil
  field: secure :: Boolean = false
  field: peerCert :: Result(Binary, Object) | Nil = nil
  // The request's {headers, endStream}, handed over at spawn so
  // readHeaders needs no connection call.
  field: requestHead :: Tuple | Nil = nil
  // The request side has ended (END_STREAM seen and the body read):
  // body reads and the drain then need no connection call.
  field: requestEnded :: Boolean = false
  // A #raw response head, encoded (encodeHead:headers:), held until the
  // first body bytes so both go out in one connection call.
  field: heldHead :: Binary | Nil = nil

  /// A stream for the connection process with the negotiated windows.
  class sealed init: conn :: ConnectionHandler | Nil sid: sid :: Integer sendWindow: sw :: Integer recvWindow: rw :: Integer sendfileChunk: chunk :: Integer contentLength: cl :: Integer | Nil -> HTTP2Stream =>
    ((((((HTTP2Stream new withConnection: conn) withStreamId: sid) withSendWindowSize: sw) withRecvWindowSize: rw) withSendfileChunkSize: chunk) withBytesRemaining: cl)

  /// A response header block that needs no HPACK dynamic table, so the
  /// stream process can encode it in any order with other streams' (the
  /// connection's table is the peer's to track, and only the connection
  /// may touch it). :status is a static-table entry where RFC 7541
  /// Appendix A has one, else a literal with the :status name (index
  /// 8); every other field is a literal without indexing (§6.2.2).
  class sealed encodeHead: status :: Integer headers: headers :: HttpHeaders -> Binary =>
    index := status match: [
      200 -> 8;
      204 -> 9;
      206 -> 10;
      304 -> 11;
      400 -> 12;
      404 -> 13;
      500 -> 14;
      _ -> nil
    ]
    first := index isNil
      ifTrue: [
        HPACK
          literalPlain: 8
          value: status printString
          huffman: false
      ]
      ifFalse: [HPACK encodeIndexed: index]
    fields := headers
      collect: [:h :: Tuple |
        name := h at: 1
        value := h at: 2
        // hpack 0.1.1 removed `validateHeader:value:` (BT-4362 perf);
        // `literalPlainNew:` takes Binary params, so non-binary
        // names/values still raise at that boundary.
        HPACK
          literalPlainNew: name
          value: value
          huffman: false
      ]
    Binary fromIolist: #(first, fields)

  /// Validate decoded request headers: answers {method, target, headers,
  /// contentLength} where target is {scheme, host, port, path}.
  /// Raises H2StreamError.
  checkRequestHeaders: headers :: List(Tuple) -> Tuple(String, Tuple, List(Tuple), Integer | Nil) =>
    stringed := self stringHeaders: headers
    {pseudo, rest} := self splitPseudo: stringed
    self checkPseudo: pseudo
    method := self exactlyOnce: pseudo name: ":method"
    schemeName := self exactlyOnce: pseudo name: ":scheme"
    path := self exactlyOnce: pseudo name: ":path"
    self atMostOnce: pseudo name: ":authority"
    _ := self checkRegular: rest
    contentLength := self contentLength: rest
    {host, port} := self hostAndPort: pseudo
    cooked := self combineCookies: rest
    {method, {self schemeFor: schemeName, host, port, (self checkedPath: path)}, cooked, contentLength}

  /// Map the :scheme value to a Scheme (:https only for "https").
  schemeFor: scheme :: String -> Symbol =>
    scheme =:= "https" ifTrue: [^#https]
    #http

  /// Headers with String names and values when valid UTF-8 (HPACK
  /// decodes to Binary); non-UTF-8 names are stream errors, other
  /// opaque values pass through for the regular-header paths.
  stringHeaders: headers :: List(Tuple) -> List(Tuple) =>
    headers
      collect: [:h :: Tuple |
        name := Headers stringOrOpaque: (h at: 1)
        (name isKindOf: String)
          ifFalse: [
            H2StreamError
              signal: "Received invalid header name"
              code: HTTP2Errors protocolError
              streamId: self streamId
          ]
        // The HPACK static table decodes an entry with no value (an
        // indexed user-agent, say) as nil: an empty value.
        value := h at: 2
        {name, (value isNil ifTrue: [
          ""
        ] ifFalse: [Headers stringOrOpaque: value])}
      ]

  /// Split leading pseudo-headers from regular ones; a pseudo-header
  /// after a regular one is a stream error.
  splitPseudo: headers :: List(Tuple) -> Tuple(List(Tuple), List(Tuple)) =>
    pseudo := #()
    rest := #()
    seenRegular := false
    headers
      do: [:h :: Tuple |
        name := h at: 1
        (name startsWith: ":")
          ifTrue: [
            seenRegular
              ifTrue: [
                H2StreamError
                  signal: "Received pseudo headers after regular one"
                  code: HTTP2Errors protocolError
                  streamId: self streamId
              ]
            pseudo := pseudo add: h
          ]
          ifFalse: [
            seenRegular := true
            rest := rest add: h
          ]
      ]
    {pseudo, rest}

  /// Only request pseudo-headers may appear.
  checkPseudo: pseudo :: List(Tuple) -> HTTP2Stream =>
    pseudo
      do: [:h :: Tuple |
        name := h at: 1
        ((name =:= ":method" or: [
          name =:= ":scheme"
        ]) or: [name =:= ":authority" or: [name =:= ":path"]])
          ifFalse: [
            H2StreamError
              signal: "Received invalid pseudo header"
              code: HTTP2Errors protocolError
              streamId: self streamId
          ]
      ]
    self

  /// The single value of a required pseudo-header.
  exactlyOnce: pseudo :: List(Tuple) name: want :: String -> String =>
    found := pseudo select: [:h :: Tuple | (h at: 1) =:= want]
    found size =:= 1
      ifFalse: [
        H2StreamError
          signal: ("Expected 1 " ++ want ++ " headers")
          code: HTTP2Errors protocolError
          streamId: self streamId
      ]
    value := found first at: 2
    value match: [
      s :: String -> s;
      _ -> H2StreamError
        signal: ("Expected 1 " ++ want ++ " headers")
        code: HTTP2Errors protocolError
        streamId: self streamId
    ]

  /// The :path value: "*" or an absolute path, per RFC 9113 §8.3.1.
  checkedPath: path :: String -> String =>
    path =:= "*" ifTrue: [^path]
    (path startsWith: "/") ifTrue: [^path]
    H2StreamError
      signal: "Path does not start with /"
      code: HTTP2Errors protocolError
      streamId: self streamId

  /// An optional pseudo-header appears at most once.
  atMostOnce: pseudo :: List(Tuple) name: want :: String -> HTTP2Stream =>
    found := pseudo select: [:h :: Tuple | (h at: 1) =:= want]
    found size > 1
      ifTrue: [
        H2StreamError
          signal: ("Expected at most 1 " ++ want ++ " headers")
          code: HTTP2Errors protocolError
          streamId: self streamId
      ]
    self

  /// Regular header checks: lowercase names, no connection headers,
  /// valid TE, valid field values.
  checkRegular: headers :: List(Tuple) -> HTTP2Stream =>
    headers
      do: [:h :: Tuple |
        name := h at: 1
        (name asciiLowercase =:= name)
          ifFalse: [
            H2StreamError
              signal: "Received uppercase header"
              code: HTTP2Errors protocolError
              streamId: self streamId
          ]
        (self connectionHeader: name)
          ifTrue: [
            H2StreamError
              signal: "Received connection-specific header"
              code: HTTP2Errors protocolError
              streamId: self streamId
          ]
      ]
    _ := self checkTe: headers
    self checkFieldValues: headers

  connectionHeader: name :: String -> Boolean =>
    (#("connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "proxy-connection", "trailers", "transfer-encoding", "upgrade") includes: name)

  /// TE may be absent or exactly "trailers".
  checkTe: headers :: List(Tuple) -> HTTP2Stream =>
    te := Headers getHeader: headers name: "te"
    te isNil ifTrue: [^self]
    self checkTeValue: te

  checkTeValue: te :: Object -> HTTP2Stream =>
    teText := te match: [
      s :: String -> s;
      b :: Binary -> b asStringUnchecked;
      _ -> ""
    ]
    teText =:= "trailers" ifTrue: [^self]
    H2StreamError
      signal: "Received invalid TE header"
      code: HTTP2Errors protocolError
      streamId: self streamId

  checkFieldValues: headers :: List(Tuple) -> HTTP2Stream =>
    headers
      do: [:h :: Tuple |
        (Headers fieldValueValid: (h at: 2))
          ifFalse: [
            H2StreamError
              signal: "Field value contains invalid characters (RFC9113§8.2.1)"
              code: HTTP2Errors protocolError
              streamId: self streamId
          ]
      ]
    self

  /// The content-length, if any (a disagreement is a stream error).
  contentLength: headers :: List(Tuple) -> Integer | Nil =>
    result := Headers getContentLength: headers
    result isOk
      ifFalse: [
        H2StreamError
          signal: result error
          code: HTTP2Errors protocolError
          streamId: self streamId
      ]
    result value

  /// {host, port} from :authority; a missing authority answers nils
  /// (the pipeline then falls back to the Host header rules).
  hostAndPort: pseudo :: List(Tuple) -> Tuple(String | Nil, Integer | Nil) =>
    auth := pseudo select: [:h :: Tuple | (h at: 1) =:= ":authority"]
    auth isEmpty ifTrue: [^{nil, nil}]
    [Headers parseHostlikeHeader: (auth first at: 2)]
      on: HTTPError
      do: [:e :: Exception |
        H2StreamError
          signal: "Invalid :authority header"
          code: HTTP2Errors protocolError
          streamId: self streamId
      ]

  /// Combine cookie crumbs with "; ", first (Bandit parity).
  combineCookies: headers :: List(Tuple) -> List(Tuple) =>
    crumbs := headers select: [:h :: Tuple | (h at: 1) =:= "cookie"]
    others := headers reject: [:h :: Tuple | (h at: 1) =:= "cookie"]
    crumbs isEmpty ifTrue: [^others]
    combined := self joinCrumbs: (crumbs collect: [:h :: Tuple |
      h at: 2
    ]) acc: ""
    combined isEmpty ifTrue: [^others]
    others addFirst: {"cookie", combined}

  joinCrumbs: crumbs :: List(Object) acc: acc :: String -> String =>
    crumbs isEmpty ifTrue: [^acc]
    crumb := crumbs first match: [
      s :: String -> s;
      b :: Binary -> b asStringUnchecked;
      _ -> ""
    ]
    sep := acc isEmpty ifTrue: [""] ifFalse: ["; "]
    self joinCrumbs: crumbs rest acc: acc ++ sep ++ crumb

  // === HTTPTransport: the connection mechanics over sync calls ===
  //
  // The stream process never waits on its own mailbox. Body reads,
  // flow-controlled sends and window waits are sync calls to the
  // connection actor, which parks each with the stdlib deferred reply
  // until the frame or window arrives and answers out of order.

  /// This stream's connection actor, or a TransportError when gone.
  conn -> ConnectionHandler =>
    c := self connection
    c isNil ifTrue: [
      TransportError signal: "Unrecoverable error: stream has no connection"
    ]
    c

  /// A blocking connection call with this stream's read timeout: a timed
  /// `gen_server:call` straight to the connection. (A `withTimeout:`
  /// proxy here was an actor per call, and it leaked whenever the stream
  /// process was killed mid-call: `ensure:` does not run on a kill.)
  callConn: selector :: Symbol args: args :: List -> Dynamic =>
    self conn
      perform: selector
      withArguments: args
      timeout: self readTimeout

  version -> HttpVersion => #http2

  /// The negotiated version (Bandit's version/1).
  readHeaders -> Tuple(String, Tuple, HttpHeaders, HTTP2Stream) =>
    head := self requestHead
    {headers, endStream} := head isNil ifTrue: [
      self conn h2ReadHeaders: self streamId
    ] ifFalse: [head]
    // The connection no longer validates the head (BT-4476): an invalid
    // one resets the stream from here, as a broken body does in readData:.
    checked := [
      self checkHead: headers endStream: endStream
    ] on: H2StreamError do: [:e :: H2StreamError | self failStream: e]
    {method, target, cooked, contentLength} := checked
    next := ((self withBytesRemaining: contentLength) withState: #open) withRequestHead: nil
    {method, target, cooked, (next withRequestEnded: endStream)}

  /// {#ok | #more, data, transport}: the next body part.
  readData: options :: Dictionary(Symbol, Object) -> Tuple(Symbol, Binary, HTTP2Stream) =>
    self requestEnded ifTrue: [^{#ok, (Binary fromBytes: #()), self}]
    max := options at: #length ifAbsent: [8000000]
    maxBytes := max match: [
      n :: Integer -> n;
      _ -> 8000000
    ]
    {data, more, ended} := self callConn: #h2ReadData:maxBytes: args: #(self streamId, maxBytes)
    // A body that breaks its framing dies here in the stream process,
    // not in serve:: RST it like a frame-path stream error, then fail
    // the read so the handler sees a closed body.
    checked := [
      self checkData: data ended: ended
    ] on: H2StreamError do: [:e :: H2StreamError | self failStream: e]
    status := (more or: [ended not]) ifTrue: [#more] ifFalse: [#ok]
    {status, data, (checked withRequestEnded: status =:= #ok)}

  /// The full request-head validation: answers {method, target, headers,
  /// contentLength}. Raises H2StreamError.
  checkHead: headers :: List(Tuple) endStream: endStream :: Boolean -> Tuple(String, Tuple, List(Tuple), Integer | Nil) =>
    checked := self checkRequestHeaders: headers
    contentLength := checked at: 4
    endStream
      ifTrue: [
        contentLength match: [
          n :: Integer -> n =:= 0
            ifFalse: [
              H2StreamError
                signal: "Received END_STREAM with bytes remaining"
                code: HTTP2Errors protocolError
                streamId: self streamId
            ];
          _ -> nil
        ]
      ]
    checked

  /// RST_STREAM a stream whose request broke the protocol, then fail the
  /// caller's read so the handler sees a closed stream. The connection
  /// forgets the stream, so its DOWN sends nothing more.
  failStream: e :: H2StreamError -> Never =>
    // Exception-subclass methods do not dispatch on instances (as in
    // HTTP2Protocol streamCode:), so match the {code, sid} reason.
    code := e reason match: [
      {c, _} -> c match: [
        n :: Integer -> n;
        _ -> HTTP2Errors protocolError
      ];
      _ -> HTTP2Errors protocolError
    ]
    self conn h2ResetStream: self streamId code: code
    // Reason #closed: the reset is already answered on the wire, so the
    // pipeline treats it as a closure (silent unless #logClientClosures)
    // rather than logging a protocol error for every invalid request.
    TransportError signal: "stream reset" reason: #closed

  /// Account a body part against the content length.
  checkData: data :: Binary ended: ended :: Boolean -> HTTP2Stream =>
    left := self bytesRemaining
    left isNil ifTrue: [^self]
    now := left - data size
    now < 0
      ifTrue: [
        H2StreamError
          signal: "Received more data than content-length"
          code: HTTP2Errors protocolError
          streamId: self streamId
      ]
    (ended and: [now > 0])
      ifTrue: [
        H2StreamError
          signal: "Received END_STREAM with bytes remaining"
          code: HTTP2Errors protocolError
          streamId: self streamId
      ]
    self withBytesRemaining: now

  /// The response head; answers the next transport.
  /// A #raw head is held until the first body bytes (as HTTP1Socket
  /// holds it in sendBuffer), so a small response is one connection call.
  /// The head is HPACK-encoded here, in the stream process, so the
  /// connection only frames it.
  sendHeaders: status :: Integer headers: headers :: HttpHeaders disposition: disposition :: BodyDisposition -> HTTP2Stream =>
    block := HTTP2Stream encodeHead: status headers: headers
    disposition =:= #raw ifTrue: [^(self withHeldHead: block) withState: #open]
    // A head that ends both sides needs no answer (see sendData:).
    (disposition =:= #noBody and: [self requestEnded])
      ifTrue: [
        (self conn) h2PushHeaders: self streamId block: block!
        ^self withState: #localClosed
      ]
    self conn
      h2SendBlock: self streamId
      block: block
      endStream: (disposition =:= #noBody)
    self withState: (self sendStateAfter: disposition)

  /// The stream state after sending a head: informational heads change
  /// nothing; a final head closes our side unless the body follows.
  sendStateAfter: disposition :: BodyDisposition -> Symbol =>
    disposition =:= #inform ifTrue: [^self state]
    disposition =:= #noBody ifTrue: [^#localClosed]
    #open

  /// Response data; answers the next transport.
  sendData: data :: Object end: endRequest :: Boolean -> HTTP2Stream =>
    bin := data match: [
      b :: Binary -> b;
      s :: String -> s asBinary;
      l :: List -> Binary fromIolist: l;
      _ -> Error signal: "sendData: needs Binary data"
    ]
    head := self heldHead
    // The final bytes of a stream whose request has ended need no
    // answer: nothing is left to read or drain, so cast them (the
    // connection queues what the windows cannot take yet).
    (endRequest and: [self requestEnded])
      ifTrue: [
        head isNil
          ifTrue: [(self conn) h2PushData: self streamId data: bin!]
          ifFalse: [
            (self conn)
              h2PushResponse: self streamId
              block: head
              data: bin!
          ]
        ^(self withHeldHead: nil) withState: #localClosed
      ]
    head isNil
      ifTrue: [
        self callConn: #h2SendData:data:endStream: args: #(self streamId, bin, endRequest)
      ]
      ifFalse: [
        self callConn: #h2SendResponse:block:data:endStream: args: #(self streamId, head, bin, endRequest)
      ]
    sent := self withHeldHead: nil
    endRequest ifTrue: [^sent withState: #localClosed]
    sent

  /// Send a held #raw head on its own (a file body, or a drain that
  /// found no body sent); answers the transport without it.
  flushHeldHead -> HTTP2Stream =>
    head := self heldHead
    head isNil ifTrue: [^self]
    self conn
      h2SendBlock: self streamId
      block: head
      endStream: false
    self withHeldHead: nil

  /// A file response; answers the next transport. Exchange resolves
  /// #all to a byte count, so length is always an Integer here. As in
  /// Bandit, the file is read in `sendfileChunkSize` pieces from here, in
  /// the stream process, so each piece waits on flow control in turn and
  /// the connection actor never holds the file.
  sendfile: path :: String offset: offset :: Integer length: length :: Object -> HTTP2Stream =>
    self heldHead isNil
      ifFalse: [
        ^self flushHeldHead
          sendfile: path
          offset: offset
          length: length
      ]
    total := length match: [
      n :: Integer -> n;
      _ -> Error signal: "sendfile: length must be an Integer byte count"
    ]
    opened := (Erlang file) open: path with: #(#raw, #binary)
    opened isError
      ifTrue: [
        Error signal: ("Error opening file for sendfile: " ++ opened error printString)
      ]
    fd := opened value
    [
      total =:= 0
        ifTrue: [self sendData: (Binary fromBytes: #()) end: true]
        ifFalse: [
          self
            sendfileLoop: fd
            offset: offset
            length: total
            sent: 0
        ]
    ] ensure: [(Erlang file) close: fd]
    self withState: #localClosed

  /// Read and send the next piece; the last one carries END_STREAM.
  sendfileLoop: fd :: Object offset: offset :: Integer length: total :: Integer sent: sent :: Integer -> HTTP2Stream =>
    sent >= total ifTrue: [^self]
    chunk := self sendfileChunkSize
    cap := chunk < 1 ifTrue: [1] ifFalse: [chunk]
    left := total - sent
    readSize := left < cap ifTrue: [left] ifFalse: [cap]
    data := self
      sendfileRead: fd
      position: offset + sent
      size: readSize
    now := data size
    now =:= 0 ifTrue: [Error signal: "Error reading file for sendfile: eof"]
    ended := (sent + now) >= total
    _ := self sendData: data end: ended
    ended
      ifTrue: [self]
      ifFalse: [
        self
          sendfileLoop: fd
          offset: offset
          length: total
          sent: sent + now
      ]

  /// One pread; anything but data is an error.
  sendfileRead: fd :: Object position: position :: Integer size: size :: Integer -> Binary =>
    read := (Erlang file)
      pread: fd
      with: position
      with: size
    read match: [
      r :: Result -> r isOk
        ifTrue: [
          r value match: [
            b :: Binary -> b;
            _ -> Error signal: "Error reading file for sendfile: not a binary"
          ]
        ]
        ifFalse: [
          Error signal: ("Error reading file for sendfile: " ++ r error printString)
        ];
      _ -> Error signal: "Error reading file for sendfile: eof"
    ]

  /// Drain an unread body within limits; answers the next transport.
  /// Bandit only messages the connection here, which cannot fail when the
  /// connection has gone, so a call to a dead connection actor is ignored
  /// and any other failure is re-raised.
  ensureCompleted -> HTTP2Stream =>
    self heldHead isNil ifFalse: [^self flushHeldHead ensureCompleted]
    // Nothing left to drain: the request ended and its body was read.
    self requestEnded ifTrue: [^self]
    [
      self callConn: #h2Drain: args: #(self streamId)
    ] on: Exception do: [:e :: Exception | self conn isAlive ifTrue: [e pass]]
    self

  /// Whether this transport can upgrade to protocol.
  supportsUpgrade: _protocol :: Symbol -> Boolean => false

  /// Answer an error status unless the handler already sent.
  sendOnError: error :: Exception -> HTTP2Stream =>
    [
      status := (error isKindOf: HTTPError) ifTrue: [
        HTTPError statusFor: error
      ] ifFalse: [500]
      self conn h2SendError: self streamId status: status
    ] on: Exception do: [:e :: Exception | nil]
    self
