/// How the response body is to be delivered (Bandit's body_disposition).
type BodyDisposition = #raw | #chunkEncoded | #noBody | #inform

/// HTTP versions on the wire (Bandit's http_protocol).
type HttpVersion = #http10 | #http11 | #http2

/// Bandit.HTTPTransport: the connection mechanics one HTTP version
/// implements. HTTP1Socket and (Phase 6) HTTP2Stream conform
/// structurally; no implements: declaration is needed.
Protocol define: HTTPTransport
  /// The negotiated version (Bandit's version/1): the pipeline needs it
  /// for the HTTP/1.0 missing-host rule.
  version -> HttpVersion

  /// {method, target, headers, transport}: the request head. Header
  /// names are lowercase: transports normalize at the boundary (HPACK
  /// names already are), and `Headers getHostHeader:` relies on it.
  readHeaders -> Tuple

  /// {#ok | #more, data, transport}: the next body part.
  readData: options :: Dictionary -> Tuple

  /// The response head; answers the next transport.
  sendHeaders: status :: Integer headers: headers :: List(Tuple) disposition: disposition :: BodyDisposition -> Object

  /// Response data; answers the next transport.
  sendData: data :: Object end: endRequest :: Boolean -> Object

  /// A file response; answers the next transport.
  sendfile: path :: String offset: offset :: Integer length: length :: Object -> Object

  /// Drain an unread body within limits; answers the next transport.
  ensureCompleted -> Object

  /// Whether this transport can upgrade to protocol.
  supportsUpgrade: protocol :: Symbol -> Boolean

  /// Answer an error status unless the handler already sent.
  sendOnError: error :: Exception -> Object
