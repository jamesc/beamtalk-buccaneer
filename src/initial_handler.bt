/// Bandit.InitialHandler: look at a new connection and decide what it
/// speaks. Every connection is sniffed, TLS or not: three bytes for a
/// TLS ClientHello, which gets a warning and a close, then the `PRI`
/// preface. The sniff is combined with the ALPN protocol (`#h2`,
/// `#http1` or `#none`) as Bandit does: the preface starts HTTP/2 when
/// ALPN is `#h2` or absent (the client sends it over TLS too, RFC 9113
/// §3.4), other bytes start HTTP/1 with the sniffed bytes buffered when
/// ALPN is `#http1` or absent, and any other pairing closes.
typed Object subclass: InitialHandler

  /// `{#http1, buffered}`, `{#http2, buffered}` or `#close`.
  class sealed run: sock :: Socket options: config :: BuccaneerConfig -> Symbol | Tuple =>
    self sniff: sock options: config alpn: (self alpnOf: sock)

  /// The ALPN protocol of the socket: #h2, #http1 or #none.
  class sealed alpnOf: sock :: Socket -> Symbol =>
    negotiated := sock negotiatedProtocol
    negotiated isOk
      ifTrue: [
        negotiated value =:= "h2" ifTrue: [^#h2]
        negotiated value =:= "http/1.1" ifTrue: [^#http1]
      ]
    #none

  /// Bytes that are not the HTTP/2 preface: HTTP/1 unless ALPN said h2.
  class sealed noPreface: config :: BuccaneerConfig data: buffer :: Binary alpn: alpn :: Symbol -> Symbol | Tuple =>
    alpn =:= #h2 ifTrue: [^#close]
    self http1IfEnabled: config data: buffer

  /// The HTTP/2 preface: HTTP/2 unless ALPN said http/1.1.
  class sealed prefaceSeen: config :: BuccaneerConfig alpn: alpn :: Symbol -> Symbol | Tuple =>
    alpn =:= #http1 ifTrue: [^#close]
    self http2IfEnabled: config

  /// HTTP/1 if enabled, else close.
  class sealed http1IfEnabled: config :: BuccaneerConfig data: buffer :: Binary -> Symbol | Tuple =>
    enabled := config http1 at: #enabled ifAbsent: [true]
    enabled =:= false ifTrue: [^#close]
    {#http1, buffer}

  /// HTTP/2 if enabled, else close (as Bandit with HTTP/2 disabled).
  class sealed http2IfEnabled: config :: BuccaneerConfig -> Symbol | Tuple =>
    enabled := config http2 at: #enabled ifAbsent: [true]
    enabled =:= false ifTrue: [^#close]
    {#http2, (Binary fromBytes: #())}

  /// Peek at the wire: TLS gets a warning and a close, `PRI` starts
  /// the preface sniff, anything else (or a timeout, or an idle
  /// connection) starts HTTP/1. A dead socket closes quietly.
  class sealed sniff: sock :: Socket options: config :: BuccaneerConfig alpn: alpn :: Symbol -> Symbol | Tuple =>
    first := sock recv: 3 timeout: nil
    first isError
      ifTrue: [
        first error =:= #timeout ifTrue: [
          ^self noPreface: config data: (Binary fromBytes: #()) alpn: alpn
        ]
        ^#close
      ]
    bytes := first value
    (self isTlsHello: bytes)
      ifTrue: [
        Logger warn: "Connection that looks like TLS received on a clear channel" metadata: #{
          #domain => #(#buccaneer),
          #plug => config displayHandler
        }
        ^#close
      ]
    bytes =:= (Binary fromBytes: #(80, 82, 73))
      ifTrue: [
        ^self
          sniffPreface: sock
          options: config
          buffer: bytes
          alpn: alpn
      ]
    self noPreface: config data: bytes alpn: alpn

  /// `<<22, 3, 1|3>>`: a TLS ClientHello (1.3 sends legacy 0x0303).
  class sealed isTlsHello: bytes :: Binary -> Boolean =>
    bytes =:= (Binary fromBytes: #(22, 3, 1)) or: [
      bytes =:= (Binary fromBytes: #(22, 3, 3))
    ]

  /// The 21 bytes after `PRI`: the full HTTP/2 preface starts HTTP/2
  /// (the magic is consumed, not buffered); anything else — or a
  /// timeout — starts HTTP/1 with everything buffered.
  class sealed sniffPreface: sock :: Socket options: config :: BuccaneerConfig buffer: buffer :: Binary alpn: alpn :: Symbol -> Symbol | Tuple =>
    rest := sock recv: 21 timeout: nil
    rest isError
      ifTrue: [
        rest error =:= #timeout ifTrue: [
          ^self noPreface: config data: buffer alpn: alpn
        ]
        ^#close
      ]
    rest value =:= (Binary fromIolist: #(" * HTTP/2.0\r\n\r\nSM\r\n\r\n")) ifTrue: [
      ^self prefaceSeen: config alpn: alpn
    ]
    self noPreface: config data: (buffer concat: rest value) alpn: alpn
