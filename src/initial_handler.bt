/// Bandit.InitialHandler: look at a new connection and decide what it
/// speaks. Every connection is sniffed, TLS or not, from what the
/// client has sent so far (Bandit reads three bytes, then 21 more after
/// `PRI`; one read of whatever is there saves a second read on the
/// common path): a TLS ClientHello gets a warning and a close, the
/// HTTP/2 preface starts HTTP/2. The sniff is combined with the ALPN protocol (`#h2`,
/// `#http1` or `#none`) as Bandit does: the preface starts HTTP/2 when
/// ALPN is `#h2` or absent (the client sends it over TLS too, RFC 9113
/// §3.4), other bytes start HTTP/1 with the sniffed bytes buffered when
/// ALPN is `#http1` or absent, and any other pairing closes.
sealed typed Object subclass: InitialHandler

  /// `{#http1, buffered}`, `{#http2, buffered}` or `#close`.
  class sealed run: sock :: Socket options: config :: BuccaneerConfig -> Symbol | Tuple =>
    self
      sniff: sock
      options: config
      alpn: (self alpnOf: sock)

  /// The ALPN protocol of the socket: #h2, #http1 or #none.
  class sealed alpnOf: sock :: Socket -> Symbol =>
    negotiated := sock negotiatedProtocol
    negotiated isOk
      ifTrue: [
        negotiated value =:= "h2" ifTrue: [^#h2]
        negotiated value =:= "http/1.1" ifTrue: [^#http1]
      ]
    #none

  /// Bytes that are not the HTTP/2 preface: HTTP/1 unless ALPN said h2.
  class sealed noPreface: config :: BuccaneerConfig data: buffer :: Binary alpn: alpn :: Symbol -> Symbol | Tuple =>
    alpn =:= #h2 ifTrue: [^#close]
    self http1IfEnabled: config data: buffer

  /// The HTTP/2 preface: HTTP/2 unless ALPN said http/1.1. `data` is
  /// what followed the preface in the same read.
  class sealed prefaceSeen: config :: BuccaneerConfig data: data :: Binary alpn: alpn :: Symbol -> Symbol | Tuple =>
    alpn =:= #http1 ifTrue: [^#close]
    self http2IfEnabled: config data: data

  /// HTTP/1 if enabled, else close.
  class sealed http1IfEnabled: config :: BuccaneerConfig data: buffer :: Binary -> Symbol | Tuple =>
    enabled := config http1 at: #enabled ifAbsent: [true]
    enabled =:= false ifTrue: [^#close]
    {#http1, buffer}

  /// HTTP/2 if enabled, else close (as Bandit with HTTP/2 disabled).
  class sealed http2IfEnabled: config :: BuccaneerConfig data: data :: Binary -> Symbol | Tuple =>
    enabled := config http2 at: #enabled ifAbsent: [true]
    enabled =:= false ifTrue: [^#close]
    {#http2, data}

  /// Read what the client has sent and decide: TLS gets a warning and a
  /// close, the HTTP/2 preface starts HTTP/2 (the rest buffered),
  /// anything else (or a timeout, or an idle connection) starts HTTP/1
  /// with everything buffered. One `recv: 0` usually holds the whole
  /// first request, so the sniff costs one read and HTTP/1 serves the
  /// request from the buffer; only bytes that are still a prefix of the
  /// preface or of a ClientHello make it read again. A dead socket
  /// closes quietly.
  class sealed sniff: sock :: Socket options: config :: BuccaneerConfig alpn: alpn :: Symbol -> Symbol | Tuple =>
    self
      sniff: sock
      options: config
      buffer: (Binary fromBytes: #())
      alpn: alpn

  class sealed sniff: sock :: Socket options: config :: BuccaneerConfig buffer: buffer :: Binary alpn: alpn :: Symbol -> Symbol | Tuple =>
    read := sock recv: 0 timeout: nil
    read isError
      ifTrue: [
        read error =:= #timeout
          ifTrue: [
            ^self
              noPreface: config
              data: buffer
              alpn: alpn
          ]
        ^#close
      ]
    bytes := buffer concat: read value
    (self undecided: bytes)
      ifTrue: [
        ^self
          sniff: sock
          options: config
          buffer: bytes
          alpn: alpn
      ]
    self
      decide: bytes
      options: config
      alpn: alpn

  /// Act on bytes that are long enough to tell.
  class sealed decide: bytes :: Binary options: config :: BuccaneerConfig alpn: alpn :: Symbol -> Symbol | Tuple =>
    (bytes size >= 3 and: [self isTlsHello: (bytes part: 0 size: 3)])
      ifTrue: [
        Logger warn: "Connection that looks like TLS received on a clear channel" metadata: #{
          #domain => #(#buccaneer),
          #plug => config displayHandler
        }
        ^#close
      ]
    preface := self preface
    (self isPrefix: preface of: bytes)
      ifTrue: [
        ^self
          prefaceSeen: config
          data: (bytes part: preface size size: bytes size - preface size)
          alpn: alpn
      ]
    self
      noPreface: config
      data: bytes
      alpn: alpn

  /// The HTTP/2 connection preface (RFC 9113 §3.4).
  class sealed preface -> Binary =>
    Binary fromIolist: #("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")

  /// Whether the bytes so far could still be the preface or a
  /// ClientHello: a strict prefix of either needs another read.
  class sealed undecided: bytes :: Binary -> Boolean =>
    preface := self preface
    (bytes size < preface size and: [
      self isPrefix: bytes of: preface
    ]) or: [
      bytes size < 3 and: [
        self isPrefix: bytes of: (Binary fromBytes: #(22, 3))
      ]
    ]

  /// Whether `prefix` starts `whole`.
  class sealed isPrefix: prefix :: Binary of: whole :: Binary -> Boolean =>
    prefix size <= whole size and: [
      (whole part: 0 size: prefix size) =:= prefix
    ]

  /// `<<22, 3, 1|3>>`: a TLS ClientHello (1.3 sends legacy 0x0303).
  class sealed isTlsHello: bytes :: Binary -> Boolean =>
    bytes =:= (Binary fromBytes: #(22, 3, 1)) or: [
      bytes =:= (Binary fromBytes: #(22, 3, 3))
    ]
