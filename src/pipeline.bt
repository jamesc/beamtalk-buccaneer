/// Bandit.Pipeline: one request, shared by this engine's transports
/// (HTTP/1 now, HTTP/2 in Phase 6): read the head, build the
/// exchange, call the handler, commit the response, and map every
/// failure to a status or a close.
///
/// Answers `Result ok:` with the next transport, or `Result error:`
/// with a protocol error (HTTPError/TransportError) once its status
/// is answered. Anything else the request raises is reported (the
/// span's exception event, a log line when its status is configured,
/// a 500 unless answered) and then re-signalled, so the connection
/// crashes as in Bandit.
sealed typed Object subclass: Pipeline

  /// Run one request to completion. `transport` is this request's
  /// transport; `handler` is a block or an ExchangeHandler;
  /// `connectionSpan` is Catalina's connection span (nil in tests);
  /// `connData` is {secure?, peerAddress}; `config` is the server's
  /// BuccaneerConfig.
  class sealed runRequest: transport :: HTTPTransport handler: handler :: ExchangeHandlerLike connectionSpan: connectionSpan :: CatalinaTelemetry | Nil connData: connData :: Tuple(Boolean, Tuple | Symbol) options: config :: BuccaneerConfig -> Result(Object, Object) =>
    // A connection nobody traces skips building its spans (and their clock reads).
    traced := BuccaneerTelemetry requestsTraced
    startTime := traced ifTrue: [BuccaneerTelemetry monotonicTime] ifFalse: [0]
    base := self baseMetadata: connectionSpan handler: config
    // Only the prologue runs protected here. runInner: has its own
    // handler and re-raises internal errors, which must reach the
    // caller — not this one, which would report them twice.
    prepared := [
      {method, target, headers, transport2} := transport readHeaders
      initial := self
        buildState: transport2
        method: method
        target: target
        headers: headers
        connData: connData
        http: config http
      ex := Exchange open: (traced ifTrue: [
        initial
      ] ifFalse: [initial withTimed: false])
      meta := base at: #conn put: initial
      span := traced
        ifTrue: [
          BuccaneerTelemetry
            startSpan: #request
            measurements: #{#monotonic_time => startTime}
            metadata: meta
        ]
        ifFalse: [BuccaneerTelemetry silent]
      {ex, span, transport2, meta}
    ]
      on: Exception
      do: [:e :: Exception |
        e match: [
          h :: HTTPError -> ^self
            protocolError: h
            span: (self startOuterSpan: base startTime: startTime)
            transport: transport
            metadata: base
            options: config;
          t :: TransportError -> ^self
            protocolError: t
            span: (self startOuterSpan: base startTime: startTime)
            transport: transport
            metadata: base
            options: config;
          _ -> self
            internalError: e
            span: (self startOuterSpan: base startTime: startTime)
            transport: transport
            metadata: base
            options: config
        ]
      ]
    {ex, span, transport2, meta} := prepared
    self
      runInner: ex
      span: span
      handler: handler
      transport: transport2
      metadata: meta
      options: config

  /// A head that never parsed gets a span with no conn.
  class sealed startOuterSpan: meta :: Dictionary(Symbol, Object) startTime: start :: Integer -> BuccaneerTelemetry =>
    BuccaneerTelemetry requestsTraced ifFalse: [^BuccaneerTelemetry silent]
    BuccaneerTelemetry
      startSpan: #request
      measurements: #{#monotonic_time => start}
      metadata: meta

  /// Shared request metadata: the connection span context and the plug.
  class sealed baseMetadata: connectionSpan :: CatalinaTelemetry | Nil handler: config :: BuccaneerConfig -> Dictionary(Symbol, Object) =>
    context := connectionSpan match: [
      s :: CatalinaTelemetry -> s telemetrySpanContext;
      _ -> nil
    ]
    #{
      #connection_telemetry_span_context => context,
      #plug => config displayHandler
    }

  /// Call the handler; its answer is ignored.
  class sealed callHandler: handler :: ExchangeHandlerLike with: ex :: Exchange -> Object =>
    (handler isKindOf: Block)
      ifTrue: [
        block :: Block(Exchange, Object) := handler
        ^block value: ex
      ]
    candidate :: Object := handler
    (candidate respondsTo: #call:) ifFalse: [
      Error signal: "Invalid request handler"
    ]
    handler call: ex

  /// The inner request: call the handler, commit, forget the exchange,
  /// stop the span. Errors here all know their conn.
  class sealed runInner: ex :: Exchange span: span :: BuccaneerTelemetry handler: handler :: ExchangeHandlerLike transport: transport :: HTTPTransport metadata: meta :: Dictionary(Symbol, Object) options: config :: BuccaneerConfig -> Result(Object, Object) =>
    [
      self callHandler: handler with: ex
      // One load for the common case: a response already sent needs no
      // commit, and finishing reuses the state just loaded.
      answered := ex load
      answered respState =:= #upgraded
        ifTrue: [
          ^self
            upgrade: ex
            span: span
            transport: transport
            metadata: meta
            options: config
        ]
      final := answered respState =:= #sent
        ifTrue: [answered]
        ifFalse: [
          ex commit
          ex load
        ]
      done := ex finish: final
      span enabled ifTrue: [
        span stopWith: (self metricsFrom: final) metadata: (meta at: #conn put: final)
      ]
      Result ok: done
    ]
      on: Exception
      do: [:e :: Exception |
        // Success forgets via finish; errors forget here, so a failed
        // request leaves no state behind.
        ex forget
        e match: [
          h :: HTTPError -> self
            protocolError: h
            span: span
            transport: transport
            metadata: meta
            options: config;
          t :: TransportError -> self
            protocolError: t
            span: span
            transport: transport
            metadata: meta
            options: config;
          _ -> self
            internalError: e
            span: span
            transport: transport
            metadata: meta
            options: config
        ]
      ]

  /// The handler asked to switch to WebSocket: validate the request,
  /// send 101, stop the request span, forget the exchange, and answer
  /// the WebSocketProtocol for the connection to continue with (Plug's
  /// maybe_upgrade!, after the handler returns). A failed validation
  /// raises an HTTPError, which the surrounding handler turns into a
  /// 400 exactly like a malformed request.
  class sealed upgrade: ex :: Exchange span: span :: BuccaneerTelemetry transport: _transport :: HTTPTransport metadata: meta :: Dictionary(Symbol, Object) options: config :: BuccaneerConfig -> Result(Object, Object) =>
    (config websocket at: #enabled ifAbsent: [
      true
    ]) =:= false ifTrue: [
      Error signal: "upgrade to websocket not supported by Buccaneer"
    ]
    st := ex load
    result := Handshake
      run: ex
      config: config
      options: st websocketOptions
    result isError ifTrue: [HTTPError signal: result error reason: 400]
    {compress, _params} := result value
    final := ex load
    span stopWith: (self metricsFrom: final) metadata: (meta at: #conn put: final)
    buffer := final transport buffer
    ex forget
    wsSpan := BuccaneerTelemetry
      startSpan: #websocket
      measurements: #{
        #monotonic_time => BuccaneerTelemetry monotonicTime,
        #compress => compress notNil
      }
      metadata: (meta at: #websock put: st websock)
    ws := config websocket
    connection := WebSocketConnection
      websock: st websock
      websockState: st websockState
      connState: #open
      compress: compress
      fragmentFrame: nil
      fragmentChunks: #()
      fragmentSize: 0
      validateTextFrames: (ws at: #validateTextFrames ifAbsent: [true])
      maxFragmentedMessageSize: (ws at: #maxFragmentedMessageSize ifAbsent: [
        8000000
      ])
      logErrors: ((ws at: #logProtocolErrors ifAbsent: [
        true
      ]) =:= false ifTrue: [false] ifFalse: [true])
      span: wsSpan
      metrics: Dictionary new
    protocol := WebSocketProtocol
      config: config
      connection: connection
      extractor: (FrameExtractor new withMaxFrameSize: (ws at: #maxFrameSize ifAbsent: [
        8000000
      ]))
      buffer: buffer
      started: false
      timeoutMs: (st websocketOptions at: #timeout ifAbsent: [nil])
    Result ok: protocol

  /// A malformed request or a socket failure: stop the span with the
  /// error, log per the #http section, answer the error status unless
  /// answered, and ask the handler to close.
  class sealed protocolError: error :: Exception span: span :: BuccaneerTelemetry transport: transport :: HTTPTransport metadata: meta :: Dictionary(Symbol, Object) options: config :: BuccaneerConfig -> Result(HTTPTransport, Object) =>
    span stopWith: #{} metadata: (meta at: #error put: error message)
    BuccaneerLogger
      maybeLogProtocolError: error
      stacktrace: error stackTrace
      options: config http
      metadata: meta
    transport sendOnError: error
    Result error: error

  /// Anything else: the span's exception event, a log line when 500 is
  /// configured, a 500 unless answered — then re-signal, so the
  /// connection crashes as in Bandit.
  class sealed internalError: error :: Exception span: span :: BuccaneerTelemetry transport: transport :: HTTPTransport metadata: meta :: Dictionary(Symbol, Object) options: config :: BuccaneerConfig -> Never =>
    kind := (error isKindOf: ExitError) ifTrue: [
      #exit
    ] ifFalse: [(error isKindOf: ThrowError) ifTrue: [#throw] ifFalse: [#error]]
    span
      exceptionKind: kind
      reason: error
      stacktrace: error stackTrace
    (self logStatus: 500 options: config)
      ifTrue: [
        Logger
          error: (BuccaneerLogger banner: error stacktrace: error stackTrace)
          metadata: (BuccaneerLogger
            loggerMetadataFor: kind
            reason: error
            stacktrace: error stackTrace
            metadata: meta)
      ]
    transport sendOnError: error
    error pass

  /// Whether #logExceptionsWithStatusCodes (default 500-599) covers a
  /// status: an Integer, a List, or anything answering includes:.
  class sealed logStatus: status :: Integer options: config :: BuccaneerConfig -> Boolean =>
    raw := config http at: #logExceptionsWithStatusCodes ifAbsent: [nil]
    raw isNil ifTrue: [^status between: 500 and: 599]
    (raw isKindOf: Integer) ifTrue: [^status =:= raw]
    (raw isKindOf: List) ifTrue: [^raw includes: status]
    (raw respondsTo: #includes:) ifTrue: [^raw includes: status]
    Error signal: "Invalid value for #logExceptionsWithStatusCodes"

  /// The stop measurements for a served request: the stamps and byte
  /// counts the request reached, as the adapter's metrics.
  class sealed metricsFrom: st :: ExchangeState -> Dictionary(Symbol, Object) =>
    out :: Dictionary(Symbol, Object) := #{
      #req_header_end_time => st reqHeaderEndTime
    }
    st reqBodyStartTime isNil
      ifFalse: [
        out := (out at: #req_body_start_time put: st reqBodyStartTime) at: #req_body_bytes put: st reqBodyBytes
        st reqBodyEndTime isNil ifFalse: [
          out := out at: #req_body_end_time put: st reqBodyEndTime
        ]
      ]
    st respStartTime isNil
      ifFalse: [
        out := (out at: #resp_start_time put: st respStartTime) at: #resp_body_bytes put: st respBodyBytes
        st respEndTime isNil ifFalse: [
          out := out at: #resp_end_time put: st respEndTime
        ]
      ]
    st respCompressionMethod isNil
      ifFalse: [
        out := (out at: #resp_compression_method put: st respCompressionMethod) at: #resp_uncompressed_body_bytes put: st respUncompressedBodyBytes
      ]
    out

  /// The exchange state for a parsed head (Bandit's build_conn!, minus
  /// the conn, plus the adapter's negotiated content encoding).
  class sealed buildState: transport :: HTTPTransport method: method :: String target: target :: Tuple headers: headers :: HttpHeaders connData: connData :: Tuple(Boolean, Tuple | Symbol) http: http :: HttpOptions -> ExchangeState =>
    {secure, _} := connData
    scheme := secure =:= true ifTrue: [#https] ifFalse: [#http]
    {host, port} := self
      hostAndPort: scheme
      version: transport version
      target: target
      headers: headers
    {path, query} := self pathAndQuery: target
    ExchangeState
      new: #{
        #transport => transport,
        #method => method,
        #scheme => scheme,
        #host => host,
        #port => port,
        #path => path,
        #query => query,
        #headers => headers,
        #expectContinue => self expectsContinue: headers version: transport version,
        #httpOptions => http,
        #contentEncoding => Compression negotiate: (Headers getHeader: headers name: "accept-encoding") options: http
      }

  /// Whether the client waits for `100 Continue` (Bandit's expect_continue?).
  /// Exact match only, as in Bandit: extra tokens or whitespace mean no
  /// auto-100 (and therefore no unhonored-expect close either).
  class sealed expectsContinue: headers :: HttpHeaders version: ver :: HttpVersion -> Boolean =>
    (ver =:= #http11 or: [ver =:= #http2]) ifFalse: [^false]
    // HTTP/2 request values stay Binary (HPACK decodes opaque); HTTP/1
    // parses them to String. Accept both spellings of 100-continue.
    text := Headers text: (Headers getHeader: headers name: "expect")
    text isNil ifTrue: [^false]
    text asciiLowercase =:= "100-continue"

  /// {host, port} from an absolute target, else the Host header
  /// (Bandit's determine_host_and_port!).
  class sealed hostAndPort: scheme :: Scheme version: ver :: HttpVersion target: target :: Tuple headers: headers :: HttpHeaders -> Tuple(String, Integer) =>
    host := target at: 2
    port := target at: 3
    (host isNil and: [port isNil])
      ifFalse: [
        ^self
          absoluteHost: host
          port: port
          scheme: scheme
      ]
    found := Headers getHostHeader: headers
    found isError
      ifTrue: [
        reason := found error match: [
          s :: String -> s;
          _ -> found error printString
        ]
        HTTPError signal: "Unable to obtain host and port: " ++ reason
      ]
    header := found value
    header isNil
      ifTrue: [
        ver =:= #http10 ifTrue: [^{"", self defaultPortFor: scheme}]
        HTTPError signal: "Unable to obtain host and port: No host header"
      ]
      ifFalse: [
        {h, p} := Headers parseHostlikeHeader: header
        ^{h, p ifNil: [self defaultPortFor: scheme]}
      ]

  /// {host, port} from an absolute target's authority. A non-String
  /// host is rejected: Bandit passes opaque bytes through, but the
  /// state's host is a String. Authority ports arrive as strings
  /// (CONNECT) and are parsed; absolute-form ports arrive parsed.
  class sealed absoluteHost: host :: Object port: port :: Object scheme: scheme :: Scheme -> Tuple(String, Integer) =>
    h := host match: [
      s :: String -> s;
      _ -> HTTPError signal: "Unable to obtain host and port: invalid host"
    ]
    p := port isNil
      ifTrue: [self defaultPortFor: scheme]
      ifFalse: [
        port match: [
          n :: Integer -> n;
          s :: String -> Headers parsePort: s;
          _ -> HTTPError signal: "Header contains invalid port"
        ]
      ]
    {h, p}

  /// {path, query} from a target, without the fragment.
  class sealed pathAndQuery: target :: Tuple -> Tuple(String, String | Nil) =>
    raw := target at: 4
    raw isNil ifTrue: [^{"", nil}]
    (raw isKindOf: Symbol) ifTrue: [^{"*", nil}]
    self splitPath: raw

  /// Split a path into {path, query} on the first "?".
  class sealed splitPath: path :: Object -> Tuple(String, String | Nil) =>
    text := path match: [
      s :: String -> s;
      _ -> HTTPError signal: "Unsupported request target (RFC9112§3.2)"
    ]
    noFragment := (text split: "#") first
    q := noFragment indexOf: "?"
    q isNil ifTrue: [^{noFragment, nil}]
    {(noFragment take: q - 1), (noFragment drop: q)}

  class sealed defaultPortFor: scheme :: Scheme -> Integer =>
    scheme =:= #https ifTrue: [^443]
    80
