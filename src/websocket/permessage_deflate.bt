/// Bandit.WebSocket.PerMessageDeflate: RFC7692 permessage-deflate over
/// `zlib` FFI. The Value holds both zlib streams plus the negotiated
/// parameters (RFC7692§7).
///
/// `negotiate:options:` picks the first well-formed permessage-deflate
/// offer; `inflate:with:` / `deflate:with:` answer `Result ok:` with the
/// bytes or `Result error:` with #too_much_inflation, :no_compress or the
/// zlib failure. The streams never change, so unlike Bandit the context
/// is not threaded back: no-takeover resets happen inside.
sealed typed Value subclass: PermessageDeflate
  field: serverNoContextTakeover :: Boolean = false
  field: clientNoContextTakeover :: Boolean = false
  field: serverMaxWindowBits :: Integer = 15
  field: clientMaxWindowBits :: Integer = 15
  field: inflateStream :: Object = nil
  field: deflateStream :: Object = nil
  field: maxInflateRatio :: Integer = 25

  /// The offer parameter names, as sent on the wire.
  class sealed validParams -> List(String) =>
    #("server_no_context_takeover", "client_no_context_takeover", "server_max_window_bits", "client_max_window_bits", "max_inflate_ratio")

  /// Negotiate the first acceptable permessage-deflate offer in
  /// `extensions` ({name, params} pairs), trying each offer in turn
  /// (Bandit's find_value). Answers {instance|nil, resolved} where
  /// resolved is the accepted parameter list for the response header.
  class sealed negotiate: extensions :: List options: opts :: Dictionary -> Tuple(Object, List) =>
    extensions
      do: [:each :: Tuple |
        {name, params} := each
        (name =:= "permessage-deflate" and: [params isKindOf: List])
          ifTrue: [
            result := self negotiateParams: params options: opts
            (result at: 1) notNil ifTrue: [^result]
          ]
      ]
    {nil, #()}

  class sealed negotiateParams: params :: List options: opts :: Dictionary -> Tuple(Object, List) =>
    normalized := params collect: [:p :: Tuple | self normalize: p]
    (self valid: normalized) ifFalse: [^{nil, #()}]
    serverBits := (self at: normalized name: "server_max_window_bits") match: [
      n :: Integer -> n;
      _ -> 15
    ]
    clientBits := (self at: normalized name: "client_max_window_bits") match: [
      n :: Integer -> n;
      _ -> 15
    ]
    {(self
      open: normalized
      serverBits: serverBits
      clientBits: clientBits
      options: opts), normalized}

  class sealed normalize: param :: Tuple -> Tuple =>
    {name, value} := param
    name =:= "server_max_window_bits" ifTrue: [^{name, (self parseBits: value)}]
    name =:= "client_max_window_bits"
      ifTrue: [
        value =:= true ifTrue: [^{name, 15}]
        ^{name, (self parseBits: value)}
      ]
    param

  class sealed parseBits: value :: Object -> Object =>
    value match: [
      n :: Integer -> value;
      s :: String -> self intOr: value string: s;
      _ -> value
    ]

  /// A cleanly parsed integer for a numeric offer, else the fallback
  /// (callers then reject the offer through valid:).
  class sealed intOr: fallback :: Object string: s :: String -> Object =>
    parsed := Headers parseInteger: s
    parsed isError ifTrue: [^fallback]
    parts := parsed unwrap
    (parts at: 2) =:= "" ifTrue: [^(parts at: 1)]
    fallback

  /// No unknown params, no repeats, and every value in range (Bandit
  /// checks the four deflate params; a ratio, when offered, must be a
  /// positive integer or parse to one).
  class sealed valid: params :: List -> Boolean =>
    names := params collect: [:p :: Tuple | p at: 1]
    names do: [:n | (self validParams includes: n) ifFalse: [^false]]
    names size =:= (self deduped: names) size ifFalse: [^false]
    serverTakeover := self at: params name: "server_no_context_takeover"
    (serverTakeover isNil or: [serverTakeover =:= true]) ifFalse: [^false]
    clientTakeover := self at: params name: "client_no_context_takeover"
    (clientTakeover isNil or: [clientTakeover =:= true]) ifFalse: [^false]
    serverBits := self at: params name: "server_max_window_bits"
    (serverBits isNil or: [
      (serverBits isKindOf: Integer) and: [serverBits between: 8 and: 15]
    ]) ifFalse: [^false]
    clientBits := self at: params name: "client_max_window_bits"
    (clientBits isNil or: [
      (clientBits isKindOf: Integer) and: [clientBits between: 8 and: 15]
    ]) ifFalse: [^false]
    ratio := self at: params name: "max_inflate_ratio"
    ratio isNil ifTrue: [^true]
    (self ratioOf: params) isNil ifTrue: [^false]
    true

  /// The offered max_inflate_ratio as an Integer, or nil when absent
  /// or unusable (Bandit accepts anything here and fails at inflate
  /// time; rejecting the offer then is the same wire outcome).
  class sealed ratioOf: params :: List -> Integer | Nil =>
    value := self at: params name: "max_inflate_ratio"
    value isNil ifTrue: [^nil]
    value match: [
      n :: Integer -> n > 0 ifTrue: [^n] ifFalse: [^nil];
      s :: String -> self positiveIntOrNil: s;
      _ -> nil
    ]

  class sealed positiveIntOrNil: s :: String -> Integer | Nil =>
    (self intOr: nil string: s) match: [
      n :: Integer -> n > 0 ifTrue: [^n] ifFalse: [^nil];
      _ -> nil
    ]

  class sealed at: params :: List name: key :: String -> Object =>
    params do: [:p :: Tuple | (p at: 1) =:= key ifTrue: [^(p at: 2)]]
    nil

  class sealed deduped: names :: List -> List =>
    seen := Dictionary new
    names do: [:n :: Object | seen := seen at: n put: true]
    seen keys

  /// Open both zlib streams for the resolved params.
  class sealed open: resolved :: List serverBits: serverBits :: Integer clientBits: clientBits :: Integer options: opts :: Dictionary -> PermessageDeflate =>
    instance := PermessageDeflate new
    instance := (instance withServerMaxWindowBits: serverBits) withClientMaxWindowBits: clientBits
    instance := instance withServerNoContextTakeover: ((self at: resolved name: "server_no_context_takeover") =:= true)
    instance := instance withClientNoContextTakeover: ((self at: resolved name: "client_no_context_takeover") =:= true)
    ratio := (self ratioOf: resolved) match: [
      n :: Integer -> n;
      _ -> opts at: #maxInflateRatio ifAbsent: [25]
    ]
    instance := instance withMaxInflateRatio: ratio
    inflateStream := (Erlang zlib) open
    (Erlang zlib) inflateInit: inflateStream with: (self windowBits: clientBits)
    deflateStream := (Erlang zlib) open
    (Erlang zlib)
      deflateInit: deflateStream
      level: (opts at: #level ifAbsent: [#default])
      method: #deflated
      windowbits: (self windowBits: serverBits)
      memlevel: (opts at: #memLevel ifAbsent: [8])
      strategy: (opts at: #strategy ifAbsent: [#default])
    ((instance withInflateStream: inflateStream) withDeflateStream: deflateStream)

  /// zlib takes -N for raw deflate; -8 is rejected, so it becomes -9.
  class sealed windowBits: bits :: Integer -> Integer =>
    bits =:= 8 ifTrue: [^-9]
    bits negated

  /// Inflate one message, appending the RFC7692 trailer first. Answers
  /// `Result ok:` with the bytes, `Result error:` #too_much_inflation
  /// past maxInflateRatio, or the zlib failure.
  class sealed inflate: data :: Binary with: deflate :: PermessageDeflate | Nil -> Result(Binary, Object) =>
    deflate isNil ifTrue: [^Result error: #no_compress]
    full := data concat: (Binary fromBytes: #(0, 0, 255, 255))
    outcome := Result
      tryDo: [
        self
          doInflate: full
          stream: deflate inflateStream
          budget: data size * deflate maxInflateRatio
      ]
    outcome isError
      ifTrue: [
        reason := outcome error message
        ^Result
          error: (reason =:= "too_much_inflation" ifTrue: [
            #too_much_inflation
          ] ifFalse: [reason])
      ]
    inflated := Binary fromIolist: outcome value
    deflate clientNoContextTakeover ifTrue: [
      (Erlang zlib) inflateReset: deflate inflateStream
    ]
    Result ok: inflated

  /// One safeInflate round; recurses on empty input while the ratio
  /// budget lasts. Raises too_much_inflation past it.
  class sealed doInflate: data :: Binary stream: stream :: Object budget: budget :: Integer -> List =>
    ((Erlang zlib) safeInflate: stream with: data) match: [
      {#continue, out} -> self
        continueInflate: out
        stream: stream
        budget: budget;
      {#finished, out} -> #(out)
    ]

  class sealed continueInflate: out :: Object stream: stream :: Object budget: budget :: Integer -> List =>
    remaining := budget - ((Erlang erlang) iolist_size: out)
    remaining > 0 ifFalse: [Error signal: "too_much_inflation"]
    (self
      doInflate: (Binary fromBytes: #())
      stream: stream
      budget: remaining) addFirst: out

  /// Deflate one message with a sync flush, stripping the RFC7692
  /// trailer. Answers `Result ok:` with the bytes or the zlib failure.
  class sealed deflate: data :: Object with: deflate :: PermessageDeflate | Nil -> Result(Binary, Object) =>
    deflate isNil ifTrue: [^Result error: #no_compress]
    outcome := Result
      tryDo: [
        (Erlang zlib)
          deflate: deflate deflateStream
          with: data
          with: #sync
      ]
    outcome isError ifTrue: [^Result error: outcome error message]
    full := Binary fromIolist: outcome value
    size := full size
    stripped := (size >= 4 and: [
      (full part: (size - 4) size: 4) =:= (Binary fromBytes: #(0, 0, 255, 255))
    ]) ifTrue: [full part: 0 size: size - 4] ifFalse: [full]
    deflate serverNoContextTakeover ifTrue: [
      (Erlang zlib) deflateReset: deflate deflateStream
    ]
    Result ok: stripped

  class sealed close: deflate :: PermessageDeflate | Nil -> Nil =>
    deflate isNil ifTrue: [^nil]
    (Erlang zlib) close: deflate inflateStream
    (Erlang zlib) close: deflate deflateStream
    nil
