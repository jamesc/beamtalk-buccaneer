/// Bandit.WebSocket.Socket over Catalina: send one frame, or close the
/// connection with a close frame and a write shutdown. Sends never mask
/// (server to client); errors are answered, never raised, so close
/// paths can ignore a dead peer.
typed Object subclass: WebSocketSocket

  /// Send one outgoing frame. `type` is #text | #binary | #ping | #pong.
  class sealed sendFrame: socket :: Socket type: type :: Symbol data: data :: Binary compressed: compressed :: Boolean -> Result(Nil, Object) =>
    frame := type match: [
      #text -> ((TextFrame new withFin: true) withCompressed: compressed) withData: data;
      #binary -> ((BinaryFrame new withFin: true) withCompressed: compressed) withData: data;
      #ping -> PingFrame new withData: data;
      _ -> PongFrame new withData: data
    ]
    socket send: (Frame serialize: frame)

  /// Send the close frame, then shut the socket down for writing.
  /// A code alone sends no reason (Bandit's close with an integer).
  class sealed close: socket :: Socket code: code :: Integer -> Result(Nil, Object) =>
    self close: socket code: code reason: ""

  /// Send the close frame with a reason, then shut down for writing
  /// (Bandit's close with {code, detail}).
  class sealed close: socket :: Socket code: code :: Integer reason: reason :: Binary -> Result(Nil, Object) =>
    frame := (ConnectionCloseFrame new withCode: code) withReason: reason
    (socket send: (Frame serialize: frame)) isError ifTrue: [^Result error: #closed]
    socket shutdown: #write
