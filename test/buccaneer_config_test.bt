TestCase subclass: BuccaneerConfigTest

  assertRaises: block message: expected =>
    caught := false
    [block value]
      on: Error
      do: [:e |
        caught := true
        self assert: e message equals: expected
      ]
    self assert: caught

  assertRaisesMatching: block message: expected =>
    caught := false
    [block value]
      on: Error
      do: [:e |
        caught := true
        self assert: (e message includesSubstring: expected)
      ]
    self assert: caught

  handlerBlock => [:ex | nil]

  testDocumentedExample =>
    config := BuccaneerConfig from: #{
      #handler => [:ex | nil],
      #port => 4001,
      #http1 => #{#maxRequests => 100}
    }
    self assert: config port equals: 4001
    self assert: (config http1 at: #maxRequests) equals: 100

  testRequiresHandler =>
    self assertRaises: [
      BuccaneerConfig from: Dictionary new
    ] message: "A value is required for #handler"

  testRejectsBadHandler =>
    self assertRaises: [
      BuccaneerConfig from: #{#handler => 42}
    ] message: "Invalid value for #handler"

  testAcceptsBlockAndValueHandlers =>
    config := BuccaneerConfig from: #{#handler => self handlerBlock}
    self assert: (config handler isKindOf: Block)
    valueConfig := BuccaneerConfig from: #{#handler => CallHandler new}
    self assert: (valueConfig handler isKindOf: CallHandler)

  testRejectsActorHandler =>
    actor := OtherProcess spawn
    self assertRaises: [
      BuccaneerConfig from: #{#handler => actor}
    ] message: "Invalid value for #handler: must not be an Actor"
    actor stop

  testRejectsBadLoggingOptions =>
    self
      assertRaises: [
        BuccaneerConfig from: #{
          #handler => self handlerBlock,
          #http => #{#logProtocolErrors => #always}
        }
      ]
      message: "Invalid value for #logProtocolErrors"
    self
      assertRaises: [
        BuccaneerConfig from: #{
          #handler => self handlerBlock,
          #http => #{#logClientClosures => 42}
        }
      ]
      message: "Invalid value for #logClientClosures"
    self
      assertRaises: [
        BuccaneerConfig
          from: #{
            #handler => self handlerBlock,
            #http => #{#logExceptionsWithStatusCodes => #always}
          }
      ]
      message: "Invalid value for #logExceptionsWithStatusCodes"

  testRejectsBadCompressionOptions =>
    #(#{
      #compress => #yes
    }, #{
      #responseEncodings => "gzip"
    }, #{
      #responseEncodings => #(#gzip)
    }, #{#deflateOptions => #(#level)}, #{#zstdOptions => 3})
      do: [:http |
        self assertRaises: [
          BuccaneerConfig from: #{#handler => self handlerBlock, #http => http}
        ] message: "Invalid value for #" ++ http keys first asString
      ]

  testAcceptsCompressionOptions =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #http => #{
          #compress => false,
          #responseEncodings => #("gzip"),
          #deflateOptions => #{#level => 0},
          #zstdOptions => #{#checksumFlag => true}
        }
      }
    self assert: (config http at: #compress) equals: false
    self assert: (config http at: #responseEncodings) equals: #("gzip")

  testAcceptsLoggingOptions =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #http => #{
          #logProtocolErrors => false,
          #logClientClosures => #verbose,
          #logExceptionsWithStatusCodes => #(500)
        }
      }
    self assert: (config http at: #logProtocolErrors) equals: false
    self assert: (config http at: #logClientClosures) equals: #verbose
    self assert: (config http at: #logExceptionsWithStatusCodes) equals: #(500)

  testDefaults =>
    config := BuccaneerConfig from: #{#handler => self handlerBlock}
    self assert: config scheme equals: #http
    self assert: config port equals: 4000
    self assert: config startupLog equals: #info
    self assert: (config displayHandler isKindOf: Block)
    self assert: config http isEmpty
    self assert: config http1 isEmpty
    self assert: config http2 isEmpty
    self assert: config websocket isEmpty
    self assert: (config catalina at: #port) equals: 4000

  testDisplayHandlerExplicit =>
    config := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #displayHandler => #mine
    }
    self assert: config displayHandler equals: #mine

  testHttpsDefaultPort =>
    config := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #scheme => #https
    }
    self assert: config port equals: 4040

  testPortString =>
    config := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #port => "4001"
    }
    self assert: config port equals: 4001

  testBadPort =>
    #("abc", "12x", "")
      do: [:port |
        self assertRaises: [
          BuccaneerConfig from: #{#handler => self handlerBlock, #port => port}
        ] message: "Invalid value for #port"
      ]

  testBadScheme =>
    self assertRaises: [
      BuccaneerConfig from: #{#handler => self handlerBlock, #scheme => #ftp}
    ] message: "Invalid value for #scheme"

  testUnknownTopKey =>
    self assertRaisesMatching: [
      BuccaneerConfig from: #{#handler => self handlerBlock, #bogus => 1}
    ] message: "top level"
    self assertRaisesMatching: [
      BuccaneerConfig from: #{#handler => self handlerBlock, #bogus => 1}
    ] message: "bogus"

  testUnknownSectionKey =>
    self
      assertRaisesMatching: [
        BuccaneerConfig from: #{
          #handler => self handlerBlock,
          #http1 => #{#bogus => 1}
        }
      ]
      message: "http1"
    self
      assertRaisesMatching: [
        BuccaneerConfig from: #{
          #handler => self handlerBlock,
          #http1 => #{#bogus => 1}
        }
      ]
      message: "bogus"

  testUnknownCatalinaKey =>
    self
      assertRaisesMatching: [
        BuccaneerConfig from: #{
          #handler => self handlerBlock,
          #catalina => #{#bogus => 1}
        }
      ]
      message: "catalina"
    self
      assertRaisesMatching: [
        BuccaneerConfig from: #{
          #handler => self handlerBlock,
          #catalina => #{#bogus => 1}
        }
      ]
      message: "bogus"

  testNonDictSection =>
    self assertRaises: [
      BuccaneerConfig from: #{#handler => self handlerBlock, #http => #()}
    ] message: "Invalid config for section: http"

  testInetFolding =>
    config := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #inet => true
    }
    trans :: Dictionary := config catalina at: #transportOptions
    self assert: (trans at: #inet) equals: true

  testBadInet =>
    self assertRaises: [
      BuccaneerConfig from: #{#handler => self handlerBlock, #inet => "yes"}
    ] message: "Invalid value for #inet"

  testIpFolding =>
    config := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #ip => #loopback
    }
    trans :: Dictionary := config catalina at: #transportOptions
    self assert: (trans at: #ip) equals: #loopback

  testHttpsConveniences =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #scheme => #https,
        #keyfile => "k",
        #certfile => "c"
      }
    trans :: Dictionary := config catalina at: #transportOptions
    self assert: (trans at: #keyfile) equals: "k"
    self assert: (trans at: #certfile) equals: "c"
    plain := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #keyfile => "k"
    }
    self deny: (plain catalina includesKey: #transportOptions)

  testPortPutNew =>
    config := BuccaneerConfig from: #{
      #handler => self handlerBlock,
      #port => 4000,
      #catalina => #{#port => 5000}
    }
    self assert: (config catalina at: #port) equals: 5000
    self assert: config port equals: 4000

  testListTransportOptions =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #ip => #loopback,
        #catalina => #{#transportOptions => #(#inet6)}
      }
    trans :: List := config catalina at: #transportOptions
    self assert: (trans includes: #inet6)
    self assert: (trans includes: {#ip, #loopback})

  testBadTransportOptions =>
    self
      assertRaises: [
        BuccaneerConfig
          from: #{
            #handler => self handlerBlock,
            #ip => #loopback,
            #catalina => #{#transportOptions => 42}
          }
      ]
      message: "Invalid #transportOptions in #catalina config"

  testHttpsSelectsSslTransport =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #scheme => #https,
        #certfile => "c.pem",
        #keyfile => "k.pem"
      }
    self assert: ((config catalina at: #transport) =:= SSLTransport)

  testHttpKeepsTcpTransport =>
    config := BuccaneerConfig from: #{#handler => self handlerBlock}
    self assert: ((config catalina at: #transport ifAbsent: [nil]) isNil)

  testExplicitTransportWinsOverScheme =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #scheme => #https,
        #certfile => "c.pem",
        #keyfile => "k.pem",
        #catalina => #{#transport => TCPTransport}
      }
    self assert: ((config catalina at: #transport) =:= TCPTransport)

  assertBadWebSocket: key :: Symbol value: value =>
    self
      assertRaises: [
        BuccaneerConfig
          from: #{
            #handler => self handlerBlock,
            #websocket => (Dictionary new at: key put: value)
          }
      ]
      message: ("Invalid value for #" ++ key asString)

  assertBadUpgrade: key :: Symbol value: value =>
    self assertRaises: [
      BuccaneerConfig checkUpgradeOptions: (Dictionary new at: key put: value)
    ] message: ("Invalid value for #" ++ key asString)

  /// BT-4349: #websocket values are type-checked at start.
  testRejectsMistypedWebSocketValues =>
    self assertBadWebSocket: #maxFrameSize value: "8000000"
    self assertBadWebSocket: #maxFrameSize value: 0
    self assertBadWebSocket: #maxFragmentedMessageSize value: "big"
    self assertBadWebSocket: #maxInflateRatio value: 2.5
    self assertBadWebSocket: #compress value: "true"
    self assertBadWebSocket: #validateTextFrames value: nil
    self assertBadWebSocket: #enabled value: 1
    self assertBadWebSocket: #deflateOptions value: #(#level, 1)

  testAcceptsWebSocketValues =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #websocket => #{
          #maxFrameSize => 1000,
          #maxFragmentedMessageSize => 2000,
          #maxInflateRatio => 10,
          #compress => true,
          #validateTextFrames => false,
          #enabled => true,
          #deflateOptions => #{#level => 1}
        }
      }
    self assert: (config websocket at: #maxFrameSize) equals: 1000

  /// BT-4736: the keys the shapes declare, reserved ones included, are
  /// accepted by the key validators.
  testAcceptsEveryShapeKey =>
    config := BuccaneerConfig
      from: #{
        #handler => self handlerBlock,
        #http => #{
          #logProtocolErrors => #verbose,
          #logClientClosures => #short,
          #logExceptionsWithStatusCodes => 500,
          #compress => false,
          #responseEncodings => #("gzip"),
          #deflateOptions => #{#level => 1},
          #zstdOptions => #{}
        },
        #http1 => #{
          #enabled => true,
          #maxRequests => 10,
          #maxRequestLineLength => 100,
          #maxHeaderLength => 100,
          #maxHeaderCount => 5,
          #gcEveryNKeepaliveRequests => 5,
          #logUnknownMessages => false,
          #clearProcessDict => true
        },
        #http2 => #{
          #enabled => true,
          #maxHeaderBlockSize => 1000,
          #maxRequests => 10,
          #maxResetStreamRate => {500, 10000},
          #sendfileChunkSize => 1000,
          #defaultLocalSettings => #{},
          #logStreamErrors => #short
        },
        #websocket => #{
          #primitiveOpsModule => nil,
          #logProtocolErrors => #verbose
        },
        #catalina => #{#numAcceptors => 10, #readTimeout => #infinity}
      }
    self assert: (config http1 at: #maxRequests) equals: 10
    self assert: (config http2 at: #maxHeaderBlockSize) equals: 1000
    self assert: (config catalina at: #numAcceptors) equals: 10

  testAcceptsUpgradeOptions =>
    self assert: (BuccaneerConfig checkUpgradeOptions: #{}) isNil
    self
      assert: (BuccaneerConfig
        checkUpgradeOptions: #{
          #timeout => 100,
          #compress => false,
          #maxInflateRatio => 5,
          #level => #best_speed,
          #memLevel => 9,
          #strategy => #rle
        }) isNil
    self assert: (BuccaneerConfig checkUpgradeOptions: #{
      #timeout => nil,
      #level => 0
    }) isNil

  testRejectsUnknownUpgradeOption =>
    self assertRaisesMatching: [
      BuccaneerConfig checkUpgradeOptions: #{#maxFrameSize => 10}
    ] message: "Unsupported key(s) in websocket upgrade config"

  testRejectsMistypedUpgradeOptions =>
    self assertBadUpgrade: #timeout value: -1
    self assertBadUpgrade: #timeout value: "100"
    self assertBadUpgrade: #compress value: nil
    self assertBadUpgrade: #maxInflateRatio value: "5"
    self assertBadUpgrade: #level value: 10
    self assertBadUpgrade: #level value: #fast
    self assertBadUpgrade: #memLevel value: 0
    self assertBadUpgrade: #strategy value: #huffman
