TestCase subclass: ClockTest

  // Bandit's clock_test asserts the logged warning on a cache miss; there
  // is no log capture in BUnit, so these tests assert the miss behaviour
  // (a fresh valid date) rather than the warning itself.
  // The table may belong to the updater a miss started; only its owner
  // can delete it, and then the next miss starts a new one.
  tearDown =>
    (Ets exists: Clock tableName) ifTrue: [
      [(Ets named: Clock tableName) delete] on: Error do: [:e | nil]
    ]
    self

  testComputeDateHeaderFormat =>
    date := Clock computeDateHeader
    // No {n} quantifiers: braces interpolate in string literals.
    self assert: (date matchesRegex: "^[A-Z][a-z][a-z], [0-9][0-9] [A-Z][a-z][a-z] [0-9][0-9][0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] GMT$" options: #())

  testDayNamesMatchWeekday =>
    // 2026-10-25 is a Sunday.
    sunday := DateTime
      year: 2026
      month: 10
      day: 25
    self assert: (Clock dayNames at: sunday weekday) equals: "Sun"

  testDateHeaderMissComputesFresh =>
    header := Clock dateHeader
    self assert: (header at: 1) equals: "date"
    self assert: ((header at: 2) matchesRegex: "GMT$" options: #())

  // An updater started by an earlier test (or by a server in the same
  // node) can survive tearDown, which only its owner may delete, and it
  // overwrites the cache once a second. If that tick lands between the
  // put and the read, the read sees the real date. Retry a few times: the
  // updater writes once a second, so it cannot hit every attempt.
  testDateHeaderHitReturnsCached =>
    planted := "Wed, 21 Oct 2015 07:28:00 GMT"
    header := nil
    hit := false
    5
      timesRepeat: [
        hit
          ifFalse: [
            (Ets newOrExisting: Clock tableName type: #set) at: Clock cacheKey put: planted
            header := Clock dateHeader
            hit := (header at: 2) =:= planted
          ]
      ]
    self assert: (header at: 1) equals: "date"
    self assert: (header at: 2) equals: planted

  testMissStartsTheUpdater =>
    Clock dateHeader
    filled := false
    50
      timesRepeat: [
        filled ifFalse: [
          Clock cachedDate isNil ifTrue: [
            Timer sleep: 20
          ] ifFalse: [filled := true]
        ]
      ]
    self assert: filled
    self assert: (Clock cachedDate matchesRegex: "GMT$" options: #())

  testUpdateCacheStoresFreshDate =>
    date := Clock updateCache
    self assert: (date matchesRegex: "GMT$" options: #())
    self assert: Clock cachedDate equals: date
