/// Exchange (Bandit.Adapter) over loopback sockets. Bandit tests the
/// adapter through the whole server (http1/plug_test.exs); these are the
/// unit-level cases, and the plug_test ports arrive with the pipeline.
TestCase subclass: ExchangeTest

  // A fresh date in the cache, so sendResp: does not warn on every call.
  setUp =>
    Clock updateCache
    self

  tearDown =>
    (Ets exists: Clock tableName) ifTrue: [(Ets named: Clock tableName) delete]
    ProcessDictionary erase: HTTP1Socket sentKey
    self

  nl => "\r\n"

  /// An exchange over the server side of pair, the request head already
  /// sent by the client and read.
  open: pair request: head =>
    self
      open: pair
      request: head
      method: "GET"

  open: pair request: head method: method =>
    (Erlang gen_tcp) send: (pair at: 2) with: head
    transport := ((HTTP1Socket new withSocket: (pair at: 1)) readHeaders) at: 4
    Exchange open: ((ExchangeState new withTransport: transport) withMethod: method)

  getHead => "GET / HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl

  postHead: body =>
    "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: "
      ++ (Erlang erlang byte_size: body) printString
      ++ self nl
      ++ self nl
      ++ body

  // ===== the request =====
  testRequestAccessors =>
    st := (((((ExchangeState new withScheme: #https) withHost: "example.com") withPort: 8443) withPath: "/a/b") withQuery: "x=1") withHeaders: #({"host", "example.com"}, {"x-a", "1"}, {"x-a", "2"})
    ex := Exchange open: st
    self assert: ex method equals: "GET"
    self assert: ex scheme equals: #https
    self assert: ex host equals: "example.com"
    self assert: ex port equals: 8443
    self assert: ex path equals: "/a/b"
    self assert: ex query equals: "x=1"
    self assert: (ex header: "x-a") equals: "1"
    self assert: (ex header: "nope") equals: nil
    self assert: ex headers size equals: 3
    self assert: ex httpProtocol equals: #http10
    self assert: ex state equals: #unset
    ex finish

  testPeerAndSockData =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    self assert: (ex peer at: 1) equals: {127, 0, 0, 1}
    self assert: (ex sockData at: 1) equals: {127, 0, 0, 1}
    self assert: ex sslData equals: (Result error: #not_secure)
    ex finish
    Loopback close: pair

  testPeerNilWithoutSocket =>
    ex := Exchange open: ExchangeState new
    self assert: (ex peer isNil)
    ex finish

  // ===== ownership and lifetime =====
  testOwnerCheck =>
    ex := Exchange open: ExchangeState new
    runner := OtherProcess spawn
    raised := runner run: [ex method]
    runner stop
    ex finish
    self assert: raised class equals: NotOwner
    self
      assert: ((raised match: [
        e :: NotOwner -> e message;
        _ -> ""
      ]) startsWith: "not_owner: an Exchange can only be used from the process")

  testFinishedExchangeRaises =>
    ex := Exchange open: ExchangeState new
    ex finish
    caught := false
    [ex method]
      on: Error
      do: [:e |
        caught := true
        self assert: (e message startsWith: "exchange_finished:")
      ]
    self assert: caught

  testFinishLeavesNoState =>
    ex := Exchange open: ExchangeState new
    ex finish
    self assert: (ProcessDictionary at: ex key) isNil

  // ===== the request body =====
  testReadBodyWhole =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: (self postHead: "hello")
    part := ex readBody unwrap
    self assert: part data asStringUnchecked equals: "hello"
    self assert: part done
    self assert: ex readBody unwrap data isEmpty
    ex finish
    Loopback close: pair

  testReadBodyCountsBytesNotGraphemes =>
    pair := Loopback pairWithReadTimeout: 5000
    body := "a\r\nb\r\nc"
    ex := self open: pair request: (self postHead: body)
    part := ex readBody unwrap
    self assert: part data asStringUnchecked equals: body
    self assert: part done
    ex finish
    Loopback close: pair

  testReadBodyInParts =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: (self postHead: "hello world")
    first := (ex readBody: #{#length => 5}) unwrap
    self assert: first data asStringUnchecked equals: "hello"
    self deny: first done
    rest := ex readBody unwrap
    self assert: rest data asStringUnchecked equals: " world"
    self assert: rest done
    ex finish
    Loopback close: pair

  testReadBodyTimeout =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: 5"
      ++ self nl
      ++ self nl
      ++ "he"
    ex := self open: pair request: head
    self assert: (ex readBody: #{
      #readTimeout => 100
    }) equals: (Result error: #timeout)
    ex forget
    Loopback close: pair

  testReadBodyClosed =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: 5"
      ++ self nl
      ++ self nl
      ++ "he"
    ex := self open: pair request: head
    (Erlang gen_tcp) close: (pair at: 2)
    self assert: ex readBody equals: (Result error: #closed)
    ex forget
    (Erlang gen_tcp) close: (pair at: 3)

  testReadBodyMalformedChunkRaises =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "transfer-encoding: chunked"
      ++ self nl
      ++ self nl
      ++ "ZZZ"
      ++ self nl
    ex := self open: pair request: head
    raised := [ex readBody] on: HTTPError do: [:e | e]
    self assert: raised message equals: "Unable to parse chunk size"
    ex forget
    Loopback close: pair

  testReadAll =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: (self postHead: "hello")
    self assert: (ex readAll: 100) unwrap asStringUnchecked equals: "hello"
    ex finish
    Loopback close: pair

  testReadAllTooLarge =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: (self postHead: "hello world")
    self assert: (ex readAll: 5) equals: (Result error: #body_too_large)
    ex forget
    Loopback close: pair

  // ===== the response =====
  testSendResp =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 200
      headers: #({"content-type", "text/plain"})
      body: "hello"
    self assert: ex state equals: #sent
    resp := Loopback responseOf: pair body: 5
    self assert: (resp startsWith: "HTTP/1.1 200 OK\r\n")
    self assert: (resp includesSubstring: "\r\ncontent-length: 5\r\n")
    self assert: (resp includesSubstring: "\r\ncontent-type: text/plain\r\n")
    self assert: (resp includesSubstring: "\r\ndate: ")
    self assert: (resp endsWith: "\r\n\r\nhello")
    self assert: ex transport keepalive equals: true
    ex finish
    Loopback close: pair

  testSendRespIodata =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 200
      headers: #()
      body: #("hel", #("lo"))
    resp := Loopback responseOf: pair body: 5
    self assert: (resp includesSubstring: "\r\ncontent-length: 5\r\n")
    self assert: (resp endsWith: "hello")
    ex finish
    Loopback close: pair

  testSendRespKeepsCallerDate =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 200
      headers: #({"date", "yesterday"})
      body: ""
    resp := Loopback responseOf: pair body: 0
    self assert: (resp includesSubstring: "\r\ndate: yesterday\r\n")
    ex finish
    Loopback close: pair

  testSendRespHeadHasNoBody =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "HEAD / HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl
    ex := self
      open: pair
      request: head
      method: "HEAD"
    _ := ex
      sendResp: 200
      headers: #()
      body: "hello"
    resp := Loopback responseOf: pair body: 0
    // Bandit keeps the content-length a GET would carry, and sends no body.
    self assert: (resp includesSubstring: "\r\ncontent-length: 5\r\n")
    self assert: (resp endsWith: "\r\n\r\n")
    self assert: ex transport writeState equals: #sent
    ex finish
    // Nothing follows the head.
    self
      assert: ((Erlang gen_tcp)
        recv: (pair at: 2)
        with: 0
        with: 100) isError
    Loopback close: pair

  testSendResp204DropsBodyAndLength =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 204
      headers: #({"content-length", "5"})
      body: "hello"
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.1 204 No Content\r\n")
    self deny: (resp includesSubstring: "content-length")
    ex finish
    self
      assert: ((Erlang gen_tcp)
        recv: (pair at: 2)
        with: 0
        with: 100) isError
    Loopback close: pair

  testSecondSendRespRaises =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 200
      headers: #()
      body: ""
    raised := [
      ex
        sendResp: 200
        headers: #()
        body: ""
      nil
    ] on: Error do: [:e | e]
    self assert: raised class equals: AlreadySent
    ex finish
    Loopback close: pair

  // ===== commit and finish =====
  testCommitUnsentRaises =>
    ex := Exchange open: ExchangeState new
    raised := [
      _ := ex commit
      nil
    ] on: Error do: [:e | e]
    ex finish
    self assert: raised class equals: NotSentError

  testCommitSentIsQuiet =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 200
      headers: #()
      body: ""
    self assert: ex commit equals: ex
    ex finish
    Loopback close: pair

  testFinishDrainsUnreadBody =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: (self postHead: "hello") ++ "GET /next"
    ex
      sendResp: 200
      headers: #()
      body: ""
    next := ex finish
    self assert: next readState equals: #read
    self assert: next buffer asStringUnchecked equals: "GET /next"
    Loopback close: pair

  // ===== Phase 3: chunked responses =====
  chunkedHead: pair =>
    client := pair at: 2
    head := ""
    [(head includesSubstring: "\r\n\r\n") not]
      whileTrue: [
        head := head
          concat: (((Erlang gen_tcp)
            recv: client
            with: 1
            with: 2000) unwrap)
      ]
    head asStringUnchecked

  chunkedBody: pair bytes: n =>
    (((Erlang gen_tcp)
      recv: (pair at: 2)
      with: n
      with: 2000) unwrap) asStringUnchecked

  testSendChunkedWireFormat =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex sendChunked: 200 headers: #()
    self assert: ex state equals: #chunked
    head := self chunkedHead: pair
    self assert: (head startsWith: "HTTP/1.1 200 OK\r\n")
    self assert: (head includesSubstring: "transfer-encoding: chunked")
    self assert: (ex chunk: "OK") equals: (Result ok: nil)
    frame := self chunkedBody: pair bytes: 7
    self assert: frame equals: "2\r\nOK\r\n"
    ex commit
    self assert: ex state equals: #sent
    tail := self chunkedBody: pair bytes: 5
    self assert: tail equals: "0\r\n\r\n"
    ex finish
    Loopback close: pair

  testSendChunkedWithContentLengthStreamsUnframed =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex sendChunked: 200 headers: #({"content-length", "2"})
    head := self chunkedHead: pair
    self deny: (head includesSubstring: "transfer-encoding")
    self assert: (head includesSubstring: "content-length: 2")
    self assert: (ex chunk: "O") equals: (Result ok: nil)
    self assert: (ex chunk: "K") equals: (Result ok: nil)
    part := self chunkedBody: pair bytes: 2
    self assert: part equals: "OK"
    ex commit
    ex finish
    Loopback close: pair

  testChunkWithoutSendChunkedRaises =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    raised := [ex chunk: "x"] on: Error do: [:e :: Exception | e]
    self assert: raised class equals: NotChunked
    ex forget
    Loopback close: pair

  testCommitChunkedSendsEmptyClose =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex sendChunked: 200 headers: #()
    self chunkedHead: pair
    ex commit
    tail := self chunkedBody: pair bytes: 5
    self assert: tail equals: "0\r\n\r\n"
    ex finish
    Loopback close: pair

  // ===== Phase 3: sendfile =====
  testSendFileWhole =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendFile: 200
      headers: #()
      path: "test/fixtures/sendfile"
      offset: 0
      length: #all
    resp := Loopback responseOf: pair body: 6
    self assert: (resp includesSubstring: "content-length: 6")
    self assert: (resp endsWith: "ABCDEF")
    ex finish
    Loopback close: pair

  testSendFileOffsetLength =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendFile: 200
      headers: #()
      path: "test/fixtures/sendfile"
      offset: 1
      length: 3
    resp := Loopback responseOf: pair body: 3
    self assert: (resp includesSubstring: "content-length: 3")
    self assert: (resp endsWith: "BCD")
    ex finish
    Loopback close: pair

  testSendFileNegativeOffsetRaises =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    raised := [
      ex
        sendFile: 200
        headers: #()
        path: "test/fixtures/sendfile"
        offset: 0 - 1
        length: 3
      nil
    ] on: Error do: [:e :: Exception | e]
    self assert: (raised message includesSubstring: "Offset cannot be negative")
    ex forget
    Loopback close: pair

  testSendFileZeroLengthRaises =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    raised := [
      ex
        sendFile: 200
        headers: #()
        path: "test/fixtures/sendfile"
        offset: 0
        length: 0
      nil
    ] on: Error do: [:e :: Exception | e]
    self assert: (raised message includesSubstring: "Length cannot be zero or negative")
    ex forget
    Loopback close: pair

  testSendFileBeyondEOFRaises =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    raised := [
      ex
        sendFile: 200
        headers: #()
        path: "test/fixtures/sendfile"
        offset: 1
        length: 3000
      nil
    ] on: Error do: [:e :: Exception | e]
    self assert: (raised message includesSubstring: "only 6 octets")
    ex forget
    Loopback close: pair

  // ===== Phase 3: informational and 100-continue =====
  testInformSends1xxThenFinal =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    self assert: (ex inform: 103 headers: #({"link", "</app.css>"})) equals: (Result ok: nil)
    head := self chunkedHead: pair
    self assert: (head startsWith: "HTTP/1.1 103")
    self assert: (head includesSubstring: "link: </app.css>")
    ex
      sendResp: 200
      headers: #()
      body: "Informer"
    self assert: ex state equals: #sent
    ex finish
    Loopback close: pair

  testInformRefusedOnHttp10 =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "GET / HTTP/1.0" ++ self nl ++ "host: x" ++ self nl ++ self nl
    (Erlang gen_tcp) send: (pair at: 2) with: head
    transport := ((HTTP1Socket new withSocket: (pair at: 1)) readHeaders) at: 4
    ex := Exchange open: ((ExchangeState new withTransport: transport) withMethod: "GET")
    self assert: (ex inform: 100 headers: #()) equals: (Result error: #not_supported)
    ex finish
    Loopback close: pair

  testReadBodySends100Continue =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: 3"
      ++ self nl
      ++ "expect: 100-continue"
      ++ self nl
      ++ self nl
      ++ "123"
    (Erlang gen_tcp) send: (pair at: 2) with: head
    transport := ((HTTP1Socket new withSocket: (pair at: 1)) readHeaders) at: 4
    st := (ExchangeState new withTransport: transport) withMethod: "POST"
    st := st withExpectContinue: true
    ex := Exchange open: st
    part := ex readBody unwrap
    self assert: part data asStringUnchecked equals: "123"
    self assert: part done
    interim := self chunkedHead: pair
    self assert: (interim startsWith: "HTTP/1.1 100 Continue")
    ex finish
    Loopback close: pair

  testRespondWithoutReadingClosesUnhonoredExpect =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: 5"
      ++ self nl
      ++ "expect: 100-continue"
      ++ self nl
      ++ self nl
    (Erlang gen_tcp) send: (pair at: 2) with: head
    transport := ((HTTP1Socket new withSocket: (pair at: 1)) readHeaders) at: 4
    st := (ExchangeState new withTransport: transport) withMethod: "POST"
    st := st withExpectContinue: true
    ex := Exchange open: st
    _ := ex
      sendResp: 401
      headers: #()
      body: "denied"
    resp := self chunkedHead: pair
    self assert: (resp startsWith: "HTTP/1.1 401")
    self assert: (resp includesSubstring: "connection: close")
    ex finish
    Loopback close: pair

  testInformOnHeadThenFinal =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "HEAD /h HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl
    (Erlang gen_tcp) send: (pair at: 2) with: head
    transport := ((HTTP1Socket new withSocket: (pair at: 1)) readHeaders) at: 4
    ex := Exchange open: ((ExchangeState new withTransport: transport) withMethod: "HEAD")
    self assert: (ex inform: 103 headers: #()) equals: (Result ok: nil)
    interim := self chunkedHead: pair
    self assert: (interim startsWith: "HTTP/1.1 103")
    _ := ex
      sendResp: 200
      headers: #()
      body: "hi"
    final := Loopback responseOf: pair body: 0
    self assert: (final startsWith: "HTTP/1.1 200 OK")
    self deny: (final includesSubstring: "transfer-encoding")
    ex finish
    Loopback close: pair

  testInformAfterFinalAnswersAlreadySent =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex
      sendResp: 200
      headers: #()
      body: "done"
    self assert: (ex inform: 103 headers: #()) equals: (Result error: #already_sent)
    ex finish
    Loopback close: pair

  testCloseChunkedFailureDropsKeepalive =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex sendChunked: 200 headers: #()
    self chunkedHead: pair
    (ex transport socket) close
    ex commit
    self assert: ex state equals: #sent
    self deny: ex transport keepalive
    ex finish
    Loopback close: pair

  testChunkClosedAgainstGoneClient =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    ex sendChunked: 200 headers: #()
    self chunkedHead: pair
    (ex transport socket) close
    self assert: (ex chunk: "gone") equals: (Result error: #closed)
    ex forget
    Loopback close: pair

  testSendFileDirectory500 =>
    pair := Loopback pairWithReadTimeout: 5000
    ex := self open: pair request: self getHead
    raised := [
      ex
        sendFile: 200
        headers: #()
        path: "test/fixtures"
        offset: 0
        length: #all
      nil
    ] on: Error do: [:e :: Exception | e]
    self assert: (raised message includesSubstring: "not a regular file")
    ex forget
    Loopback close: pair

  testReadBody100SendFailsClosed =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: 3"
      ++ self nl
      ++ "expect: 100-continue"
      ++ self nl
      ++ self nl
    (Erlang gen_tcp) send: (pair at: 2) with: head
    transport := ((HTTP1Socket new withSocket: (pair at: 1)) readHeaders) at: 4
    st := ((ExchangeState new withTransport: transport) withMethod: "POST") withExpectContinue: true
    ex := Exchange open: st
    (Erlang gen_tcp) close: (pair at: 2)
    self assert: ex readBody equals: (Result error: #closed)
    ex forget
    Loopback close: pair
