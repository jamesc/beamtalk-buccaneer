/// Record `[buccaneer, request, *]` telemetry events in an Ets table,
/// as `{event, measurements, metadata}` tuples under `#events`. The
/// handler runs in the emitting process, so it records in Ets rather
/// than in the test. One table per test class (methods in a class run
/// sequentially; classes may not).
sealed typed Object subclass: TelemetryCollector

  /// Every event Buccaneer emits.
  class sealed events -> List(List(Symbol)) =>
    #(#(#buccaneer, #request, #start), #(#buccaneer, #request, #stop), #(#buccaneer, #request, #exception))

  /// Record the events whose metadata names `plug` in the table `name`
  /// (whose name is also the handler id).
  class sealed attachAll: plug :: Object table: name :: Symbol -> Nil =>
    (Telemetry
      attach: name
      toAll: self events
      do: [:event :measurements :metadata |
        (metadata at: #plug ifAbsent: [nil]) =:= plug
          ifTrue: [
            table := Ets named: name
            table at: #events put: ((table at: #events ifAbsent: [
              #()
            ]) add: {event, measurements, metadata})
          ]
      ]) unwrap
    nil

  class sealed detach: name :: Symbol -> Nil => Telemetry detach: name

  /// The events recorded so far.
  class sealed eventsIn: name :: Symbol -> List(Tuple) =>
    (Ets named: name) at: #events ifAbsent: [#()]

  /// The recorded events named `span` `suffix`.
  class sealed events: span :: Symbol named: suffix :: Symbol in: name :: Symbol -> List(Tuple) =>
    wanted := #(#buccaneer) add: span
    wanted := wanted add: suffix
    (self eventsIn: name) select: [:e | (e at: 1) =:= wanted]

  /// Wait up to three seconds for a `span` `suffix` event; answer the
  /// first one's `{event, measurements, metadata}`, or nil.
  class sealed await: span :: Symbol named: suffix :: Symbol in: name :: Symbol -> Tuple | Nil =>
    300
      timesRepeat: [
        (self
          events: span
          named: suffix
          in: name) isEmpty ifTrue: [Timer sleep: 10]
      ]
    found := self
      events: span
      named: suffix
      in: name
    found isEmpty ifTrue: [nil] ifFalse: [found first]
