/// Phase 3 bounded-memory streaming: 1 GiB upload and download in chunks.
/// The handlers never hold more than one chunk; the totals prove every
/// byte went through. Each handler also caps its own process heap
/// (shared binaries included) far below 1 GiB, so a buffering regression
/// kills the process and fails the test fast instead of passing on a big
/// machine.
TestCase subclass: BoundedStreamTest

  connect: port =>
    ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, false})) unwrap

  chunkSize -> Integer => 1048576

  chunkCount -> Integer => 1024

  gib -> Integer => 1073741824

  /// Heap cap in words (64 MiB on a 64-bit VM): a few chunks fit, 1 GiB
  /// of accumulation does not.
  heapCapWords -> Integer => 8388608

  /// Cap the calling process; exceeding it kills the process.
  capHeap =>
    (Erlang erlang)
      process_flag: #max_heap_size
      with: #{
        #size => self heapCapWords,
        #kill => true,
        #error_logger => false,
        #include_shared_binaries => true
      }

  testUploadOneGibStreamsInBoundedMemory =>
    srv := (Buccaneer
      start: #{#port => 0, #handler => [:ex |
          self capHeap
          total := 0
          done := false
          [done]
            whileFalse: [
              part := (ex readBody: #{#length => 8000000}) unwrap
              total := total + part data size
              done := part done
            ]
          ex
            sendResp: 200
            headers: #()
            body: total printString
        ]}) unwrap
    port := (srv listenerInfo unwrap) at: 2
    client := self connect: port
    (Erlang gen_tcp) send: client with: "POST /upload HTTP/1.1\r\nhost: x\r\ncontent-length: 1073741824\r\n\r\n"
    i := 0
    piece := "a" repeat: self chunkSize
    [i < self chunkCount]
      whileTrue: [
        ((Erlang gen_tcp) send: client with: piece) unwrap
        i := i + 1
      ]
    resp := Loopback responseOn: client body: 10
    self assert: ((resp asStringUnchecked) endsWith: "1073741824")
    (Erlang gen_tcp) close: client
    self assert: (srv stop: 5000) isOk

  testDownloadOneGibStreamsInBoundedMemory =>
    srv := (Buccaneer
      start: #{#port => 0, #handler => [:ex |
          self capHeap
          ex sendChunked: 200 headers: #({"content-length", "1073741824"})
          i := 0
          piece := "a" repeat: self chunkSize
          [i < self chunkCount]
            whileTrue: [
              (ex chunk: piece) unwrap
              i := i + 1
            ]
        ]}) unwrap
    port := (srv listenerInfo unwrap) at: 2
    client := self connect: port
    (Erlang gen_tcp) send: client with: "GET /download HTTP/1.1\r\nhost: x\r\n\r\n"
    head := ""
    [(head includesSubstring: "\r\n\r\n") not]
      whileTrue: [
        head := head
          concat: (((Erlang gen_tcp)
            recv: client
            with: 1
            with: 5000) unwrap)
      ]
    self assert: ((head asStringUnchecked) includesSubstring: "content-length: 1073741824")
    total := 0
    i := 0
    [i < self chunkCount]
      whileTrue: [
        got := ((Erlang gen_tcp)
          recv: client
          with: self chunkSize
          with: 5000) unwrap
        total := total + got size
        i := i + 1
      ]
    self assert: total equals: self gib
    (Erlang gen_tcp) close: client
    self assert: (srv stop: 5000) isOk
