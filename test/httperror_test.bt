TestCase subclass: HTTPErrorTest

  testReasonRoundTrip =>
    err := [
      HTTPError signal: "Request URI is too long" reason: 414
    ] on: HTTPError do: [:e | e]
    self assert: err message equals: "Request URI is too long"
    self assert: err reason equals: 414

  testReasonDefaultsNil =>
    err := [HTTPError signal: "bad"] on: HTTPError do: [:e | e]
    self assert: err reason isNil

  testStatusFor =>
    err := [HTTPError signal: "x" reason: 414] on: HTTPError do: [:e | e]
    self assert: (HTTPError statusFor: err) equals: 414
    plain := [HTTPError signal: "x"] on: HTTPError do: [:e | e]
    self assert: (HTTPError statusFor: plain) equals: 400

  testPassPreservesReason =>
    err := [
      [HTTPError signal: "x" reason: 414] on: HTTPError do: [:e | e pass]
    ] on: HTTPError do: [:e | e]
    self assert: err reason equals: 414
    self assert: err message equals: "x"

  testSignalCarriesMessageAndClass =>
    caught := false
    [HTTPError signal: "Header contains invalid port"]
      on: HTTPError
      do: [:e |
        caught := true
        self assert: e message equals: "Header contains invalid port"
        // errorClass is declared String but answers a Symbol; asString is the
        // identity on both, so this holds either way the stdlib settles.
        self assert: e errorClass asString equals: "HTTPError"
      ]
    self assert: caught

  testShouldRaiseSignal =>
    self should: [HTTPError signal: "boom"] raise: #signal
