TestCase subclass: PipelineTest

  tableName -> Symbol => #pipelineTelemetry

  setUp =>
    (Ets exists: self tableName) ifTrue: [(Ets named: self tableName) delete]
    TelemetryCollector detach: self tableName
    Ets new: self tableName type: #set
    self

  tearDown =>
    TelemetryCollector detach: self tableName
    (Ets named: self tableName) delete
    ProcessDictionary erase: HTTP1Socket sentKey
    self

  nl -> String => "\r\n"

  getHead =>
    "GET /hello?name=x HTTP/1.1"
      ++ self nl
      ++ "host: example.com"
      ++ self nl
      ++ self nl

  postHead: body =>
    "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "content-length: "
      ++ (Erlang erlang byte_size: body) printString
      ++ self nl
      ++ self nl
      ++ body

  /// Run one request on `pair` (whose head the caller already sent).
  /// Answers the Result; handler errors are re-signalled.
  runOn: pair handler: handler -> Result(HTTPTransport, Object) =>
    transport := HTTP1Socket new withSocket: (pair at: 1)
    config := BuccaneerConfig from: #{#handler => handler}
    Pipeline
      runRequest: transport
      handler: handler
      connectionSpan: nil
      connData: {false, {127, 0, 0, 1}}
      options: config

  /// Send `head` on a fresh pair and run one request. Answers
  /// {result, pair}; the caller closes the pair.
  serveHead: head handler: handler -> Tuple =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: head
    {(self runOn: pair handler: handler), pair}

  /// Assert nothing more arrives on the pair.
  assertQuiet: pair =>
    probe := (Erlang gen_tcp)
      recv: (pair at: 2)
      with: 1
      with: 200
    self assert: probe isError

  /// Assert this process holds no exchange state.
  assertNoExchangeState =>
    left := (ProcessDictionary keys)
      select: [:k |
        k match: [
          t :: Tuple -> (t at: 1) =:= #buccaneer_exchange;
          _ -> false
        ]
      ]
    self assert: left equals: #()

  testOkGet =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: "hello"
    ]
    {result, pair} := self serveHead: self getHead handler: handler
    self assert: result isOk
    self assert: (result value keepalive) equals: true
    resp := Loopback responseOf: pair body: 5
    self assert: (resp startsWith: "HTTP/1.1 200 OK\r\n")
    self assert: (resp includesSubstring: "\r\ncontent-length: 5\r\n")
    self assert: (resp endsWith: "\r\n\r\nhello")
    Loopback close: pair

  testFinishForgetsState =>
    {result, pair} := self
      serveHead: self getHead
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: ""
      ]
    self assert: result isOk
    self assertNoExchangeState
    Loopback close: pair

  testEchoRequest =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: (ex host)
          ++ "|"
          ++ ex port printString
          ++ "|"
          ++ ex path
          ++ "|"
          ++ ((ex query) ifNil: ["nil"])
    ]
    head := "GET http://example.com:8080/a/b?x=1?y=2#frag HTTP/1.1"
      ++ self nl
      ++ "host: ignored.com"
      ++ self nl
      ++ self nl
    {result, pair} := self serveHead: head handler: handler
    self assert: result isOk
    body := "example.com|8080|/a/b|x=1?y=2"
    self assert: ((Loopback responseOf: pair body: body size) endsWith: body)
    Loopback close: pair

  testMissingHost400 =>
    {result, pair} := self
      serveHead: "GET / HTTP/1.1" ++ self nl ++ self nl
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: ""
      ]
    self assert: result isError
    self assert: (result error isKindOf: HTTPError)
    // HTTP/1.0, as in Bandit: the error goes out on the pre-read
    // transport, whose version was never set.
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.0 400 Bad Request")
    Loopback close: pair

  testHttp10NoHost =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: ex host ++ "|" ++ ex port printString
    ]
    {result, pair} := self serveHead: "GET / HTTP/1.0" ++ self nl ++ self nl handler: handler
    self assert: result isOk
    self assert: ((Loopback responseOf: pair body: 3) endsWith: "|80")
    Loopback close: pair

  testMalformedRequestLine =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: ""
    ]
    TelemetryCollector attachAll: handler table: self tableName
    {result, pair} := self serveHead: "GARBAGE" ++ self nl ++ self nl handler: handler
    self assert: result isError
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.0 400 Bad Request")
    stop := (TelemetryCollector
      events: #request
      named: #stop
      in: self tableName) first
    self assert: (((stop at: 3) at: #error) startsWith: "Request line")
    self deny: ((stop at: 3) includesKey: #conn)
    self
      assert: (TelemetryCollector
        events: #request
        named: #exception
        in: self tableName)
      equals: #()
    Loopback close: pair

  testAsteriskOptions =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: ex path
    ]
    head := "OPTIONS * HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl
    {result, pair} := self serveHead: head handler: handler
    self assert: result isOk
    self assert: ((Loopback responseOf: pair body: 1) endsWith: "*")
    Loopback close: pair

  testConnectAuthority =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: ex host ++ "|" ++ ex port printString ++ "|" ++ ex path
    ]
    head := "CONNECT example.com:443 HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl
    {result, pair} := self serveHead: head handler: handler
    self assert: result isOk
    self assert: ((Loopback responseOf: pair body: 16) endsWith: "example.com|443|")
    Loopback close: pair

  testUnsentHandler500 =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    raised := [
      self runOn: pair handler: CallHandler new
    ] on: NotSentError do: [:e | e]
    self assert: raised message equals: "a response was neither set nor sent from the connection"
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.1 500 Internal Server Error")
    Loopback close: pair

  testHandlerRaises500 =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    raised := [
      self runOn: pair handler: [:_ex | Error signal: "boom"]
    ] on: Error do: [:e | e]
    self assert: raised message equals: "boom"
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.1 500 Internal Server Error")
    Loopback close: pair

  testSendThenRaiseKeepsResponse =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    raised := [
      self
        runOn: pair
        handler: [:ex |
          ex
            sendResp: 200
            headers: #()
            body: "hi"
          Error signal: "late"
        ]
    ] on: Error do: [:e | e]
    resp := Loopback responseOf: pair body: 2
    self assert: (resp startsWith: "HTTP/1.1 200 OK\r\n")
    self assert: (resp endsWith: "\r\n\r\nhi")
    self assertQuiet: pair
    self assert: raised message equals: "late"
    Loopback close: pair

  testHandlerHTTPErrorMapsStatus =>
    {result, pair} := self serveHead: self getHead handler: [:ex |
      HTTPError signal: ex method reason: 414
    ]
    self assert: result isError
    self assert: (result error reason) equals: 414
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.1 414")
    self assertNoExchangeState
    Loopback close: pair

  testTransportErrorSendsNothing =>
    pair := Loopback pairWithReadTimeout: 5000
    transport := HTTP1Socket new withSocket: (pair at: 1)
    config := BuccaneerConfig from: #{#handler => [:ex | ex]}
    raised := [
      TransportError signal: "Unrecoverable error: closed" reason: #closed
    ] on: TransportError do: [:e | e]
    span := BuccaneerTelemetry
      startSpan: #request
      measurements: #{}
      metadata: #{}
    result := Pipeline
      protocolError: raised
      span: span
      transport: transport
      metadata: #{}
      options: config
    self assert: result isError
    self assert: (result error isKindOf: TransportError)
    self assertQuiet: pair
    Loopback close: pair

  testMetricsAndTelemetry =>
    handler := [:ex |
      body := (ex readAll: 100) unwrap
      ex
        sendResp: 200
        headers: #()
        body: body
    ]
    TelemetryCollector attachAll: handler table: self tableName
    {result, pair} := self serveHead: (self postHead: "hello") handler: handler
    self assert: result isOk
    self assert: ((Loopback responseOf: pair body: 5) endsWith: "hello")
    stop := (TelemetryCollector
      events: #request
      named: #stop
      in: self tableName) first
    m := stop at: 2
    meta := stop at: 3
    self assert: (m at: #req_body_bytes) equals: 5
    self assert: (m at: #resp_body_bytes) equals: 5
    self assert: ((m at: #req_header_end_time) isKindOf: Integer)
    self assert: ((m at: #req_body_start_time) isKindOf: Integer)
    self assert: ((m at: #req_body_end_time) isKindOf: Integer)
    self assert: ((m at: #resp_start_time) isKindOf: Integer)
    self assert: ((m at: #resp_end_time) isKindOf: Integer)
    self assert: ((m at: #duration) isKindOf: Integer)
    self assert: ((meta at: #conn) status) equals: 200
    self assert: ((meta at: #conn) path) equals: "/p"
    self assert: ((meta at: #conn) respState) equals: #sent
    start := (TelemetryCollector
      events: #request
      named: #start
      in: self tableName) first
    self assert: (((start at: 3) at: #conn) path) equals: "/p"
    Loopback close: pair

  testPipelinedBufferPreserved =>
    both := self getHead
      ++ ("GET /second HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl)
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: ""
    ]
    {result, pair} := self serveHead: both handler: handler
    self assert: result isOk
    self assert: (((result value buffer) asStringUnchecked) startsWith: "GET /second")
    Loopback close: pair

  testDrainFailureAfterSend =>
    pair := Loopback pairWithReadTimeout: 5000
    head := "POST /p HTTP/1.1"
      ++ self nl
      ++ "host: x"
      ++ self nl
      ++ "transfer-encoding: chunked"
      ++ self nl
      ++ self nl
      ++ "ZZZ"
      ++ self nl
    (Erlang gen_tcp) send: (pair at: 2) with: head
    result := self
      runOn: pair
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: "hi"
      ]
    self assert: result isError
    resp := Loopback responseOf: pair body: 2
    self assert: (resp startsWith: "HTTP/1.1 200 OK\r\n")
    self assertQuiet: pair
    self assertNoExchangeState
    Loopback close: pair

  testHandlerThrowPreserved =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    raised := [
      self runOn: pair handler: [:_ex | Erlang erlang throw: #oops]
    ] on: ThrowError do: [:e | e]
    self assert: (raised isKindOf: ThrowError)
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.1 500 Internal Server Error")
    Loopback close: pair

  testLogStatusOptions =>
    base := BuccaneerConfig from: #{#handler => [:ex | ex]}
    self assert: (Pipeline logStatus: 500 options: base)
    self deny: (Pipeline logStatus: 404 options: base)
    single := BuccaneerConfig from: #{
      #handler => [:ex | ex],
      #http => #{#logExceptionsWithStatusCodes => 404}
    }
    self assert: (Pipeline logStatus: 404 options: single)
    self deny: (Pipeline logStatus: 500 options: single)
    list := BuccaneerConfig
      from: #{
        #handler => [:ex | ex],
        #http => #{#logExceptionsWithStatusCodes => #(404, 500)}
      }
    self assert: (Pipeline logStatus: 500 options: list)
    validated := BuccaneerConfig from: #{#handler => [:ex | ex]}
    bad := validated withHttp: #{#logExceptionsWithStatusCodes => #always}
    raised := [Pipeline logStatus: 500 options: bad] on: Error do: [:e | e]
    self assert: (raised message startsWith: "Invalid value for #log")

  testConnectBadPort400 =>
    {result, pair} := self
      serveHead: "CONNECT example.com:abc HTTP/1.1" ++ self nl ++ "host: x" ++ self nl ++ self nl
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: ""
      ]
    self assert: result isError
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.0 400 Bad Request")
    Loopback close: pair

  testAbsoluteHostBadPort =>
    raised := [
      Pipeline
        absoluteHost: "example.com"
        port: "abc"
        scheme: #http
    ] on: HTTPError do: [:e | e]
    self assert: raised message equals: "Header contains invalid port"

  testTwoHosts400 =>
    head := "GET / HTTP/1.1"
      ++ self nl
      ++ "host: a"
      ++ self nl
      ++ "host: b"
      ++ self nl
      ++ self nl
    {result, pair} := self
      serveHead: head
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: ""
      ]
    self assert: result isError
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.0 400 Bad Request")
    Loopback close: pair

  testBuildStateSecure =>
    st := Pipeline
      buildState: HTTP1Socket new
      method: "GET"
      target: {nil, nil, nil, "/p"}
      headers: #({"host", "x"})
      connData: {true, {127, 0, 0, 1}}
    self assert: st scheme equals: #https
    self assert: st host equals: "x"
    self assert: st port equals: 443
    self assert: st path equals: "/p"

  testBaseMetadataSpan =>
    span := CatalinaTelemetry
      startSpan: #connection
      measurements: #{}
      metadata: #{}
    config := BuccaneerConfig from: #{#handler => [:ex | ex]}
    meta := Pipeline baseMetadata: span handler: config
    self assert: (meta at: #connection_telemetry_span_context) equals: span telemetrySpanContext
    self assert: (meta includesKey: #plug)

  testHandlerRaiseReportsOnce =>
    handler := [:_ex | Error signal: "boom"]
    TelemetryCollector attachAll: handler table: self tableName
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    raised := [self runOn: pair handler: handler] on: Error do: [:e | e]
    self assert: raised message equals: "boom"
    self
      assert: (TelemetryCollector
        events: #request
        named: #start
        in: self tableName) size
      equals: 1
    self
      assert: (TelemetryCollector
        events: #request
        named: #exception
        in: self tableName) size
      equals: 1
    self
      assert: (TelemetryCollector
        events: #request
        named: #stop
        in: self tableName)
      equals: #()
    Loopback close: pair

  testSequentialRequestsIsolated =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    first := self
      runOn: pair
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: ""
      ]
    self assert: first isOk
    Loopback responseOf: pair body: 0
    (Erlang gen_tcp) send: (pair at: 2) with: "GARBAGE" ++ self nl ++ self nl
    second := self
      runOn: pair
      handler: [:ex |
        ex
          sendResp: 200
          headers: #()
          body: ""
      ]
    self assert: second isError
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.0 400 Bad Request")
    Loopback close: pair

  testHandlerBadReasonNoEscape =>
    {result, pair} := self serveHead: self getHead handler: [:ex |
      HTTPError signal: "weird" reason: 999
    ]
    self assert: result isError
    self assertQuiet: pair
    Loopback close: pair

  testGetMetricsOmitUnreadBody =>
    handler := [:ex |
      ex
        sendResp: 200
        headers: #()
        body: "hi"
    ]
    TelemetryCollector attachAll: handler table: self tableName
    {result, pair} := self serveHead: self getHead handler: handler
    self assert: result isOk
    Loopback responseOf: pair body: 2
    stop := (TelemetryCollector
      events: #request
      named: #stop
      in: self tableName) first
    m := stop at: 2
    self deny: (m includesKey: #req_body_bytes)
    self deny: (m includesKey: #req_body_start_time)
    self assert: (m at: #resp_body_bytes) equals: 2
    self assert: ((m at: #req_header_end_time) isKindOf: Integer)
    Loopback close: pair

  testInvalidHandler =>
    pair := Loopback pairWithReadTimeout: 5000
    (Erlang gen_tcp) send: (pair at: 2) with: self getHead
    // Not a literal 42: the config rejects those statically, so smuggle
    // the invalid handler past the checker as Pipeline's callers could.
    // A valid config: the guard under test is Pipeline's, not Config's.
    handler := #{#h => 42} at: #h
    transport := HTTP1Socket new withSocket: (pair at: 1)
    config := BuccaneerConfig from: #{#handler => [:ex | ex]}
    raised := [
      Pipeline
        runRequest: transport
        handler: handler
        connectionSpan: nil
        connData: {false, {127, 0, 0, 1}}
        options: config
    ] on: Error do: [:e | e]
    self assert: raised message equals: "Invalid request handler"
    resp := Loopback responseOf: pair body: 0
    self assert: (resp startsWith: "HTTP/1.1 500 Internal Server Error")
    Loopback close: pair
