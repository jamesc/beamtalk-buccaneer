TestCase subclass: SocketHelpersTest

  testConnData =>
    pair := Loopback pairWithReadTimeout: 5000
    self assert: (SocketHelpers connData: (pair at: 1)) equals: {false, {127, 0, 0, 1}}
    Loopback close: pair

  testConnDataUnavailable =>
    listener := ((Erlang gen_tcp) listen: 0 with: #(#binary, {#packet, #raw}, {#active, false}, {#reuseaddr, true})) unwrap
    port := ((Erlang inet) port: listener) unwrap
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, false})) unwrap
    sock := Socket
      wrap: client
      peername: nil
      handlerConfig: HandlerConfig new
      span: nil
    raised := [SocketHelpers connData: sock] on: TransportError do: [:e | e]
    self assert: raised reason equals: #no_peername
    self assert: (raised message startsWith: "Unable to obtain conn_data")
    (Erlang gen_tcp) close: client
    (Erlang gen_tcp) close: listener

  testIodataEmpty =>
    self assert: (SocketHelpers iodataEmpty: "")
    self assert: (SocketHelpers iodataEmpty: #())
    self assert: (SocketHelpers iodataEmpty: #("", #()))
    self deny: (SocketHelpers iodataEmpty: "x")
    self deny: (SocketHelpers iodataEmpty: #("x"))
    self deny: (SocketHelpers iodataEmpty: 65)
