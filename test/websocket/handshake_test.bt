  testNoInvalidValues =>
    srv := self server: true
    client := WebSocketClient connect: (self portOf: srv)
    {status, headers} := WebSocketClient
      handshake: client
      path: "/compress"
      extensions: #("permessage-deflate;server_max_window_bits")
