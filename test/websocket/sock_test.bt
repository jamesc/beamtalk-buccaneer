  // ===== terminate =====

  testTerminateOptional =>
    log := LogCapture attach: #sockTerminate
    sock := MinimalSock new withStopOnNormal: true
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendText: client data: "normal"
    self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1000)
    self assert: (self awaitClosed: client) equals: true
    Timer sleep: 100
    content := File readAll: log
    self assert: (content isError or: [(content value includesSubstring: "UndefinedFunctionError") not]) equals: true
    self assert: (srv stop: 5000) isOk

  testTerminateNormal =>
    sock := ((self testSock withStopOn: "normal"))
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendText: client data: "normal"
    self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1000)
    self assert: (self awaitClosed: client) equals: true
    self assert: self awaitTerm equals: #normal
    self assert: (srv stop: 5000) isOk

  testTerminateError =>
    log := LogCapture attach: #sockTerminate
    sock := (((self testSock withStopOn: "boom") withStopReason: #boom))
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendText: client data: "boom"
    self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1011)
    self assert: (self awaitClosed: client) equals: true
    self assert: self awaitTerm equals: {#error, #boom}
    self assert: ((LogCapture await: "(stop) #boom" in: log) includesSubstring: "(stop) #boom")
    self assert: (srv stop: 5000) isOk

  testTerminateShutdown =>
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    self assert: (srv stop: 5000) isOk
    self assert: self awaitTerm equals: #shutdown

  testTerminateRemote =>
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendClose: client code: 1000
    self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1000)
    self assert: (self awaitClosed: client) equals: true
    self assert: self awaitTerm equals: #remote
    self assert: (srv stop: 5000) isOk

  testTerminateProtocolError =>
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient close: client
    self assert: self awaitTerm equals: {#error, #closed}
    self assert: (srv stop: 5000) isOk

  testTerminateTimeout =>
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0}
      upgrade: #{#timeout => 100}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    Timer sleep: 500
    self assert: self awaitTerm equals: #timeout
    self assert: (srv stop: 5000) isOk

  // ===== telemetry =====

  testTelemetryStart =>
    self teleBegin
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    start := self teleEvent: #websocket named: #start
    self deny: start =:= nil
    measurements := start at: 2
    metadata := start at: 3
    self assert: (measurements at: #monotonic_time) notNil
    self assert: (measurements at: #compress) equals: false
    self assert: (metadata at: #plug) equals: self telePlug
    self assert: (metadata at: #websock) equals: sock
    self assert: (metadata at: #telemetry_span_context) notNil
    self assert: (metadata at: #connection_telemetry_span_context) notNil
    WebSocketClient close: client
    self assert: (srv stop: 5000) isOk
    self teleEnd

  testTelemetryMetrics =>
    self teleBegin
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendText: client data: "1234"
    WebSocketClient sendBinary: client data: "12345"
    WebSocketClient sendPing: client data: "123456"
    WebSocketClient sendPong: client data: "1234567"
    WebSocketClient sendClose: client code: 1000
    stop := self teleEvent: #websocket named: #stop
    self deny: stop =:= nil
    measurements := stop at: 2
    metadata := stop at: 3
    self assert: (measurements at: #monotonic_time) notNil
    self deny: (measurements at: #duration) < 0
    self assert: (measurements at: #recv_text_frame_count) equals: 1
    self assert: (measurements at: #recv_text_frame_bytes) equals: 4
    self assert: (measurements at: #recv_binary_frame_count) equals: 1
    self assert: (measurements at: #recv_binary_frame_bytes) equals: 5
    self assert: (measurements at: #recv_ping_frame_count) equals: 1
    self assert: (measurements at: #recv_ping_frame_bytes) equals: 6
    self assert: (measurements at: #recv_pong_frame_count) equals: 1
    self assert: (measurements at: #recv_pong_frame_bytes) equals: 7
    self assert: (measurements at: #recv_connection_close_frame_count) equals: 1
    self assert: (measurements at: #recv_connection_close_frame_bytes) equals: 0
    self assert: (measurements at: #send_text_frame_count) equals: 1
    self assert: (measurements at: #send_text_frame_bytes) equals: 4
    self assert: (measurements at: #send_binary_frame_count) equals: 1
    self assert: (measurements at: #send_binary_frame_bytes) equals: 5
    self assert: (measurements at: #send_pong_frame_count) equals: 1
    self assert: (measurements at: #send_pong_frame_bytes) equals: 6
    self assert: (metadata at: #plug) equals: self telePlug
    self assert: (metadata at: #websock) equals: sock
    self assert: (srv stop: 5000) isOk
    self teleEnd

  testTelemetryClientDisconnect =>
    self teleBegin
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendClose: client code: 1000
    stop := self teleEvent: #websocket named: #stop
    self deny: stop =:= nil
    measurements := stop at: 2
    metadata := stop at: 3
    self assert: (measurements at: #recv_connection_close_frame_count) equals: 1
    self assert: (measurements at: #recv_connection_close_frame_bytes) equals: 0
    self assert: (metadata at: #plug) equals: self telePlug
    self assert: (metadata at: #websock) equals: sock
    self assert: (srv stop: 5000) isOk
    self teleEnd

  testTelemetryServerDisconnect =>
    self teleBegin
    sock := (self testSock withStopOn: "close")
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendText: client data: "close"
    stop := self teleEvent: #websocket named: #stop
    self deny: stop =:= nil
    measurements := stop at: 2
    self assert: (measurements at: #recv_text_frame_count) equals: 1
    self assert: (measurements at: #recv_text_frame_bytes) equals: 5
    self assert: (srv stop: 5000) isOk
    self teleEnd

  testTelemetryServerShutdown =>
    self teleBegin
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    self assert: (srv stop: 5000) isOk
    stop := self teleEvent: #websocket named: #stop
    self deny: stop =:= nil
    measurements := stop at: 2
    metadata := stop at: 3
    self assert: (measurements at: #monotonic_time) notNil
    self deny: (measurements at: #duration) < 0
    self assert: (metadata at: #plug) equals: self telePlug
    self teleEnd

  testTelemetryAbnormalDisconnect =>
    self teleBegin
    log := LogCapture attach: #sockTelemetryLog
    sock := (((self testSock withStopOn2: "abnormal_close") withStopReason2: #nope))
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    WebSocketClient sendText: client data: "abnormal_close"
    self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1011)
    stop := self teleEvent: #websocket named: #stop
    self deny: stop =:= nil
    measurements := stop at: 2
    metadata := stop at: 3
    self assert: (measurements at: #recv_text_frame_count) equals: 1
    self assert: (measurements at: #recv_text_frame_bytes) equals: 14
    self assert: (metadata at: #error) equals: #nope
    self assert: ((LogCapture await: "(stop) #nope" in: log) includesSubstring: "(stop) #nope")
    self assert: (srv stop: 5000) isOk
    self teleEnd

  testTelemetryTimeout =>
    self teleBegin
    sock := (self testSock)
    srv := self
      serverWith: sock
      options: #{#port => 0, #displayHandler => self telePlug}
      upgrade: #{#timeout => 100}
    client := WebSocketClient connect: (self portOf: srv)
    self shake: client
    Timer sleep: 300
    stop := self teleEvent: #websocket named: #stop
    self deny: stop =:= nil
    measurements := stop at: 2
    metadata := stop at: 3
    self assert: (measurements at: #monotonic_time) notNil
    self deny: (measurements at: #duration) < 0
    self assert: (metadata at: #error) equals: #timeout
    self assert: (srv stop: 5000) isOk
    self teleEnd
