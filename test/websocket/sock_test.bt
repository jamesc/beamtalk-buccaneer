/// Port of Bandit's `websocket/sock_test.exs`: the WebSock callback
/// surface (init/handle_in/handle_control/handle_info/terminate) plus
/// websocket telemetry, over TCP and TLS. One configurable fixture
/// (TestSock) covers Bandit's dozens of inline websocks; MinimalSock
/// covers the optional-callback cases. Terminate reasons land in the
/// `#sockTerms` ETS table; `(stop)` log lines go to per-class log
/// captures; telemetry assertions attach their own ETS-backed handler.
TestCase subclass: SockTest

  termTable => #sockTerms

  setUp =>
    (Ets exists: self termTable) ifTrue: [(Ets named: self termTable) delete]
    Ets new: self termTable type: #set
    self

  tearDown =>
    (Ets exists: self termTable) ifTrue: [(Ets named: self termTable) delete]
    self

  /// Run the block once per scheme with base server options and the
  /// scheme itself.
  eachScheme: block =>
    {#http, #https} do: [:scheme :: Symbol |
      opts := scheme =:= #https ifTrue: [
        #{
          #port => 0,
          #scheme => #https,
          #certfile => "test/fixtures/cert.pem",
          #keyfile => "test/fixtures/key.pem"
        }
      ] ifFalse: [#{#port => 0}]
      block value: opts value: scheme
    ]

  serverWith: sock options: opts upgrade: uopts =>
    // Fencing: a previous server's terminate reason must not leak
    // into this one's reads.
    (Ets named: self termTable) removeKey: #terminate
    (Ets named: self termTable) removeKey: #pid
    (Buccaneer start: opts handler: [:ex |
      ex upgradeToWebSocket: sock options: uopts
    ]) unwrap

  portOf: srv => (srv listenerInfo unwrap) at: 2

  clientFor: scheme :: Symbol port: port :: Integer =>
    scheme =:= #https ifTrue: [^WebSocketClient connectTls: port]
    WebSocketClient connect: port

  shake: client :: Tuple =>
    {status, _} := WebSocketClient handshake: client
    self assert: status equals: "HTTP/1.1 101 Switching Protocols"

  textOf: client :: Tuple -> String =>
    (WebSocketClient recvText: client) asStringUnchecked

  deflatedTextOf: client :: Tuple -> String =>
    (WebSocketClient recvDeflatedText: client) asStringUnchecked

  closeBytes: code :: Integer => Binary fromBytes: #((code bitShift: -8) bitAnd: 255, code bitAnd: 255)

  closeBytes: code :: Integer detail: detail :: String =>
    Binary fromIolist: #((self closeBytes: code), detail)

  /// The terminate reason recorded by the websock, waiting up to two
  /// seconds for the connection process to get there.
  awaitTerm =>
    40 timesRepeat: [
      term := (Ets named: self termTable) at: #terminate ifAbsent: [nil]
      term notNil ifTrue: [^term]
      Timer sleep: 50
    ]
    nil

  noTerm =>
    Timer sleep: 100
    self assert: ((Ets named: self termTable) at: #terminate ifAbsent: [nil]) equals: nil

  /// Poll until the server closed the socket (its close runs through
  /// process shutdown, so a single recv races it under parallel load).
  awaitClosed: client =>
    6 timesRepeat: [
      (WebSocketClient closedForReading: client) ifTrue: [^true]
      Timer sleep: 50
    ]
    false

  pidOfTest => (Ets named: self termTable) at: #pid ifAbsent: [nil]

  /// A tabled websock; tests add only their interesting fields.
  testSock => (self testSock)

  /// A tabled websock that records its connection pid on "whoami".
  pidSock => ((self testSock withInAnswer: #pid) withPidTable: self termTable)

  telePlug -> Symbol => #sockTelemetry

  teleTable -> Symbol => #sockTelemetryEvents

  teleBegin =>
    (Ets exists: self teleTable) ifTrue: [(Ets named: self teleTable) delete]
    TelemetryCollector detach: self teleTable
    Ets new: self teleTable type: #set
    TelemetryCollector attachWebsocket: self telePlug table: self teleTable
    nil

  teleEnd =>
    TelemetryCollector detach: self teleTable
    (Ets named: self teleTable) delete
    nil

  teleEvent: span :: Symbol named: suffix :: Symbol =>
    TelemetryCollector await: span named: suffix in: self teleTable

  // ===== init =====

  testInitOk =>
    self eachScheme: [:opts :scheme |
      sock := (self testSock withInAnswer: #record)
      srv := self
        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      WebSocketClient sendText: client data: "OK"
      WebSocketClient sendText: client data: "dump"
      self assert: ((self textOf: client) includesSubstring: "OK")
      WebSocketClient close: client
      self assert: (srv stop: 5000) isOk
    ]

  testInitPush =>
    self eachScheme: [:opts :scheme |
      sock := ((((self testSock withInitAnswer: #push) withInitFrames: #({#text, "init"})) withInAnswer: #record))
      srv := self
        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      self assert: (self textOf: client) equals: "init"
      WebSocketClient sendText: client data: "OK"
      WebSocketClient sendText: client data: "dump"
      self assert: ((self textOf: client) includesSubstring: "OK")
      WebSocketClient close: client
      self assert: (srv stop: 5000) isOk
    ]

  testInitReply =>
    self eachScheme: [:opts :scheme |
      sock := ((((self testSock withInitAnswer: #reply) withInitFrames: #({#text, "init"})) withInAnswer: #record))
      srv := self
        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      self assert: (self textOf: client) equals: "init"
      WebSocketClient sendText: client data: "OK"
      WebSocketClient sendText: client data: "dump"
      self assert: ((self textOf: client) includesSubstring: "OK")
      WebSocketClient close: client
      self assert: (srv stop: 5000) isOk
    ]

