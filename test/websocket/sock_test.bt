  testInitClose =>
    self eachScheme: [:opts :scheme |
      sock := ((TestSock new withInitAnswer: #stop) withTable: self termTable)
      srv := self
        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1000)
      self assert: (self awaitClosed: client) equals: true
      self assert: self awaitTerm equals: #normal
      self assert: (srv stop: 5000) isOk
    ]

  testInitAbnormalClose =>
    self eachScheme: [:opts :scheme |
      log := LogCapture attach: #sockAbnormal
      sock := (((TestSock new withInitAnswer: #stopError) withInitCode: 1011) withTable: self termTable)
      srv := self
        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      self assert: (WebSocketClient recvClose: client) equals: (self closeBytes: 1011)
      self assert: (self awaitClosed: client) equals: true
      self assert: self awaitTerm equals: {#error, #abnormal}
      self assert: ((LogCapture await: "(stop) #abnormal" in: log) includesSubstring: "(stop) #abnormal")
      self assert: (srv stop: 5000) isOk
    ]

