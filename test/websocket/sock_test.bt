        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      WebSocketClient sendText: client data: "OK"
      self noTerm
      WebSocketClient sendText: client data: "dump"
      self assert: ((self textOf: client) includesSubstring: "OK")
      WebSocketClient close: client
      self assert: (srv stop: 5000) isOk
    ]

