  // ===== handle_control =====

  testHandleControlOptional =>
    self eachScheme: [:opts :scheme |
      sock := MinimalSock new
      srv := self
        serverWith: sock
        options: opts
        upgrade: #{}
      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      WebSocketClient sendPing: client data: "OK"
      self assert: ((WebSocketClient recvPong: client) asStringUnchecked) equals: "OK"
      WebSocketClient sendText: client data: "OK"
      self assert: (self textOf: client) equals: "OK"
      WebSocketClient close: client
      self assert: (srv stop: 5000) isOk
    ]

