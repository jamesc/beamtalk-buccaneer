      client := self clientFor: scheme port: (self portOf: srv)
      self shake: client
      WebSocketClient sendText: client data: "whoami"
      self assert: (self textOf: client) equals: "pid"
      pid := self pidOfTest
      (Erlang erlang) send: pid with: "OK"
      (Erlang erlang) send: pid with: "dump"
      self assert: ((self textOf: client) includesSubstring: "OK")
      WebSocketClient close: client
      self assert: (srv stop: 5000) isOk
    ]

