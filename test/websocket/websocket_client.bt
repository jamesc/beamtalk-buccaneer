/// Port of Bandit's SimpleWebSocketClient: a raw TCP/TLS websocket
/// client for the tests. The client is a {transport, socket} pair;
/// frames go out masked with a fixed mask, server frames are parsed
/// into {flags, opcode, data}.
sealed typed Object subclass: WebSocketClient

  /// A connected pair over TCP.
  class sealed connect: port :: Integer -> Tuple =>
    {#genTcp, (((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, false})) unwrap)}

  /// A connected pair over TLS.
  class sealed connectTls: port :: Integer -> Tuple =>
    {#ssl, (((Erlang ssl)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, false}, {#verify, #verify_none})) unwrap)}

  /// Answered as a Result: a bare ok becomes ok: nil.
  class sealed send: client :: Tuple bytes: data :: Binary -> Result(Nil, Object) =>
    {transport, socket} := client
    raw := transport =:= #genTcp ifTrue: [
      (Erlang gen_tcp) send: socket with: data
    ] ifFalse: [
      (Erlang ssl) send: socket with: data
    ]
    raw match: [
      _ :: Symbol -> Result ok: nil;
      r :: Result -> r
    ]

  class sealed recv: client :: Tuple bytes: n :: Integer -> Binary =>
    {transport, socket} := client
    transport =:= #genTcp ifTrue: [
      ^(((Erlang gen_tcp) recv: socket with: n with: 5000) unwrap)
    ]
    (((Erlang ssl) recv: socket with: n with: 5000) unwrap)

  class sealed close: client :: Tuple -> Object =>
    {transport, socket} := client
    transport =:= #genTcp ifTrue: [
      ^(Erlang gen_tcp) close: socket
    ]
    (Erlang ssl) close: socket

  /// Send the handshake request and answer {statusLine, headers}.
  class sealed handshake: client :: Tuple -> Tuple =>
    self send: client bytes: ("GET / HTTP/1.1\r\nhost: server.example.com\r\nupgrade: WeBsOcKeT\r\nconnection: UpGrAdE\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\n\r\n")
    status := self readLine: client
    {status, self readHeaders: client}

  /// The handshake offering permessage-deflate.
  class sealed handshakeDeflate: client :: Tuple -> Tuple =>
    self send: client bytes: ("GET / HTTP/1.1\r\nhost: server.example.com\r\nupgrade: WeBsOcKeT\r\nconnection: UpGrAdE\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\nsec-websocket-extensions: permessage-deflate\r\n\r\n")
    status := self readLine: client
    {status, self readHeaders: client}

  class sealed readHeaders: client :: Tuple -> List =>
    line := self readLine: client
    line size =:= 0 ifTrue: [^#()]
    (self readHeaders: client) addFirst: line

  /// One CRLF-terminated line without the terminator.
  class sealed readLine: client :: Tuple -> String =>
    self readLine: client bytes: (Binary fromBytes: #())

  class sealed readLine: client :: Tuple bytes: acc :: Binary -> String =>
    (self recv: client bytes: 1) match: [
      <<13:8>> -> (self recv: client bytes: 1) match: [
        <<10:8>> -> acc asStringUnchecked;
        nl :: Binary -> (acc concat: nl) asStringUnchecked
      ];
      byte :: Binary -> self readLine: client bytes: (acc concat: byte)
    ]

  /// One server frame as {flags, opcode, data}. Server frames are
  /// never masked; a masked one is a protocol error.
  class sealed recvFrame: client :: Tuple -> Tuple =>
    header := self recv: client bytes: 2
    header match: [
      <<first:8, second:8>> -> self frame: client first: first second: second;
      _ -> Error signal: "short frame header"
    ]

  class sealed frame: client :: Tuple first: first :: Integer second: second :: Integer -> Tuple =>
    (second bitAnd: 128) =:= 0 ifFalse: [
      Error signal: "masked server frame"
    ]
    length := second bitAnd: 127
    length =:= 126 ifTrue: [^self sizedFrame: client first: first size: (self uint16: (self recv: client bytes: 2))]
    length =:= 127 ifTrue: [^self sizedFrame: client first: first size: (self uint64: (self recv: client bytes: 8))]
    self sizedFrame: client first: first size: length

  class sealed sizedFrame: client :: Tuple first: first :: Integer size: n :: Integer -> Tuple =>
    {(first bitShift: -4) bitAnd: 15, first bitAnd: 15, (self recv: client bytes: n)}

  class sealed uint16: bytes :: Binary -> Integer =>
    bytes match: [
      <<high:8, low:8>> -> (high bitShift: 8) + low;
      _ -> Error signal: "short length"
    ]

  class sealed uint64: bytes :: Binary -> Integer =>
    bytes match: [
      <<a:8, b:8, c:8, d:8, e:8, f:8, g:8, h:8>> ->
        ((((((((a bitShift: 56) + (b bitShift: 48)) + (c bitShift: 40)) + (d bitShift: 32)) + (e bitShift: 24)) + (f bitShift: 16)) + (g bitShift: 8)) + h;
      _ -> Error signal: "short length"
    ]

  /// Receive helpers asserting the flags nibble and opcode.
  class sealed recvText: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 8 and: [opcode =:= 1]) ifFalse: [
      Error signal: ("expected text frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  /// A text frame with the compressed bit set (0xC in the flags).
  class sealed recvDeflatedText: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 12 and: [opcode =:= 1]) ifFalse: [
      Error signal: ("expected deflated text frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  class sealed recvBinary: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 8 and: [opcode =:= 2]) ifFalse: [
      Error signal: ("expected binary frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  class sealed recvDeflatedBinary: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 12 and: [opcode =:= 2]) ifFalse: [
      Error signal: ("expected deflated binary frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  class sealed recvClose: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 8 and: [opcode =:= 8]) ifFalse: [
      Error signal: ("expected close frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  class sealed recvPing: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 8 and: [opcode =:= 9]) ifFalse: [
      Error signal: ("expected ping frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  class sealed recvPong: client :: Tuple -> Binary =>
    {flags, opcode, data} := self recvFrame: client
    (flags =:= 8 and: [opcode =:= 10]) ifFalse: [
      Error signal: ("expected pong frame, got " ++ flags printString ++ "/" ++ opcode printString)
    ]
    data

  class sealed closedForReading: client :: Tuple -> Boolean =>
    {transport, socket} := client
    outcome := transport =:= #genTcp ifTrue: [
      (Erlang gen_tcp) recv: socket with: 0 with: 500
    ] ifFalse: [
      (Erlang ssl) recv: socket with: 0 with: 500
    ]
    outcome match: [
      _ :: Binary -> false;
      _ -> true
    ]

  class sealed closedForWriting: client :: Tuple -> Boolean =>
    (self send: client bytes: (Binary fromBytes: #())) isError

  /// One masked client frame. Flags is the high nibble (0x8 for a
  /// final frame); data is masked with a fixed mask.
  class sealed sendFrame: client :: Tuple flags: flags :: Integer opcode: opcode :: Integer data: data :: Binary -> Object =>
    mask := Binary fromBytes: #(1, 2, 3, 4)
    head := Binary fromBytes: #((flags bitShift: 4) + opcode)
    self send: client bytes: ((head concat: (self lengths: data size)) concat: (mask concat: (WebSocketOps mask: data with: mask)))

  class sealed lengths: n :: Integer -> Binary =>
    n <= 125 ifTrue: [^Binary fromBytes: #(128 + n)]
    n <= 65535 ifTrue: [^(Binary fromBytes: #(254)) concat: (self bytes16: n)]
    (Binary fromBytes: #(255)) concat: (self bytes64: n)

  class sealed bytes16: n :: Integer -> Binary =>
    Binary fromBytes: #((n bitShift: -8) bitAnd: 255, n bitAnd: 255)

  class sealed bytes64: n :: Integer -> Binary =>
    Binary fromBytes: #(
      (n bitShift: -56) bitAnd: 255,
      (n bitShift: -48) bitAnd: 255,
      (n bitShift: -40) bitAnd: 255,
      (n bitShift: -32) bitAnd: 255,
      (n bitShift: -24) bitAnd: 255,
      (n bitShift: -16) bitAnd: 255,
      (n bitShift: -8) bitAnd: 255,
      n bitAnd: 255)

  class sealed sendText: client :: Tuple data: data :: Binary -> Object =>
    self sendFrame: client flags: 8 opcode: 1 data: data

  class sealed sendBinary: client :: Tuple data: data :: Binary -> Object =>
    self sendFrame: client flags: 8 opcode: 2 data: data

  class sealed sendContinuation: client :: Tuple data: data :: Binary fin: fin :: Boolean -> Object =>
    self sendFrame: client flags: (fin ifTrue: [8] ifFalse: [0]) opcode: 0 data: data

  class sealed sendPing: client :: Tuple data: data :: Binary -> Object =>
    self sendFrame: client flags: 8 opcode: 9 data: data

  class sealed sendPong: client :: Tuple data: data :: Binary -> Object =>
    self sendFrame: client flags: 8 opcode: 10 data: data

  class sealed sendClose: client :: Tuple code: code :: Integer -> Object =>
    self sendFrame: client flags: 8 opcode: 8 data: (Binary fromBytes: #((code bitShift: -8) bitAnd: 255, code bitAnd: 255))
